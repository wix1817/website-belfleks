---
import Layout from '../../layouts/Layout.astro';
import SchemaJsonLd from '../../components/seo/SchemaJsonLd.astro';
import { pb } from '../../lib/pocketbase';

let newsList = [];

try {
  newsList = await pb.collection('news').getFullList({
    filter: 'is_published=true',
    sort: '-published_date',
  });
} catch (e) {
  console.error("Error fetching news:", e);
}

const title = "Новости и статьи | ООО БелФлекс";
const description = "Полезные статьи, обзоры продукции и новости компании БелФлекс. Все о промышленных рукавах и соединениях.";

const schemaData = {
  "@type": "Blog",
  name: title,
  description: description,
  url: Astro.url.href,
  blogPost: newsList.map(n => ({
    "@type": "BlogPosting",
    headline: n.title,
    url: new URL(`/novosti/${n.slug}`, Astro.site || Astro.url.origin).href
  }))
};
---

<Layout title={title} description={description}>
  <SchemaJsonLd type="Blog" data={schemaData} />
  
  <div class="bg-bg-secondary py-12 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex text-sm text-text-muted mb-6" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href="/" class="hover:text-primary transition-colors">Главная</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <span class="ml-1 md:ml-2 text-text-primary">Новости</span>
            </div>
          </li>
        </ol>
      </nav>
      
      <h1 class="text-3xl md:text-4xl lg:text-5xl text-text-primary mb-4 font-accent font-bold italic">
        Новости и <span class="text-primary">статьи</span>
      </h1>
      <p class="text-lg text-text-secondary max-w-3xl">
        Читайте о новинках ассортимента, особенностях применения промышленных рукавов и новостях нашей компании.
      </p>
    </div>
  </div>

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {newsList.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {newsList.map((article) => (
            <article class="bg-white rounded-xl shadow-sm border border-border overflow-hidden flex flex-col hover:shadow-lg transition-shadow group">
              <a href={`/novosti/${article.slug}`} class="block h-48 bg-bg-secondary overflow-hidden relative">
                {article.image ? (
                  <img 
                    src={`${import.meta.env.PUBLIC_PB_URL || 'http://127.0.0.1:8090'}/api/files/news/${article.id}/${article.image}?thumb=600x400`}
                    alt={article.title}
                    class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-text-muted bg-bg-secondary">
                    <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
                  </div>
                )}
                {article.published_date && (
                  <div class="absolute top-4 left-4 bg-white/90 backdrop-blur px-3 py-1 text-xs font-bold rounded shadow-sm text-text-primary">
                    {new Date(article.published_date).toLocaleDateString('ru-RU')}
                  </div>
                )}
              </a>
              <div class="p-6 flex flex-col flex-grow">
                <h2 class="text-xl font-bold text-text-primary mb-3 line-clamp-2">
                  <a href={`/novosti/${article.slug}`} class="hover:text-primary transition-colors">
                    {article.title}
                  </a>
                </h2>
                {article.excerpt && (
                  <p class="text-text-secondary text-sm line-clamp-3 mb-4 flex-grow">
                    {article.excerpt}
                  </p>
                )}
                <div class="mt-auto pt-4 border-t border-border">
                  <a href={`/novosti/${article.slug}`} class="inline-flex items-center text-primary font-medium text-sm group-hover:text-secondary transition-colors">
                    Читать далее
                    <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="text-center py-12 bg-bg-secondary rounded-xl border border-border">
          <svg class="w-16 h-16 mx-auto text-text-muted mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
          <h3 class="text-xl font-medium text-text-primary mb-2">Статей пока нет</h3>
          <p class="text-text-secondary max-w-md mx-auto">
            Скоро мы добавим интересные материалы о промышленных рукавах.
          </p>
        </div>
      )}
    </div>
  </section>
</Layout>
