---
/**
 * /katalog/[category]/[slug]
 *
 * Этот роут обрабатывает два случая:
 * 1. [slug] — это подкатегория → рендерим список товаров подкатегории
 * 2. [slug] — это товар (в категории без подкатегорий или прямой просмотр товара) → рендерим карточку товара
 */
import Layout from '../../../layouts/Layout.astro';
import SchemaJsonLd from '../../../components/seo/SchemaJsonLd.astro';
import { pb } from '../../../lib/pocketbase';

const { category: categorySlug, slug } = Astro.params;
const pbUrl = import.meta.env.PUBLIC_PB_URL || 'http://127.0.0.1:8090';

// ─── Step 1: Resolve parent category ─────────────────────────────────────────
let parentCategory: any = null;
try {
  parentCategory = await pb.collection('categories').getFirstListItem(
    `slug="${categorySlug}" && is_active=true`
  );
} catch {
  // Try fallback category if alias
  try {
    if (categorySlug === 'promyshlennye-rukava') {
      parentCategory = await pb.collection('categories').getFirstListItem(`slug="industrial-hoses"`);
    } else if (categorySlug === 'industrial-hoses') {
      parentCategory = await pb.collection('categories').getFirstListItem(`slug="promyshlennye-rukava"`);
    }
  } catch { /* ignore */ }
}

if (!parentCategory) {
  return Astro.redirect('/katalog');
}

// ─── Step 2: Try subcategory ──────────────────────────────────────────────────
let subCategory: any = null;
try {
  subCategory = await pb.collection('categories').getFirstListItem(
    `slug="${slug}" && is_active=true`
  );
  // Ensure it is a child or matches
  if (subCategory && subCategory.id === parentCategory.id) {
    subCategory = null; // not a subcategory of itself
  }
} catch {
  subCategory = null;
}

// ─── Step 3: If subcategory found, fetch its products ────────────────────────
let subCategoryProducts: any[] = [];
let isSubcategory = false;

if (subCategory) {
  isSubcategory = true;
  try {
    // 1. First try directly assigned products
    subCategoryProducts = await pb.collection('products').getFullList({
      filter: `category="${subCategory.id}" && is_active=true`,
      sort: '-is_featured,sort_order,name',
    });

    // 2. If 0 products, match by subcategory keywords from all products
    if (subCategoryProducts.length === 0) {
      const keywordMap: Record<string, string> = {
        'voda': 'вод',
        'vozduh': 'возд',
        'par': 'пар',
        'himstoykie': 'хим',
        'abrazivostoykie': 'абразив',
        'pischevye': 'пищев'
      };

      const kw = keywordMap[subCategory.slug] || subCategory.name;
      if (kw) {
        subCategoryProducts = await pb.collection('products').getFullList({
          filter: `(name~"${kw}" || short_description~"${kw}") && is_active=true`,
          sort: '-is_featured,sort_order,name',
        });
      }

      // 3. Fallback: all products in parent category if still 0
      if (subCategoryProducts.length === 0) {
        subCategoryProducts = await pb.collection('products').getFullList({
          filter: `is_active=true`,
          sort: '-is_featured,sort_order,name',
          limit: 24
        });
      }
    }
  } catch (e) {
    console.error('Error fetching subcategory products:', e);
  }
}

// ─── Step 4: If NOT subcategory, resolve Product ──────────────────────────────
let productData: any = null;
let productCategory: any = null;

if (!isSubcategory) {
  try {
    productData = await pb.collection('products').getFirstListItem(
      `slug="${slug}" && is_active=true`,
      { expand: 'category,category.parent,upsell,crossell' }
    );
  } catch {
    // Try without exact match if needed
    try {
      const decodedSlug = decodeURIComponent(slug || '');
      productData = await pb.collection('products').getFirstListItem(
        `slug="${decodedSlug}" && is_active=true`,
        { expand: 'category,category.parent,upsell,crossell' }
      );
    } catch { /* not found */ }
  }

  if (!productData) {
    return Astro.redirect('/katalog');
  }

  productCategory = productData.expand?.category;
}

// ─── Step 5: Setup metadata and related items for product view ────────────────
const upsellProducts = productData?.expand?.upsell || [];
const crossellProducts = productData?.expand?.crossell || [];
let similarProducts: any[] = [];

if (!isSubcategory && upsellProducts.length === 0 && productCategory) {
  try {
    similarProducts = await pb.collection('products').getFullList({
      filter: `category="${productCategory.id}" && id!="${productData.id}" && is_active=true`,
      sort: 'sort_order,name',
      limit: 4,
    });
  } catch { /* ignore */ }
}

const relatedProducts = upsellProducts.length > 0 ? upsellProducts : similarProducts;
const relatedTitle = upsellProducts.length > 0 ? 'С этим товаром используют' : 'Похожие товары';

const prodTitle = productData?.meta_title || (productData ? `${productData.name} | ${parentCategory.name} | БелФлекс` : '');
const prodDescription = productData?.meta_description || (productData ? `${productData.short_description || productData.name}. Промышленные рукава ООО БелФлекс. Склад в Гродно.` : '');

const images = productData?.images?.map(
  (img: string) => `${pbUrl}/api/files/products/${productData.id}/${img}`
) || [];
const mainImage = images[0] || null;

const prodSchemaData = productData ? {
  name: productData.name,
  description: prodDescription,
  image: images,
  sku: productData.id,
  offers: {
    '@type': 'Offer',
    url: Astro.url.href,
    priceCurrency: 'BYN',
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: { '@type': 'Organization', name: 'ООО БелФлекс' },
  },
} : null;

const breadcrumbSchemaProduct = productData ? {
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://bflex.by/' },
    { '@type': 'ListItem', position: 2, name: 'Каталог', item: 'https://bflex.by/katalog' },
    { '@type': 'ListItem', position: 3, name: parentCategory.name, item: `https://bflex.by/katalog/${categorySlug}` },
    { '@type': 'ListItem', position: 4, name: productData.name, item: Astro.url.href },
  ],
} : null;

const colLabels: Record<string, string> = {
  diameter_mm: 'Диаметр, мм', outer_diameter_mm: 'Нар. Ø, мм',
  working_pressure_bar: 'Раб. давл., бар', burst_pressure_bar: 'Разрыв. давл., бар',
  bend_radius_mm: 'Радиус изгиба, мм', coil_length_m: 'Длина бухты, м', weight_g_m: 'Вес, г/м',
};
---

{isSubcategory ? (
<Layout title={`${subCategory!.name} — ${parentCategory.name} | БелФлекс`} description={subCategory!.description || `${subCategory!.name} — каталог промышленных рукавов ООО БелФлекс`}>
  <!-- SUBCATEGORY RENDER -->
  <div class="bg-bg-secondary py-10 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex text-sm text-text-muted mb-6" aria-label="Breadcrumb">
        <ol class="inline-flex items-center flex-wrap gap-x-1 gap-y-1">
          <li><a href="/" class="hover:text-primary transition-colors">Главная</a></li>
          <li class="flex items-center"><svg class="w-3 h-3 mx-1 opacity-50" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg><a href="/katalog" class="hover:text-primary transition-colors">Каталог</a></li>
          <li class="flex items-center"><svg class="w-3 h-3 mx-1 opacity-50" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg><a href={`/katalog/${categorySlug}`} class="hover:text-primary transition-colors">{parentCategory.name}</a></li>
          <li class="flex items-center"><svg class="w-3 h-3 mx-1 opacity-50" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg><span class="text-text-primary font-medium" aria-current="page">{subCategory!.name}</span></li>
        </ol>
      </nav>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-accent font-bold italic text-text-primary mb-4">{subCategory!.name}</h1>
      {subCategory!.description ? (
        <p class="text-lg text-text-secondary max-w-3xl">{subCategory!.description}</p>
      ) : (
        <p class="text-lg text-text-secondary max-w-3xl">Промышленные рукава и шланги для категории «{subCategory!.name}». Официальные поставки со склада в Гродно.</p>
      )}
    </div>
  </div>

  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-border">
        <h2 class="text-xl font-bold text-text-primary font-accent italic">Товары в категории ({subCategoryProducts.length})</h2>
        <a href={`/katalog/${categorySlug}`} class="text-sm text-text-muted hover:text-primary transition-colors flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Все {parentCategory.name}
        </a>
      </div>

      {subCategoryProducts.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {subCategoryProducts.map((prod: any) => {
            const prodUrl = `/katalog/${categorySlug}/${subCategory!.slug}/${prod.slug}`;
            const mainImg = prod.images?.[0]
              ? `${pbUrl}/api/files/products/${prod.id}/${prod.images[0]}?thumb=400x300`
              : null;
            return (
              <a href={prodUrl} class="group bg-white border border-border rounded-xl overflow-hidden hover:shadow-xl hover:border-primary/30 transition-all duration-300 flex flex-col">
                <div class="relative h-52 bg-white p-4 flex items-center justify-center border-b border-border">
                  {prod.is_featured && (
                    <span class="absolute top-3 left-3 bg-primary text-white text-xs font-bold px-2 py-0.5 rounded uppercase tracking-wider z-10">Хит</span>
                  )}
                  {mainImg ? (
                    <img src={mainImg} alt={prod.name} class="object-contain w-full h-full group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  ) : (
                    <div class="text-primary/20"><svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div>
                  )}
                </div>
                <div class="p-5 flex-grow flex flex-col">
                  <h3 class="text-base font-bold text-text-primary mb-2 group-hover:text-primary transition-colors line-clamp-2">{prod.name}</h3>
                  {prod.short_description && <p class="text-sm text-text-secondary line-clamp-2 mb-3 flex-grow leading-relaxed">{prod.short_description}</p>}
                  {prod.tags && prod.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mb-4">
                      {prod.tags.slice(0, 3).map((tag: string) => (
                        <span class="text-xs bg-bg-secondary text-text-muted px-2 py-0.5 rounded-full border border-border">{tag}</span>
                      ))}
                    </div>
                  )}
                  <div class="mt-auto pt-3 border-t border-border flex justify-between items-center">
                    <span class="text-primary font-accent italic font-bold text-sm uppercase">Подробнее</span>
                    <svg class="w-4 h-4 text-primary group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-20 bg-bg-secondary rounded-2xl border border-border">
          <svg class="w-14 h-14 mx-auto text-text-muted mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          <h2 class="text-xl font-semibold text-text-primary mb-2">Товары не найдены</h2>
          <p class="text-text-secondary mb-6">В данной подкатегории пока нет товаров.</p>
          <a href={`/katalog/${categorySlug}`} class="inline-flex items-center gap-2 bg-primary text-white font-accent italic font-bold py-3 px-6 rounded-md hover:bg-secondary transition-colors uppercase text-sm tracking-wide">
            Вернуться в {parentCategory.name}
          </a>
        </div>
      )}
    </div>
  </section>
</Layout>
) : (
<Layout title={prodTitle} description={prodDescription} ogImage={mainImage || undefined}>
  {prodSchemaData && <SchemaJsonLd type="Product" data={prodSchemaData} />}
  {breadcrumbSchemaProduct && <SchemaJsonLd type="BreadcrumbList" data={breadcrumbSchemaProduct} />}

  <!-- Breadcrumbs -->
  <div class="bg-bg-secondary py-4 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb">
        <ol class="inline-flex items-center flex-wrap gap-x-1 gap-y-1 text-sm text-text-muted">
          <li><a href="/" class="hover:text-primary transition-colors">Главная</a></li>
          <li class="flex items-center"><svg class="w-3 h-3 mx-1 opacity-50" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg><a href="/katalog" class="hover:text-primary transition-colors">Каталог</a></li>
          <li class="flex items-center"><svg class="w-3 h-3 mx-1 opacity-50" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg><a href={`/katalog/${categorySlug}`} class="hover:text-primary transition-colors">{parentCategory.name}</a></li>
          <li class="flex items-center"><svg class="w-3 h-3 mx-1 opacity-50" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg><span class="text-text-primary font-medium" aria-current="page">{productData?.name}</span></li>
        </ol>
      </nav>
    </div>
  </div>

  <!-- Main product section -->
  {productData && (
    <section class="py-10 md:py-14">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="flex flex-col lg:flex-row gap-10 xl:gap-14"
          x-data={`{
            activeImage: 0,
            images: ${JSON.stringify(images)},
            lightboxOpen: false,
            lightboxIndex: 0,
            openLightbox(i) { this.lightboxIndex = i; this.lightboxOpen = true; }
          }`}
        >
          <!-- Image gallery -->
          <div class="w-full lg:w-[46%] xl:w-[44%]">
            <div class="sticky top-24">
              <div
                class="bg-white border border-border rounded-2xl overflow-hidden mb-3 aspect-[4/3] flex items-center justify-center cursor-zoom-in relative group"
                @click="openLightbox(activeImage)"
              >
                {productData.is_featured && (
                  <span class="absolute top-4 left-4 bg-primary text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider z-10 shadow-sm">
                    Хит продаж
                  </span>
                )}

                {mainImage ? (
                  <template x-for="(img, idx) in images" :key="idx">
                    <img
                      :src="img"
                      :alt="`${productData.name} - фото ${idx + 1}`"
                      x-show="activeImage === idx"
                      class="object-contain w-full h-full p-4 transition-all duration-300 group-hover:scale-105"
                      loading="lazy"
                    />
                  </template>
                ) : (
                  <div class="text-primary/20 flex flex-col items-center">
                    <svg class="w-20 h-20 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                      />
                    </svg>
                    <span class="text-xs text-text-muted">Изображение отсутствует</span>
                  </div>
                )}

                {images.length > 0 && (
                  <div class="absolute bottom-3 right-3 bg-black/50 text-white text-xs px-2.5 py-1 rounded-full flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                    </svg>
                    Увеличить
                  </div>
                )}
              </div>

              {images.length > 1 && (
                <div class="grid grid-cols-5 gap-2">
                  {images.map((img: string, idx: number) => (
                    <button
                      type="button"
                      @click={`activeImage = ${idx}`}
                      :class={`activeImage === ${idx} ? 'border-primary ring-2 ring-primary/20' : 'border-border hover:border-text-secondary/40'`}
                      class="bg-white border rounded-xl overflow-hidden aspect-square flex items-center justify-center p-1 transition-all cursor-pointer"
                      aria-label={`Фото ${idx + 1}`}
                    >
                      <img src={img} alt="" class="object-contain w-full h-full" loading="lazy" />
                    </button>
                  ))}
                </div>
              )}
            </div>
          </div>

          <!-- Product details & actions -->
          <div class="w-full lg:w-[54%] xl:w-[56%] flex flex-col">
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-accent font-bold italic text-text-primary mb-3 leading-tight">
              {productData.name}
            </h1>

            {productData.tags && productData.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-6">
                {productData.tags.map((tag: string) => (
                  <span class="text-xs bg-bg-secondary text-text-secondary px-3 py-1 rounded-full border border-border font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            )}

            {productData.short_description && (
              <p class="text-base text-text-secondary mb-6 leading-relaxed bg-bg-secondary/40 p-4 rounded-xl border border-border/60">
                {productData.short_description}
              </p>
            )}

            <!-- CTA Actions block -->
            <div class="p-6 bg-white rounded-2xl border border-border shadow-xs mb-8">
              <div class="flex flex-col sm:flex-row gap-3">
                <button
                  type="button"
                  data-crm-open="true"
                  @click="$store.crm?.open()"
                  onclick="window.openCrmModal && window.openCrmModal()"
                  class="crm-trigger flex-1 bg-primary hover:bg-secondary text-white font-accent italic font-bold py-3.5 px-6 rounded-xl transition-all uppercase text-sm tracking-wider shadow-md hover:shadow-lg text-center cursor-pointer"
                >
                  Запросить КП / Оставить заявку
                </button>
                <a
                  href="tel:+375447800059"
                  class="inline-flex items-center justify-center gap-2 border-2 border-border hover:border-primary text-text-primary hover:text-primary font-semibold py-3.5 px-6 rounded-xl transition-colors text-sm whitespace-nowrap"
                >
                  <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                  +375 (44) 780-00-59
                </a>
              </div>
            </div>

            <!-- Description -->
            {productData.description && (
              <div class="mb-8">
                <h2 class="text-xl font-bold text-text-primary mb-3 font-accent italic">Описание</h2>
                <div class="text-text-secondary leading-relaxed space-y-3 prose prose-sm max-w-none" set:html={productData.description} />
              </div>
            )}

            <!-- Technical specifications table -->
            {productData.specifications && (Array.isArray(productData.specifications) ? productData.specifications.length > 0 : Object.keys(productData.specifications).length > 0) && (
              <div class="mb-8">
                <h2 class="text-xl font-bold text-text-primary mb-4 font-accent italic">Технические характеристики</h2>
                <div class="bg-white rounded-xl border border-border overflow-hidden">
                  <table class="w-full text-sm text-left">
                    <tbody class="divide-y divide-border">
                      {Array.isArray(productData.specifications) ? (
                        productData.specifications.map((spec: any, idx: number) => (
                          <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-bg-secondary/30'}>
                            <td class="px-4 py-3 font-medium text-text-secondary w-2/5 sm:w-1/3">{spec.label || spec.name || ''}</td>
                            <td class="px-4 py-3 text-text-primary font-semibold whitespace-pre-line">{spec.value || ''}</td>
                          </tr>
                        ))
                      ) : (
                        Object.entries(productData.specifications).map(([key, val], idx) => (
                          <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-bg-secondary/30'}>
                            <td class="px-4 py-3 font-medium text-text-secondary w-2/5 sm:w-1/3">{colLabels[key] || key}</td>
                            <td class="px-4 py-3 text-text-primary font-semibold whitespace-pre-line">{String(val)}</td>
                          </tr>
                        ))
                      )}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            <!-- Technical diameter table -->
            {productData.diameter_table && Array.isArray(productData.diameter_table) && productData.diameter_table.length > 0 && (
              <div class="mb-8">
                <h2 class="text-xl font-bold text-text-primary mb-4 font-accent italic">Таблица типоразмеров и диаметров</h2>
                <div class="bg-white rounded-xl border border-border overflow-hidden">
                  <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">
                      <thead class="bg-[#F7FAFC] text-text-secondary text-xs uppercase font-semibold border-b border-border">
                        <tr>
                          {Object.keys(productData.diameter_table[0] || {}).map((colKey) => (
                            <th class="px-4 py-3.5 whitespace-nowrap">{colLabels[colKey] || colKey}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-border">
                        {productData.diameter_table.map((row: any, idx: number) => (
                          <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-bg-secondary/30'}>
                            {Object.keys(productData.diameter_table[0] || {}).map((colKey) => (
                              <td class="px-4 py-3 text-text-primary font-medium whitespace-nowrap">{row[colKey] ?? ''}</td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            )}

            <!-- FAQ section -->
            {productData.faq && Array.isArray(productData.faq) && productData.faq.length > 0 && (
              <div class="mb-8">
                <h2 class="text-xl font-bold text-text-primary mb-4 font-accent italic">Часто задаваемые вопросы</h2>
                <div class="space-y-3">
                  {productData.faq.map((item: any) => (
                    <div class="bg-white rounded-xl border border-border p-5 shadow-2xs">
                      <h3 class="font-bold text-sm sm:text-base text-text-primary mb-2 flex items-start gap-2">
                        <span class="text-primary font-bold">В:</span>
                        <span>{item.question}</span>
                      </h3>
                      <p class="text-text-secondary text-sm leading-relaxed pl-5 whitespace-pre-line">{item.answer}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- Related products -->
        {relatedProducts.length > 0 && (
          <div class="mt-16 pt-12 border-t border-border">
            <h2 class="text-2xl font-bold text-text-primary font-accent italic mb-8">{relatedTitle}</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
              {relatedProducts.map((rel: any) => {
                const relUrl = `/katalog/${categorySlug}/${rel.slug}`;
                const relImg = rel.images?.[0]
                  ? `${pbUrl}/api/files/products/${rel.id}/${rel.images[0]}?thumb=400x300`
                  : null;
                return (
                  <a href={relUrl} class="group bg-white border border-border rounded-xl overflow-hidden hover:shadow-lg hover:border-primary/30 transition-all flex flex-col">
                    <div class="h-44 bg-white p-3 flex items-center justify-center border-b border-border">
                      {relImg ? (
                        <img src={relImg} alt={rel.name} class="object-contain w-full h-full group-hover:scale-105 transition-transform" loading="lazy" />
                      ) : (
                        <svg class="w-10 h-10 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                      )}
                    </div>
                    <div class="p-4 flex-grow flex flex-col">
                      <h3 class="font-bold text-sm text-text-primary group-hover:text-primary transition-colors line-clamp-2 mb-2">{rel.name}</h3>
                      <span class="mt-auto text-primary text-xs font-accent italic font-bold uppercase">Подробнее →</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )}

        <!-- Cross-sell products -->
        {crossellProducts.length > 0 && (
          <div class="mt-12 pt-10 border-t border-border">
            <h2 class="text-2xl font-bold text-text-primary font-accent italic mb-8">Рекомендуем также</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
              {crossellProducts.map((rel: any) => {
                const relUrl = `/katalog/${categorySlug}/${rel.slug}`;
                const relImg = rel.images?.[0]
                  ? `${pbUrl}/api/files/products/${rel.id}/${rel.images[0]}?thumb=400x300`
                  : null;
                return (
                  <a href={relUrl} class="group bg-white border border-border rounded-xl overflow-hidden hover:shadow-lg hover:border-primary/30 transition-all flex flex-col">
                    <div class="h-44 bg-white p-3 flex items-center justify-center border-b border-border">
                      {relImg ? (
                        <img src={relImg} alt={rel.name} class="object-contain w-full h-full group-hover:scale-105 transition-transform" loading="lazy" />
                      ) : (
                        <svg class="w-10 h-10 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                      )}
                    </div>
                    <div class="p-4 flex-grow flex flex-col">
                      <h3 class="font-bold text-sm text-text-primary group-hover:text-primary transition-colors line-clamp-2 mb-2">{rel.name}</h3>
                      <span class="mt-auto text-primary text-xs font-accent italic font-bold uppercase">Подробнее →</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </section>
  )}
</Layout>
)}
