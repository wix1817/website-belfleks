---
import Layout from '../../layouts/Layout.astro';
import SchemaJsonLd from '../../components/seo/SchemaJsonLd.astro';
import { pb } from '../../lib/pocketbase';

// Fetch first 100 items server-side for instant above-the-fold render and SEO
let initialData: any[] = [];
let materials: string[] = [];
let totalItems = 0;

try {
  const result = await pb.collection('chemical_resistance').getList(1, 100, {
    sort: 'chemical',
    filter: 'chemical!=""',
  });
  // Filter empty rows
  initialData = result.items.filter(r => r.chemical?.trim());
  totalItems = result.totalItems;

  // Extract material column headers from sample record
  if (initialData.length > 0 && initialData[0].resistance_data) {
    materials = Object.keys(initialData[0].resistance_data).sort();
  }
} catch (e) {
  console.error('Error fetching chemical resistance data:', e);
}

const title = 'Таблица химической стойкости материалов рукавов | ООО БелФлекс';
const description = 'Интерактивная таблица химической стойкости материалов промышленных рукавов. Проверьте совместимость шлангов с различными химическими веществами.';

const schemaData = {
  name: 'Таблица химической стойкости',
  description: description,
  url: Astro.url.href,
};
---

<Layout title={title} description={description}>
  <SchemaJsonLd type="Dataset" data={schemaData} />
  
  <div class="bg-bg-secondary py-12 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex text-sm text-text-muted mb-6" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href="/" class="hover:text-primary transition-colors">Главная</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <a href="/dokumenty" class="hover:text-primary transition-colors ml-1 md:ml-2">Документы</a>
            </div>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <span class="ml-1 md:ml-2 text-text-primary">Химстойкость</span>
            </div>
          </li>
        </ol>
      </nav>
      
      <h1 class="text-3xl md:text-4xl text-text-primary mb-4 font-accent font-bold italic">
        Таблица химической стойкости
      </h1>
      <p class="text-lg text-text-secondary max-w-3xl">
        Интерактивный справочник для подбора оптимального материала рукава под конкретную химическую среду.
      </p>
    </div>
  </div>

  <section
    class="py-12"
    x-data={`chemTableApi(${JSON.stringify(materials)}, ${JSON.stringify(initialData)}, ${totalItems})`}
    x-init="init()"
  >
    <div class="max-w-[100vw] sm:max-w-7xl mx-auto px-0 sm:px-6 lg:px-8">
      
      {/* Controls */}
      <div class="px-4 sm:px-0 mb-6 flex flex-col sm:flex-row gap-4 justify-between items-start sm:items-center">
        <div class="relative w-full sm:max-w-md">
          <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-text-muted">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
          <input 
            type="text" 
            x-model="searchQuery"
            @input="search()"
            class="bg-white border border-border text-text-primary text-sm rounded-lg focus:ring-primary focus:border-primary block w-full pl-10 p-2.5 shadow-xs" 
            placeholder="Поиск по химическому веществу..."
          >
          <button 
            x-show="searchQuery.length > 0"
            @click="clearSearch()"
            type="button"
            class="absolute inset-y-0 right-0 flex items-center pr-3 text-text-muted hover:text-text-primary cursor-pointer"
            title="Очистить поиск"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
        
        <div class="flex items-center gap-4 flex-wrap text-xs sm:text-sm font-medium">
          <div class="flex items-center"><span class="w-4 h-4 rounded bg-green-100 text-green-800 flex items-center justify-center mr-1.5 font-bold text-xs">+</span> Совместимо</div>
          <div class="flex items-center"><span class="w-4 h-4 rounded bg-yellow-100 text-yellow-800 flex items-center justify-center mr-1.5 font-bold text-xs">+/-</span> Ограниченно</div>
          <div class="flex items-center"><span class="w-4 h-4 rounded bg-red-100 text-red-800 flex items-center justify-center mr-1.5 font-bold text-xs">-</span> Не совместимо</div>
        </div>
      </div>

      {/* Table Container */}
      <div class="bg-white shadow-sm border-y sm:border sm:border-border sm:rounded-2xl overflow-hidden relative">
        <div 
          id="table-scroll-container" 
          class="overflow-auto max-h-[72vh] relative"
          @scroll.passive="onContainerScroll($event)"
        >
          <table class="w-full text-sm text-left text-text-secondary">
            <thead class="text-xs text-text-primary uppercase bg-bg-secondary sticky top-0 z-20 shadow-sm">
              <tr>
                <th scope="col" class="px-4 py-3.5 border-b border-r border-border bg-bg-secondary sticky left-0 z-30 min-w-[220px]">
                  <div class="flex items-center cursor-pointer hover:text-primary transition-colors" @click="sortBy('chemical')">
                    <span>Химическое вещество</span>
                    <span x-show="sortCol === 'chemical'" class="ml-1 text-primary">
                      <svg x-show="sortAsc" class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
                      <svg x-show="!sortAsc" class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </span>
                  </div>
                </th>
                <template x-for="mat in materials" :key="mat">
                  <th scope="col" class="px-3 py-3.5 border-b border-border bg-bg-secondary whitespace-nowrap cursor-pointer hover:bg-gray-100 transition-colors" @click="sortBy(mat)">
                    <div class="flex items-center justify-center">
                      <span x-text="mat"></span>
                      <span x-show="sortCol === mat" class="ml-1 text-primary">
                        <svg x-show="sortAsc" class="w-3.5 h-3.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
                        <svg x-show="!sortAsc" class="w-3.5 h-3.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                      </span>
                    </div>
                  </th>
                </template>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <template x-for="(row, index) in filteredRows" :key="row.id || index">
                <tr class="hover:bg-gray-50 transition-colors" :class="index % 2 === 0 ? 'bg-white' : 'bg-bg-secondary/30'">
                  <td class="px-4 py-3 font-semibold text-text-primary border-r border-border bg-white sticky left-0 z-10 shadow-[1px_0_0_0_#edf2f7]" :class="index % 2 === 0 ? 'bg-white' : 'bg-gray-50'">
                    <span x-text="row.chemical"></span>
                    <template x-if="row.notes">
                      <div class="text-xs text-text-muted mt-0.5 font-normal" x-text="row.notes"></div>
                    </template>
                  </td>
                  <template x-for="mat in materials" :key="mat">
                    <td class="px-3 py-2 text-center text-xs font-bold border-r border-border/30 last:border-r-0"
                        :class="{
                          'bg-green-100 text-green-800': getRes(row, mat) === '+',
                          'bg-yellow-100 text-yellow-800': getRes(row, mat) === '+/-',
                          'bg-red-100 text-red-800': getRes(row, mat) === '-',
                          'text-gray-300': !getRes(row, mat) || getRes(row, mat) === ' '
                        }">
                      <span x-text="getRes(row, mat)"></span>
                    </td>
                  </template>
                </tr>
              </template>
              <tr x-show="filteredRows.length === 0 && !isLoading">
                <td :colspan="materials.length + 1" class="px-6 py-12 text-center">
                  <div class="text-text-muted mb-2">
                    <svg class="w-12 h-12 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                  </div>
                  <p class="text-lg font-medium text-text-primary">Ничего не найдено</p>
                  <p class="text-sm text-text-secondary mt-1">По вашему запросу нет совпадений. Попробуйте другой термин.</p>
                </td>
              </tr>
              <!-- Inside table sentinel row -->
              <tr id="scroll-sentinel-row" x-show="hasMore">
                <td :colspan="materials.length + 1" class="p-0 border-0 h-4"></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      {/* Infinite scroll status / action bar */}
      <div class="px-4 sm:px-0 mt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm text-text-muted">
          Показано: <span class="font-semibold text-text-primary" x-text="rows.length"></span> из <span class="font-semibold text-text-primary" x-text="totalItems || rows.length"></span> записей
        </p>

        <div class="flex items-center gap-3">
          <div x-show="isLoading" class="flex items-center gap-2 text-sm text-primary font-medium">
            <svg class="animate-spin h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span>Загрузка следующих 100 записей...</span>
          </div>

          <!-- Manual Load More button as fallback/option -->
          <button
            type="button"
            x-show="hasMore && !isLoading"
            @click="loadMore()"
            class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-primary bg-primary/10 hover:bg-primary hover:text-white rounded-lg transition-colors cursor-pointer"
          >
            <span>Загрузить ещё 100</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>

          <p x-show="!hasMore && rows.length > 0 && !isLoading" class="text-xs text-text-muted flex items-center gap-1.5">
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Все {totalItems || rows.length} записей загружены
          </p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('alpine:init', () => {
      Alpine.data('chemTableApi', (serverMaterials, serverInitialData, serverTotal) => ({
        searchQuery: '',
        rows: serverInitialData || [],
        materials: serverMaterials || [],
        sortCol: 'chemical',
        sortAsc: true,
        isLoading: false,
        hasMore: true,
        currentPage: 1,
        totalItems: serverTotal || 0,
        debounceTimer: null,
        observer: null,

        init() {
          this.hasMore = this.rows.length < this.totalItems;
          if (this.materials.length === 0 && this.rows.length > 0 && this.rows[0].resistance_data) {
            this.materials = Object.keys(this.rows[0].resistance_data).sort();
          }

          // IntersectionObserver bound strictly to the table container
          this.$nextTick(() => {
            const container = document.getElementById('table-scroll-container');
            const sentinel = document.getElementById('scroll-sentinel-row');

            if (container && sentinel && 'IntersectionObserver' in window) {
              this.observer = new IntersectionObserver((entries) => {
                if (entries[0].isIntersecting && !this.isLoading && this.hasMore) {
                  this.loadMore();
                }
              }, {
                root: container,
                rootMargin: '0px 0px 50px 0px'
              });
              this.observer.observe(sentinel);
            }
          });
        },

        onContainerScroll(e) {
          const target = e.target;
          if (!target || this.isLoading || !this.hasMore) return;
          // Trigger only when user has scrolled almost to the very bottom of the table container (within 80px)
          const remaining = target.scrollHeight - target.scrollTop - target.clientHeight;
          if (remaining <= 80) {
            this.loadMore();
          }
        },

        clearSearch() {
          this.searchQuery = '';
          this.currentPage = 1;
          this.hasMore = true;
          this.fetchData(true);
        },

        search() {
          clearTimeout(this.debounceTimer);
          this.debounceTimer = setTimeout(async () => {
            this.currentPage = 1;
            this.hasMore = true;
            await this.fetchData(true);
          }, 300);
        },

        async fetchData(reset = false) {
          if (this.isLoading) return;
          this.isLoading = true;
          try {
            const q = encodeURIComponent(this.searchQuery.trim());
            const url = `/api/chem.json?page=${this.currentPage}&perPage=100&search=${q}`;
            const res = await fetch(url);
            const data = await res.json();

            if (data.materials && data.materials.length > 0) {
              this.materials = data.materials;
            }

            const newItems = (data.items || []).filter(r => r.chemical?.trim());

            if (reset) {
              this.rows = newItems;
            } else {
              // Deduplicate items by ID
              const existingIds = new Set(this.rows.map(r => r.id));
              const uniqueNew = newItems.filter(r => !existingIds.has(r.id));
              this.rows = [...this.rows, ...uniqueNew];
            }

            this.totalItems = data.totalItems || 0;
            this.hasMore = this.rows.length < this.totalItems && this.currentPage < (data.totalPages || 1);
          } catch (e) {
            console.error('Chem data fetch error:', e);
          } finally {
            this.isLoading = false;
          }
        },

        async loadMore() {
          if (this.isLoading || !this.hasMore) return;
          this.currentPage++;
          await this.fetchData(false);
        },

        getRes(row, mat) {
          if (!row.resistance_data) return ' ';
          return row.resistance_data[mat] || ' ';
        },

        sortBy(col) {
          if (this.sortCol === col) {
            this.sortAsc = !this.sortAsc;
          } else {
            this.sortCol = col;
            this.sortAsc = true;
          }
        },

        get filteredRows() {
          let result = [...this.rows];
          result = result.sort((a, b) => {
            let valA, valB;
            if (this.sortCol === 'chemical') {
              valA = (a.chemical || '').toLowerCase();
              valB = (b.chemical || '').toLowerCase();
            } else {
              const score = { '+': 3, '+/-': 2, '-': 1, ' ': 0 };
              valA = score[this.getRes(a, this.sortCol)] ?? 0;
              valB = score[this.getRes(b, this.sortCol)] ?? 0;
            }
            if (valA < valB) return this.sortAsc ? -1 : 1;
            if (valA > valB) return this.sortAsc ? 1 : -1;
            return 0;
          });
          return result;
        }
      }))
    })
  </script>
</Layout>
