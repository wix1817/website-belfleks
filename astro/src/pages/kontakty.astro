---
import Layout from '../layouts/Layout.astro';
import SchemaJsonLd from '../components/seo/SchemaJsonLd.astro';
import { pb } from '../lib/pocketbase';

let pageData: any = null;
let siteSettings: any = null;

try {
  pageData = await pb.collection('pages').getFirstListItem('slug="kontakty" && is_active=true').catch(() => null);
  const settingsList = await pb.collection('site_settings').getFullList().catch(() => []);
  siteSettings = settingsList.length > 0 ? settingsList[0] : null;
} catch (e) {
  console.error(e);
}

const title = pageData?.meta_title || "Контакты | ООО БелФлекс";
const description = pageData?.meta_description || "Свяжитесь с нами. Телефоны, адрес, email, форма заявки и схема проезда к складу ООО БелФлекс в Гродно.";

const schemaData = {
  name: pageData?.title || "Контакты",
  description: description,
  url: Astro.url.href
};

const wireCrmFormUrl = "https://forms.wirecrm.com/form-designer/964ec1e8b4373f024adc6e08db1c41e9?embed=1";
---

<Layout title={title} description={description}>
  <SchemaJsonLd type="ContactPage" data={schemaData} />
  
  <div class="bg-bg-secondary py-12 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex text-sm text-text-muted mb-6" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href="/" class="hover:text-primary transition-colors">Главная</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <span class="ml-1 md:ml-2 text-text-primary">Контакты</span>
            </div>
          </li>
        </ol>
      </nav>
      
      <h1 class="text-3xl md:text-4xl lg:text-5xl text-text-primary mb-4 font-accent font-bold italic">
        {pageData?.title || "Контакты"}
      </h1>
      
      {pageData?.content ? (
        <div class="text-lg text-text-secondary max-w-3xl" set:html={pageData.content} />
      ) : (
        <p class="text-lg text-text-secondary max-w-3xl">
          Свяжитесь с нами любым удобным способом или отправьте онлайн-заявку через форму ниже.
        </p>
      )}
    </div>
  </div>

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-stretch">
        
        {/* Contact Info */}
        <div class="space-y-8">
          <div class="bg-white rounded-2xl shadow-sm border border-border p-8 h-full">
            <h2 class="text-2xl font-bold mb-6 text-text-primary font-accent italic">
              Связаться с нами
            </h2>
            
            <ul class="space-y-6">
              <li class="flex items-start">
                <div class="flex-shrink-0 bg-primary/10 p-3 rounded-xl text-primary mr-4">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                </div>
                <div>
                  <h3 class="font-semibold text-text-primary mb-1">Адрес офиса и склада</h3>
                  <p class="text-text-secondary">{siteSettings?.address || '230000, г. Гродно, ул. Лидская 15'}</p>
                </div>
              </li>
              
              <li class="flex items-start">
                <div class="flex-shrink-0 bg-primary/10 p-3 rounded-xl text-primary mr-4">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                </div>
                <div>
                  <h3 class="font-semibold text-text-primary mb-1">Телефоны</h3>
                  <p><a href="tel:+375447800059" class="text-text-secondary hover:text-primary transition-colors font-medium">+375 (44) 780-00-59</a></p>
                  {siteSettings?.phone_secondary && <p><a href={`tel:${siteSettings.phone_secondary.replace(/[^+\d]/g, '')}`} class="text-text-secondary hover:text-primary transition-colors font-medium">{siteSettings.phone_secondary}</a></p>}
                </div>
              </li>
              
              <li class="flex items-start">
                <div class="flex-shrink-0 bg-primary/10 p-3 rounded-xl text-primary mr-4">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                </div>
                <div>
                  <h3 class="font-semibold text-text-primary mb-1">E-mail</h3>
                  <p><a href={`mailto:${siteSettings?.email || 'zakaz@belfleks.by'}`} class="text-text-secondary hover:text-primary transition-colors font-medium">{siteSettings?.email || 'zakaz@belfleks.by'}</a></p>
                </div>
              </li>
              
              <li class="flex items-start">
                <div class="flex-shrink-0 bg-primary/10 p-3 rounded-xl text-primary mr-4">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <div>
                  <h3 class="font-semibold text-text-primary mb-1">Режим работы</h3>
                  <p class="text-text-secondary whitespace-pre-line">{siteSettings?.working_hours || 'Пн–Пт: 8:30 – 17:00'}</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
        
        {/* Map */}
        <div class="bg-white rounded-2xl shadow-sm border border-border p-8 h-full min-h-[420px] flex flex-col">
          <h2 class="text-2xl font-bold mb-6 text-text-primary font-accent italic">Схема проезда</h2>
          <div class="w-full flex-grow rounded-xl overflow-hidden relative min-h-[320px] border border-border">
            <iframe 
              src="https://yandex.ru/map-widget/v1/?um=constructor%3A7a195be7be2ec29a738a9cc2a912bb673ea94e77dd62bc34ab7904e6c0c2918f&source=constructor" 
              width="100%" 
              height="100%" 
              frameborder="0"
              class="absolute inset-0 w-full h-full"
              title="Схема проезда">
            </iframe>
          </div>
        </div>
      </div>

      {/* Embedded WireCRM Form Section */}
      <div class="bg-white rounded-2xl shadow-sm border border-border p-8 md:p-12">
        <div class="max-w-2xl mx-auto text-center mb-8">
          <span class="inline-block py-1 px-3 rounded-full bg-primary/10 text-primary font-semibold text-xs uppercase tracking-wider mb-3">
            Онлайн-заявка
          </span>
          <h2 class="text-3xl font-bold text-text-primary font-accent italic">
            Отправить запрос на подбор продукции
          </h2>
          <p class="text-text-secondary text-sm mt-2">
            Заполните форму, и специалисты ООО «БелФлекс» оперативно подготовят коммерческое предложение
          </p>
        </div>

        <div class="max-w-2xl mx-auto rounded-xl overflow-hidden border border-border/80 p-2 sm:p-4 bg-bg-secondary/30">
          <iframe
            src={wireCrmFormUrl}
            width="100%"
            height="560"
            frameborder="0"
            class="w-full h-[560px] rounded-lg border-0 bg-white shadow-xs"
            loading="lazy"
            title="Форма WireCRM для связи"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</Layout>
