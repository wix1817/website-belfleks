---
import Layout from '../layouts/Layout.astro';
import SchemaJsonLd from '../components/seo/SchemaJsonLd.astro';
import { pb } from '../lib/pocketbase';

const pbUrl = import.meta.env.PUBLIC_PB_URL || 'http://127.0.0.1:8090';

// Fetch data for homepage sections
let categories: any[] = [];
let featuredProducts: any[] = [];
let homePageData: any = null;
let manufacturers: any[] = [];
let news: any[] = [];

try {
  const [cats, prods, pages, mfrs, latestNews] = await Promise.all([
    pb.collection('categories').getFullList({
      filter: 'is_active=true && parent=null',
      sort: 'sort_order,name',
    }).catch(() => []),
    pb.collection('products').getFullList({
      filter: 'is_active=true && is_featured=true',
      sort: 'sort_order,name',
      expand: 'category',
    }).catch(() => []),
    pb.collection('pages').getFirstListItem('slug="home" && is_active=true').catch(() => null),
    pb.collection('manufacturers').getFullList({
      filter: 'is_active=true',
      sort: 'sort_order,name',
    }).catch(() => []),
    pb.collection('news').getFullList({
      filter: 'is_published=true',
      sort: '-published_date',
      limit: 3,
    }).catch(() => []),
  ]);
  categories = cats.slice(0, 6);
  featuredProducts = prods.slice(0, 4);
  homePageData = pages;
  manufacturers = mfrs;
  news = latestNews.slice(0, 3);
} catch (e) {
  console.error('Homepage data fetch error:', e);
}

const fallbackPartners = [
  'Газпром Трансгаз Беларусь',
  'ОАО «Беларуськалий»',
  'ОАО «МТЗ»',
  'ОАО «Гродно Азот»',
  'ОАО «БМЗ»',
  'ОАО «Нафтан»',
  'ОАО «Мозырский НПЗ»',
  'ОАО «Пеленг»',
];

const schemaData = {
  name: 'ООО БелФлекс',
  description: 'Промышленные рукава и соединения в Беларуси. Официальный дилер. Склад в Гродно.',
  url: 'https://bflex.by',
  telephone: '+375447800059',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ул. Лидская 15',
    addressLocality: 'Гродно',
    addressCountry: 'BY',
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: 'https://bflex.by/katalog/?q={search_term_string}' },
    'query-input': 'required name=search_term_string',
  },
};
---

<Layout
  title="Промышленные рукава и соединения в Беларуси | ООО БелФлекс"
  description="Поставляем промышленные рукава, шланги, соединения Kamlock, хомуты и фитинги. Официальный дилер. Склад в Гродно. Доставка по РБ и СНГ."
>
  <SchemaJsonLd type="Organization" data={schemaData} />

  <!-- Hero Section -->
  <section class="relative bg-bg-primary overflow-hidden">
    <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-primary/5 blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/2 -left-24 w-72 h-72 rounded-full bg-secondary/5 blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-16 md:py-24 lg:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="max-w-2xl">
          <span class="inline-block py-1 px-3 rounded-full bg-primary/10 text-primary font-semibold text-sm mb-6 border border-primary/20">
            Надёжный партнёр для вашего производства
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl text-text-primary leading-tight mb-6">
            Промышленные <span class="text-primary">рукава</span> и соединения
          </h1>
          <p class="text-lg md:text-xl text-text-secondary mb-8">
            Поставляем высококачественные промышленные шланги, фитинги и хомуты для всех отраслей промышленности. Официальный дилер в Беларуси. Склад в Гродно.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/katalog" class="inline-flex justify-center items-center bg-primary hover:bg-secondary text-white font-accent italic font-bold py-4 px-8 rounded-md transition-colors uppercase tracking-wide text-center shadow-lg hover:shadow-xl">
              Перейти в каталог
            </a>
            <button
              type="button"
              data-crm-open="true"
              @click="$store.crm?.open()"
              onclick="window.openCrmModal && window.openCrmModal()"
              class="crm-trigger inline-flex justify-center items-center bg-white/50 backdrop-blur-sm border-2 border-primary/20 hover:border-primary/50 hover:bg-white/80 text-text-primary font-semibold py-4 px-8 rounded-md transition-all text-center shadow-sm hover:shadow-md cursor-pointer"
            >
              Оставить заявку
            </button>
          </div>

          <div class="mt-12 grid grid-cols-3 gap-6">
            <div>
              <p class="text-3xl font-accent italic font-bold text-primary mb-1">10+</p>
              <p class="text-sm text-text-secondary">Лет на рынке РБ</p>
            </div>
            <div>
              <p class="text-3xl font-accent italic font-bold text-primary mb-1">500+</p>
              <p class="text-sm text-text-secondary">Позиций в каталоге</p>
            </div>
            <div>
              <p class="text-3xl font-accent italic font-bold text-primary mb-1">1 день</p>
              <p class="text-sm text-text-secondary">Доставка при наличии</p>
            </div>
          </div>
        </div>

        <div class="relative hidden lg:block">
          <div class="absolute inset-0 bg-gradient-to-tr from-primary/20 to-transparent rounded-2xl transform translate-x-4 translate-y-4"></div>
          <img src="/img/HPD_Solutions-Industrial-Hose.webp" alt="Промышленные рукава БелФлекс" class="rounded-2xl shadow-xl relative z-10 object-cover h-[500px] w-full" loading="eager" />
          <div class="absolute -bottom-6 -left-6 bg-white/90 backdrop-blur-md p-4 rounded-xl shadow-lg border border-white/60 z-20 flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div>
              <p class="font-bold text-text-primary text-sm">Гарантия качества</p>
              <p class="text-xs text-text-secondary">Вся продукция сертифицирована</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Категории -->
  {categories.length > 0 && (
    <section class="py-16 bg-bg-secondary">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl md:text-4xl text-text-primary mb-4">Каталог <span class="text-primary">продукции</span></h2>
          <p class="text-text-secondary">Широкий ассортимент промышленных рукавов и соединений для любых задач</p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
          {categories.map(cat => (
            <a
              href={`/katalog/${cat.slug}`}
              class="group bg-white border border-border rounded-xl p-4 flex flex-col items-center text-center hover:border-primary/40 hover:shadow-md transition-all duration-200"
            >
              <div class="w-14 h-14 rounded-xl bg-primary/8 flex items-center justify-center mb-3 group-hover:bg-primary/15 transition-colors overflow-hidden">
                {cat.image ? (
                  <img
                    src={`${pbUrl}/api/files/categories/${cat.id}/${cat.image}?thumb=80x80`}
                    alt={cat.name}
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
                  </svg>
                )}
              </div>
              <span class="text-sm font-medium text-text-primary group-hover:text-primary transition-colors leading-tight">{cat.name}</span>
            </a>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/katalog" class="inline-flex items-center gap-2 text-primary font-semibold hover:text-secondary transition-colors">
            Весь каталог
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Почему мы -->
  <section class="py-16 md:py-24 bg-bg-primary relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-secondary/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl text-text-primary mb-4">Почему выбирают <span class="text-primary">БелФлекс</span></h2>
        <p class="text-lg text-text-secondary">Партнёрские бизнес-отношения с нами — это гарантия индивидуального подхода, достоверности документации и своевременного выполнения условий.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {[
          {
            title: 'Гарантия качества',
            text: 'В отличие от конкурентов, мы предоставляем гарантию на всю поставляемую продукцию.',
            icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
          },
          {
            title: 'Лучшие кадры',
            text: 'Вас консультируют профессионалы своего дела. Все сотрудники имеют высшее инженерное образование.',
            icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
          },
          {
            title: 'Широкий выбор',
            text: 'Каталог насчитывает сотни единиц продукции и постоянно пополняется новыми позициями.',
            icon: 'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z',
          },
          {
            title: 'Премиум качество',
            text: 'Сотрудничество с лучшими и проверенными европейскими производителями.',
            icon: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z',
          },
          {
            title: 'Бесплатная доставка',
            text: 'При наличии на складе заказ будет у вас уже на следующий день абсолютно бесплатно.',
            icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4',
          },
          {
            title: 'Техническая поддержка',
            text: 'Помогаем подобрать правильный рукав под конкретную рабочую среду и условия эксплуатации.',
            icon: 'M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z',
          }
        ].map(item => (
          <div class="bg-white border border-border/60 p-7 rounded-2xl shadow-sm hover:shadow-md transition-all group">
            <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary mb-5 group-hover:bg-primary group-hover:text-white transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-2">{item.title}</h3>
            <p class="text-text-secondary text-sm leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Популярные товары -->
  {featuredProducts.length > 0 && (
    <section class="py-16 bg-bg-secondary">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
          <div>
            <h2 class="text-3xl md:text-4xl text-text-primary mb-2">Популярные <span class="text-primary">товары</span></h2>
            <p class="text-text-secondary">Наиболее востребованные позиции в нашем каталоге</p>
          </div>
          <a href="/katalog" class="inline-flex items-center gap-2 text-primary font-semibold hover:text-secondary transition-colors whitespace-nowrap">
            Смотреть все
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {featuredProducts.map(product => {
            const cat = product.expand?.category;
            const productUrl = cat ? `/katalog/${cat.slug}/${product.slug}` : `/katalog/${product.slug}`;
            return (
              <a
                href={productUrl}
                class="group bg-white border border-border rounded-xl overflow-hidden hover:shadow-xl hover:border-primary/30 transition-all duration-300 flex flex-col"
              >
                <div class="relative h-48 bg-white p-4 flex items-center justify-center border-b border-border">
                  {product.images && product.images.length > 0 ? (
                    <img
                      src={`${pbUrl}/api/files/products/${product.id}/${product.images[0]}?thumb=400x300`}
                      alt={product.name}
                      class="object-contain w-full h-full group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                  ) : (
                    <div class="text-primary/20 flex flex-col items-center">
                      <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                    </div>
                  )}
                  <span class="absolute top-3 left-3 bg-primary text-white text-xs font-bold px-2 py-0.5 rounded uppercase tracking-wider">Хит</span>
                </div>
                <div class="p-5 flex-grow flex flex-col">
                  <h3 class="text-base font-bold text-text-primary mb-2 group-hover:text-primary transition-colors line-clamp-2">{product.name}</h3>
                  {product.short_description && (
                    <p class="text-sm text-text-secondary line-clamp-2 mb-4 flex-grow">{product.short_description}</p>
                  )}
                  <div class="mt-auto pt-3 border-t border-border flex justify-between items-center">
                    <span class="text-primary font-accent italic font-bold text-sm uppercase">Подробнее</span>
                    <svg class="w-4 h-4 text-primary group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- О компании (кратко) -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl text-text-primary mb-6">О компании <span class="text-primary">БелФлекс</span></h2>
          <div class="space-y-4 text-text-secondary leading-relaxed">
            <p>ООО «БелФлекс» — официальный дилер промышленных рукавов и соединительной арматуры ведущих европейских производителей в Республике Беларусь. Более 10 лет мы обеспечиваем предприятия Беларуси и СНГ надёжными компонентами для технологических процессов.</p>
            <p>Собственный склад в Гродно позволяет осуществлять поставки точно в срок. Наши специалисты помогут подобрать рукав под конкретную рабочую среду, давление и температурный диапазон.</p>
          </div>
          {homePageData?.content && (
            <div class="mt-4 text-text-secondary leading-relaxed prose prose-sm max-w-none" set:html={homePageData.content} />
          )}
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/o-kompanii" class="inline-flex items-center gap-2 bg-primary hover:bg-secondary text-white font-accent italic font-bold py-3 px-6 rounded-md transition-colors uppercase text-sm tracking-wide shadow-md">
              О компании
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a href="/kontakty" class="inline-flex items-center gap-2 border-2 border-border hover:border-primary/40 text-text-primary font-semibold py-3 px-6 rounded-md transition-all hover:bg-bg-secondary text-sm">
              Контакты и схема проезда
            </a>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-primary rounded-2xl p-6 text-white">
            <p class="text-4xl font-accent italic font-bold mb-2">10+</p>
            <p class="text-sm font-medium opacity-90">Лет на рынке</p>
          </div>
          <div class="bg-bg-secondary border border-border rounded-2xl p-6">
            <p class="text-4xl font-accent italic font-bold text-primary mb-2">500+</p>
            <p class="text-sm font-medium text-text-secondary">Позиций в каталоге</p>
          </div>
          <div class="bg-bg-secondary border border-border rounded-2xl p-6">
            <p class="text-4xl font-accent italic font-bold text-primary mb-2">1 день</p>
            <p class="text-sm font-medium text-text-secondary">Доставка по РБ</p>
          </div>
          <div class="bg-[#1a1a2e] rounded-2xl p-6 text-white">
            <p class="text-4xl font-accent italic font-bold mb-2">B2B</p>
            <p class="text-sm font-medium opacity-90">Работаем с юрлицами</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Нам доверяют / Партнёры (marquee анимация) -->
  <section class="py-12 bg-bg-secondary border-y border-border overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8 text-center">
      <h2 class="text-2xl md:text-3xl text-text-primary font-accent italic">
        Нам <span class="text-primary">доверяют</span>
      </h2>
      <p class="text-xs text-text-muted uppercase tracking-widest mt-1">
        Поставляем рукава и арматуру для крупнейших предприятий промышленности
      </p>
    </div>

    <div class="relative overflow-hidden py-3">
      <div class="animate-marquee gap-12 items-center">
        {[1, 2].map(() => (
          <div class="flex items-center gap-12 shrink-0">
            {manufacturers.length > 0 ? (
              manufacturers.map(mfr => (
                <div class="inline-flex items-center justify-center opacity-60 hover:opacity-100 transition-all duration-300 grayscale hover:grayscale-0 px-4">
                  {mfr.logo ? (
                    <img
                      src={`${pbUrl}/api/files/manufacturers/${mfr.id}/${mfr.logo}?thumb=160x60`}
                      alt={mfr.name}
                      class="h-8 md:h-10 w-auto object-contain"
                      loading="lazy"
                    />
                  ) : (
                    <span class="text-text-primary font-bold text-sm md:text-base whitespace-nowrap">{mfr.name}</span>
                  )}
                </div>
              ))
            ) : (
              fallbackPartners.map(partner => (
                <div class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-white border border-border/80 shadow-xs opacity-75 hover:opacity-100 hover:border-primary/40 transition-all duration-300">
                  <span class="text-text-primary font-bold text-xs md:text-sm whitespace-nowrap tracking-wide">{partner}</span>
                </div>
              ))
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Последние новости -->
  {news.length > 0 && (
    <section class="py-16 bg-bg-primary">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
          <div>
            <h2 class="text-3xl md:text-4xl text-text-primary mb-2">
              Последние <span class="text-primary">новости</span>
            </h2>
            <p class="text-text-secondary">Актуальная информация о компании, поставках и новинках каталога</p>
          </div>
          <a href="/novosti" class="inline-flex items-center gap-2 text-primary font-semibold hover:text-secondary transition-colors whitespace-nowrap">
            Все новости
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {news.map(item => (
            <a
              href={`/novosti/${item.slug}`}
              class="group bg-white border border-border rounded-2xl p-6 flex flex-col hover:border-primary/40 hover:shadow-lg transition-all duration-300"
            >
              <div class="text-xs font-semibold text-primary uppercase tracking-wider mb-3">
                {item.published_date
                  ? new Date(item.published_date).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })
                  : 'Новость'}
              </div>
              <h3 class="font-bold text-text-primary group-hover:text-primary transition-colors text-base leading-snug mb-3 line-clamp-2">
                {item.title}
              </h3>
              {item.excerpt && (
                <p class="text-xs text-text-secondary leading-relaxed mb-6 line-clamp-3 flex-grow">{item.excerpt}</p>
              )}
              <div class="mt-auto pt-4 border-t border-border flex items-center justify-between text-primary font-accent italic font-bold text-xs uppercase">
                <span>Читать далее</span>
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA-баннер -->
  <section class="py-16 bg-primary text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl text-white mb-4 font-accent font-bold italic">Нужна консультация по подбору рукава?</h2>
      <p class="text-white/85 text-base md:text-lg mb-8 max-w-2xl mx-auto leading-relaxed">
        Наши инженеры помогут подобрать оптимальное решение под вашу рабочую среду, давление и температуру. Ответим оперативно.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <button
          type="button"
          data-crm-open="true"
          @click="$store.crm?.open()"
          onclick="window.openCrmModal && window.openCrmModal()"
          class="crm-trigger inline-flex justify-center items-center bg-white text-primary font-accent italic font-bold py-4 px-10 rounded-md transition-all hover:bg-bg-secondary uppercase tracking-wide shadow-lg cursor-pointer"
        >
          Оставить заявку
        </button>
        <a href="tel:+375447800059" class="inline-flex justify-center items-center border-2 border-white/40 hover:border-white text-white font-semibold py-4 px-10 rounded-md transition-all">
          +375 (44) 780-00-59
        </a>
      </div>
    </div>
  </section>
</Layout>
