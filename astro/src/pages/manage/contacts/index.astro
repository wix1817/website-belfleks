---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Toast from '../../../components/admin/ui/Toast.astro';
import { PB_URL } from '../../../lib/adminAuth';

export const prerender = false;
---

<AdminLayout title="Заявки — Админка БелФлекс" activeNav="contacts">
  <div
    x-data={`contactsManager('${PB_URL}')`}
    x-init="init()"
    class="space-y-6"
  >
    <Toast />

    <!-- Top Action Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-border">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight font-accent italic">
            Заявки с сайта
          </h1>
          <span
            x-show="!loading"
            class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 font-mono"
            x-text="totalItems + ' шт.'"
          ></span>
          <template x-if="new24hCount > 0">
            <span
              class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-[#EF1C24] text-white flex items-center gap-1 shadow-2xs animate-pulse"
              x-text="'+ ' + new24hCount + ' новых'"
            ></span>
          </template>
        </div>
        <p class="text-xs text-text-secondary mt-1">
          Все заявки на расчет, звонки и запросы коммерческих предложений от клиентов.
        </p>
      </div>

      <!-- Actions -->
      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          @click="exportCsv()"
          :disabled="loading || items.length === 0"
          class="inline-flex items-center gap-1.5 bg-white border border-border hover:border-green-600 text-gray-700 hover:text-green-700 font-sans text-xs font-semibold py-2.5 px-4 rounded-[8px] transition-colors shadow-2xs cursor-pointer disabled:opacity-50"
          title="Экспортировать заявки в Excel CSV"
        >
          <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          Скачать CSV
        </button>

        <button
          type="button"
          @click="fetchContacts()"
          :disabled="loading"
          class="p-2.5 bg-white hover:bg-gray-50 border border-border rounded-[8px] text-gray-600 hover:text-gray-900 transition-colors cursor-pointer text-xs flex items-center gap-1.5 shadow-2xs"
          title="Обновить данные"
        >
          <svg class="w-4 h-4" :class="{ 'animate-spin': loading }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span class="hidden sm:inline font-sans font-medium">Обновить</span>
        </button>
      </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="bg-white p-4 rounded-[8px] border border-border shadow-xs space-y-3">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <!-- Поиск -->
        <div class="relative lg:col-span-2">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            x-model="searchQuery"
            @input.debounce.300ms="currentPage = 1; fetchContacts()"
            placeholder="Поиск по имени, телефону, email, компании..."
            class="w-full pl-9 pr-8 py-2 bg-[#F7FAFC] border border-border rounded-[8px] text-xs sm:text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary transition-all"
          />
          <button
            type="button"
            x-show="searchQuery.length > 0"
            @click="searchQuery = ''; currentPage = 1; fetchContacts()"
            class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 text-xs cursor-pointer"
          >
            ×
          </button>
        </div>

        <!-- Источник формы -->
        <div>
          <select
            x-model="sourceFilter"
            @change="currentPage = 1; fetchContacts()"
            class="w-full py-2 px-3 bg-[#F7FAFC] border border-border rounded-[8px] text-xs sm:text-sm text-gray-900 focus:outline-none focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary transition-all cursor-pointer"
          >
            <option value="">Все источники</option>
            <template x-for="src in availableSources" :key="src">
              <option :value="src" x-text="src"></option>
            </template>
          </select>
        </div>

        <!-- Сброс фильтров -->
        <div class="flex items-center justify-end">
          <button
            type="button"
            @click="resetFilters()"
            x-show="hasActiveFilters"
            class="text-xs text-primary hover:underline font-semibold font-sans py-2 px-3 cursor-pointer"
          >
            Сбросить фильтры
          </button>
        </div>
      </div>

      <!-- Date Range Filters -->
      <div class="flex flex-wrap items-center gap-3 pt-2 border-t border-border/60 text-xs text-gray-600">
        <span class="font-medium text-gray-700">Период:</span>
        <div class="flex items-center gap-2">
          <label for="date-from" class="text-[11px] text-gray-500">От</label>
          <input
            id="date-from"
            type="date"
            x-model="dateFrom"
            @change="currentPage = 1; fetchContacts()"
            class="py-1 px-2 bg-[#F7FAFC] border border-border rounded-[6px] text-xs text-gray-800 focus:outline-none focus:border-primary focus:bg-white"
          />
        </div>
        <div class="flex items-center gap-2">
          <label for="date-to" class="text-[11px] text-gray-500">До</label>
          <input
            id="date-to"
            type="date"
            x-model="dateTo"
            @change="currentPage = 1; fetchContacts()"
            class="py-1 px-2 bg-[#F7FAFC] border border-border rounded-[6px] text-xs text-gray-800 focus:outline-none focus:border-primary focus:bg-white"
          />
        </div>

        <!-- Quick Period Presets -->
        <div class="flex items-center gap-1.5 ml-auto">
          <button
            type="button"
            @click="setQuickDate('today')"
            class="px-2 py-0.5 rounded hover:bg-gray-100 text-[11px] font-medium text-gray-600 transition-colors cursor-pointer"
          >
            Сегодня
          </button>
          <button
            type="button"
            @click="setQuickDate('7days')"
            class="px-2 py-0.5 rounded hover:bg-gray-100 text-[11px] font-medium text-gray-600 transition-colors cursor-pointer"
          >
            7 дней
          </button>
          <button
            type="button"
            @click="setQuickDate('30days')"
            class="px-2 py-0.5 rounded hover:bg-gray-100 text-[11px] font-medium text-gray-600 transition-colors cursor-pointer"
          >
            30 дней
          </button>
        </div>
      </div>
    </div>

    <!-- Contacts Table -->
    <div class="bg-white border border-border rounded-[8px] shadow-xs overflow-hidden">
      <!-- Loading State -->
      <div x-show="loading" class="py-20 text-center text-primary font-medium text-sm flex items-center justify-center gap-2">
        <svg class="animate-spin h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Загрузка заявок...</span>
      </div>

      <!-- Table Body -->
      <div x-show="!loading" class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs sm:text-sm font-sans">
          <thead>
            <tr class="bg-[#F7FAFC] border-b border-border text-gray-500 font-semibold text-[11px] uppercase tracking-wider">
              <th scope="col" class="py-3 px-4 min-w-[140px]">Дата</th>
              <th scope="col" class="py-3 px-4 min-w-[160px]">Клиент / Компания</th>
              <th scope="col" class="py-3 px-4 min-w-[180px]">Контакты</th>
              <th scope="col" class="py-3 px-4 min-w-[200px]">Сообщение / Запрос</th>
              <th scope="col" class="py-3 px-4 min-w-[150px]">Товар</th>
              <th scope="col" class="py-3 px-3 min-w-[120px]">Источник</th>
              <th scope="col" class="py-3 px-4 text-right w-24 pr-5">Действия</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <template x-for="item in items" :key="item.id">
              <tr class="hover:bg-[#F7FAFC] transition-colors">
                <!-- Дата и статус «Новая» -->
                <td class="py-3.5 px-4 whitespace-nowrap">
                  <div class="flex items-center gap-1.5">
                    <span class="font-mono text-xs text-gray-900 font-medium" x-text="formatDate(item.created)"></span>
                    <template x-if="isNew24h(item.created)">
                      <span class="px-1.5 py-0.2 rounded bg-[#EF1C24] text-white text-[9px] font-bold uppercase tracking-wider flex-shrink-0">
                        Новая
                      </span>
                    </template>
                  </div>
                </td>

                <!-- Клиент / Компания -->
                <td class="py-3.5 px-4">
                  <div class="font-bold text-gray-900 text-sm" x-text="item.name || 'Не указано'"></div>
                  <template x-if="item.company">
                    <div class="text-[11px] text-text-secondary mt-0.5 flex items-center gap-1">
                      <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                      </svg>
                      <span x-text="item.company"></span>
                    </div>
                  </template>
                </td>

                <!-- Телефон и Email (кликабельные) -->
                <td class="py-3.5 px-4">
                  <div class="space-y-1">
                    <template x-if="item.phone">
                      <a
                        :href="'tel:' + cleanPhone(item.phone)"
                        class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-800 hover:text-primary transition-colors font-mono"
                      >
                        <svg class="w-3.5 h-3.5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                        <span x-text="item.phone"></span>
                      </a>
                    </template>
                    <template x-if="item.email">
                      <a
                        :href="'mailto:' + item.email"
                        class="inline-flex items-center gap-1.5 text-xs text-text-secondary hover:text-primary transition-colors truncate block max-w-[180px]"
                      >
                        <svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                        <span x-text="item.email"></span>
                      </a>
                    </template>
                  </div>
                </td>

                <!-- Сообщение (обрезанное + tooltip / клик для просмотра) -->
                <td class="py-3.5 px-4">
                  <div
                    @click="openDetailsModal(item)"
                    class="cursor-pointer group"
                    :title="item.message || 'Нет сообщения'"
                  >
                    <p class="text-xs text-gray-800 line-clamp-2 leading-relaxed group-hover:text-primary transition-colors">
                      <span x-text="truncateText(item.message, 60)"></span>
                    </p>
                  </div>
                </td>

                <!-- Товар (Ссылка на товар в админке) -->
                <td class="py-3.5 px-4">
                  <template x-if="item.expand && item.expand.product">
                    <a
                      :href="'/manage/products/' + item.expand.product.id"
                      class="inline-flex items-center gap-1 text-xs text-primary hover:underline font-semibold line-clamp-2"
                      :title="item.expand.product.name"
                    >
                      <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                      </svg>
                      <span x-text="item.expand.product.name"></span>
                    </a>
                  </template>
                  <template x-if="!item.expand || !item.expand.product">
                    <span class="text-xs text-gray-400">—</span>
                  </template>
                </td>

                <!-- Источник -->
                <td class="py-3.5 px-3 whitespace-nowrap">
                  <span
                    class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-gray-100 text-gray-700 border border-gray-200"
                    x-text="item.source || 'Сайт'"
                  ></span>
                </td>

                <!-- Действия -->
                <td class="py-3.5 px-4 text-right pr-5 whitespace-nowrap">
                  <div class="flex items-center justify-end gap-1.5">
                    <!-- View details modal -->
                    <button
                      type="button"
                      @click="openDetailsModal(item)"
                      class="p-1.5 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-[6px] transition-colors cursor-pointer"
                      title="Подробнее"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                      </svg>
                    </button>

                    <!-- Delete -->
                    <button
                      type="button"
                      @click="deleteContact(item)"
                      class="p-1.5 text-gray-500 hover:text-[#EF1C24] hover:bg-red-50 rounded-[6px] transition-colors cursor-pointer"
                      title="Удалить заявку"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            </template>

            <tr x-show="items.length === 0">
              <td colspan="7" class="py-16 text-center text-gray-400">
                <svg class="w-12 h-12 mx-auto text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                </svg>
                <p class="text-sm font-medium text-gray-700">Заявок не найдено</p>
                <p class="text-xs text-gray-500 mt-1">Попробуйте изменить параметры поиска или период дат.</p>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div
        x-show="totalPages > 1"
        class="bg-[#F7FAFC] px-4 py-3 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-600 font-sans"
      >
        <div>
          Показано <span class="font-semibold text-gray-900" x-text="((currentPage - 1) * perPage) + 1"></span> -
          <span class="font-semibold text-gray-900" x-text="Math.min(currentPage * perPage, totalItems)"></span> из
          <span class="font-semibold text-gray-900" x-text="totalItems"></span> заявок
        </div>

        <div class="flex items-center gap-1">
          <button
            type="button"
            @click="changePage(currentPage - 1)"
            :disabled="currentPage <= 1"
            class="px-3 py-1.5 rounded-[6px] border border-border bg-white hover:bg-gray-50 text-gray-700 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            ← Назад
          </button>

          <span class="px-3 py-1.5 font-semibold text-gray-900">
            <span x-text="currentPage"></span> / <span x-text="totalPages"></span>
          </span>

          <button
            type="button"
            @click="changePage(currentPage + 1)"
            :disabled="currentPage >= totalPages"
            class="px-3 py-1.5 rounded-[6px] border border-border bg-white hover:bg-gray-50 text-gray-700 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Вперед →
          </button>
        </div>
      </div>
    </div>

    <!-- Lead Details Modal -->
    <div
      x-show="detailsModalOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs"
      @keydown.escape.window="detailsModalOpen = false"
    >
      <div
        @click.away="detailsModalOpen = false"
        class="bg-white rounded-[12px] border border-border shadow-xl max-w-lg w-full overflow-hidden text-gray-900 font-sans"
      >
        <!-- Modal Header -->
        <div class="px-6 py-4 bg-[#F7FAFC] border-b border-border flex items-center justify-between">
          <div class="flex items-center gap-2">
            <h3 class="font-bold text-base text-gray-900">Детали заявки</h3>
            <template x-if="selectedLead && isNew24h(selectedLead.created)">
              <span class="px-2 py-0.5 rounded bg-[#EF1C24] text-white text-[10px] font-bold uppercase tracking-wider">
                Новая
              </span>
            </template>
          </div>
          <button
            type="button"
            @click="detailsModalOpen = false"
            class="text-gray-400 hover:text-gray-600 text-lg cursor-pointer"
          >
            ×
          </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6 space-y-4 text-xs sm:text-sm" x-show="selectedLead">
          <!-- Client & Company -->
          <div class="grid grid-cols-2 gap-4 pb-3 border-b border-border">
            <div>
              <span class="text-text-secondary text-xs block mb-0.5">Клиент:</span>
              <span class="font-bold text-gray-900 text-sm" x-text="selectedLead?.name || '—'"></span>
            </div>
            <div>
              <span class="text-text-secondary text-xs block mb-0.5">Компания:</span>
              <span class="font-semibold text-gray-900 text-sm" x-text="selectedLead?.company || '—'"></span>
            </div>
          </div>

          <!-- Contacts -->
          <div class="grid grid-cols-2 gap-4 pb-3 border-b border-border">
            <div>
              <span class="text-text-secondary text-xs block mb-0.5">Телефон:</span>
              <template x-if="selectedLead?.phone">
                <a
                  :href="'tel:' + cleanPhone(selectedLead?.phone)"
                  class="font-mono font-bold text-primary hover:underline block text-sm"
                  x-text="selectedLead?.phone"
                ></a>
              </template>
              <template x-if="!selectedLead?.phone">
                <span class="text-gray-400">—</span>
              </template>
            </div>
            <div>
              <span class="text-text-secondary text-xs block mb-0.5">Email:</span>
              <template x-if="selectedLead?.email">
                <a
                  :href="'mailto:' + selectedLead?.email"
                  class="font-semibold text-blue-600 hover:underline block text-xs truncate"
                  x-text="selectedLead?.email"
                ></a>
              </template>
              <template x-if="!selectedLead?.email">
                <span class="text-gray-400">—</span>
              </template>
            </div>
          </div>

          <!-- Message -->
          <div class="pb-3 border-b border-border">
            <span class="text-text-secondary text-xs block mb-1">Сообщение / Запрос:</span>
            <div
              class="p-3 bg-[#F7FAFC] rounded-[8px] border border-border text-gray-900 text-xs sm:text-sm leading-relaxed whitespace-pre-wrap"
              x-text="selectedLead?.message || 'Текст сообщения отсутствует.'"
            ></div>
          </div>

          <!-- Product info -->
          <template x-if="selectedLead?.expand && selectedLead?.expand?.product">
            <div class="pb-3 border-b border-border">
              <span class="text-text-secondary text-xs block mb-1">Интересующий товар:</span>
              <a
                :href="'/manage/products/' + selectedLead?.expand?.product?.id"
                class="inline-flex items-center gap-1.5 p-2 bg-red-50/50 border border-red-100 rounded-[6px] text-xs font-semibold text-primary hover:underline"
              >
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                </svg>
                <span x-text="selectedLead?.expand?.product?.name"></span>
              </a>
            </div>
          </template>

          <!-- Source & Date -->
          <div class="grid grid-cols-2 gap-4 text-xs text-text-secondary">
            <div>
              <span>Источник:</span>
              <span class="font-medium text-gray-800 ml-1" x-text="selectedLead?.source || 'Сайт'"></span>
            </div>
            <div>
              <span>Дата создания:</span>
              <span class="font-mono font-medium text-gray-800 ml-1" x-text="formatDate(selectedLead?.created)"></span>
            </div>
          </div>
        </div>

        <!-- Modal Footer -->
        <div class="px-6 py-3.5 bg-[#F7FAFC] border-t border-border flex items-center justify-between">
          <button
            type="button"
            @click="deleteContact(selectedLead); detailsModalOpen = false;"
            class="text-xs text-[#EF1C24] hover:underline font-semibold cursor-pointer"
          >
            Удалить заявку
          </button>

          <button
            type="button"
            @click="detailsModalOpen = false"
            class="py-2 px-4 rounded-[8px] bg-gray-900 hover:bg-gray-800 text-white text-xs font-semibold cursor-pointer transition-colors"
          >
            Закрыть
          </button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<!-- Global Contacts Manager Alpine Script -->
<script is:inline>
  window.contactsManager = function(pbUrl) {
    return {
      pb: null,
      pbUrl: pbUrl || 'http://127.0.0.1:8090',
      loading: true,
      items: [],
      totalItems: 0,
      totalPages: 1,
      currentPage: 1,
      perPage: 20,

      searchQuery: '',
      sourceFilter: '',
      dateFrom: '',
      dateTo: '',

      availableSources: [
        'Карточка товара',
        'Форма в подвале',
        'Быстрый заказ',
        'Модальное окно КП',
        'Страница контактов',
        'Каталог'
      ],

      detailsModalOpen: false,
      selectedLead: null,

      get hasActiveFilters() {
        return Boolean(this.searchQuery.trim() || this.sourceFilter || this.dateFrom || this.dateTo);
      },

      get new24hCount() {
        const now = Date.now();
        const oneDayMs = 24 * 60 * 60 * 1000;
        return this.items.filter(item => {
          if (!item.created) return false;
          return (now - new Date(item.created).getTime()) < oneDayMs;
        }).length;
      },

      getEffectivePbUrl() {
        if (typeof window !== 'undefined') {
          // If accessing via localhost or custom host, match the hostname to prevent cross-origin cookie issues
          if (window.location.hostname === 'localhost' && this.pbUrl.includes('127.0.0.1')) {
            return this.pbUrl.replace('127.0.0.1', 'localhost');
          }
          if (window.location.hostname === '127.0.0.1' && this.pbUrl.includes('localhost')) {
            return this.pbUrl.replace('localhost', '127.0.0.1');
          }
        }
        return this.pbUrl || 'http://127.0.0.1:8090';
      },

      async init() {
        // Wait for window.PocketBase if script tag is still resolving
        for (let i = 0; i < 20; i++) {
          if (window.PocketBase) break;
          await new Promise(r => setTimeout(r, 50));
        }

        this.initPb();
        await this.fetchContacts();
      },

      initPb() {
        if (window.PocketBase) {
          const url = this.getEffectivePbUrl();
          this.pb = new window.PocketBase(url);
          this.pb.autoCancellation(false);
          this.pb.authStore.loadFromCookie(document.cookie);
        }
      },

      async fetchContacts() {
        this.loading = true;
        try {
          if (!this.pb) {
            this.initPb();
          }
          if (!this.pb) {
            await new Promise(r => setTimeout(r, 100));
            this.initPb();
          }
          if (!this.pb) {
            throw new Error('Библиотека PocketBase не загружена');
          }

          const filterParts = [];

          if (this.searchQuery.trim()) {
            const q = this.searchQuery.trim().replace(/"/g, '\\"');
            filterParts.push(`(name ~ "${q}" || phone ~ "${q}" || email ~ "${q}" || company ~ "${q}" || message ~ "${q}")`);
          }

          if (this.sourceFilter) {
            filterParts.push(`source = "${this.sourceFilter}"`);
          }

          if (this.dateFrom) {
            filterParts.push(`created >= "${this.dateFrom} 00:00:00"`);
          }

          if (this.dateTo) {
            filterParts.push(`created <= "${this.dateTo} 23:59:59"`);
          }

          const options = {
            sort: '-created',
            expand: 'product',
            $autoCancel: false,
            requestKey: null
          };

          if (filterParts.length > 0) {
            options.filter = filterParts.join(' && ');
          }

          const result = await this.pb.collection('contacts').getList(this.currentPage, this.perPage, options);

          this.items = result.items || [];
          this.totalItems = result.totalItems || 0;
          this.totalPages = result.totalPages || 1;

          // Dynamically gather other unique sources if any
          this.items.forEach(it => {
            if (it.source && !this.availableSources.includes(it.source)) {
              this.availableSources.push(it.source);
            }
          });
        } catch (e) {
          console.error('Error fetching contacts:', e);
          this.emitToast('Ошибка загрузки заявок: ' + (e?.message || ''), 'error');
        } finally {
          this.loading = false;
        }
      },

      changePage(page) {
        if (page < 1 || page > this.totalPages) return;
        this.currentPage = page;
        this.fetchContacts();
      },

      resetFilters() {
        this.searchQuery = '';
        this.sourceFilter = '';
        this.dateFrom = '';
        this.dateTo = '';
        this.currentPage = 1;
        this.fetchContacts();
      },

      setQuickDate(type) {
        const now = new Date();
        const formatDateStr = d => d.toISOString().split('T')[0];

        this.dateTo = formatDateStr(now);

        if (type === 'today') {
          this.dateFrom = formatDateStr(now);
        } else if (type === '7days') {
          const past = new Date();
          past.setDate(now.getDate() - 7);
          this.dateFrom = formatDateStr(past);
        } else if (type === '30days') {
          const past = new Date();
          past.setDate(now.getDate() - 30);
          this.dateFrom = formatDateStr(past);
        }

        this.currentPage = 1;
        this.fetchContacts();
      },

      formatDate(dateStr) {
        if (!dateStr) return '—';
        try {
          const d = new Date(dateStr);
          return d.toLocaleDateString('ru-RU', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
          });
        } catch {
          return dateStr;
        }
      },

      isNew24h(dateStr) {
        if (!dateStr) return false;
        const now = Date.now();
        const oneDayMs = 24 * 60 * 60 * 1000;
        return (now - new Date(dateStr).getTime()) < oneDayMs;
      },

      cleanPhone(phone) {
        if (!phone) return '';
        return phone.replace(/[^\d+]/g, '');
      },

      truncateText(text, maxLen = 50) {
        if (!text) return '—';
        if (text.length <= maxLen) return text;
        return text.substring(0, maxLen) + '...';
      },

      openDetailsModal(lead) {
        this.selectedLead = lead;
        this.detailsModalOpen = true;
      },

      async deleteContact(lead) {
        if (!lead || !lead.id) return;
        if (!confirm(`Удалить заявку от ${lead.name || 'клиента'} (${this.formatDate(lead.created)})?`)) {
          return;
        }

        try {
          if (!this.pb) this.initPb();
          await this.pb.collection('contacts').delete(lead.id);
          this.emitToast('Заявка удалена', 'success');
          await this.fetchContacts();
        } catch (e) {
          console.error('Error deleting contact:', e);
          this.emitToast('Ошибка при удалении заявки', 'error');
        }
      },

      // --- Export to CSV with UTF-8 BOM & Semicolon delimiter ---
      async exportCsv() {
        try {
          this.emitToast('Формирование CSV...', 'info');

          // Fetch all matching records without pagination limit
          const filterParts = [];
          if (this.searchQuery.trim()) {
            const q = this.searchQuery.trim().replace(/"/g, '\\"');
            filterParts.push(`(name ~ "${q}" || phone ~ "${q}" || email ~ "${q}" || company ~ "${q}" || message ~ "${q}")`);
          }
          if (this.sourceFilter) filterParts.push(`source = "${this.sourceFilter}"`);
          if (this.dateFrom) filterParts.push(`created >= "${this.dateFrom} 00:00:00"`);
          if (this.dateTo) filterParts.push(`created <= "${this.dateTo} 23:59:59"`);

          const options = {
            sort: '-created',
            expand: 'product',
            $autoCancel: false,
            requestKey: null
          };

          if (filterParts.length > 0) {
            options.filter = filterParts.join(' && ');
          }

          if (!this.pb) this.initPb();

          const allRecords = await this.pb.collection('contacts').getFullList(options);

          if (allRecords.length === 0) {
            this.emitToast('Нет данных для экспорта', 'warning');
            return;
          }

          const headers = ['Дата', 'Имя', 'Компания', 'Телефон', 'Email', 'Сообщение', 'Товар', 'Источник'];

          const rows = allRecords.map(r => {
            const date = this.formatDate(r.created);
            const name = r.name || '';
            const company = r.company || '';
            const phone = r.phone || '';
            const email = r.email || '';
            const message = (r.message || '').replace(/\r?\n/g, ' ').replace(/"/g, '""');
            const product = (r.expand?.product?.name || '').replace(/"/g, '""');
            const source = r.source || '';

            return `"${date}";"${name}";"${company}";"${phone}";"${email}";"${message}";"${product}";"${source}"`;
          });

          // UTF-8 BOM \uFEFF ensures Russian characters open without encoding issues in Excel
          const csvContent = '\uFEFF' + headers.join(';') + '\n' + rows.join('\n');

          const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          const todayStr = new Date().toISOString().split('T')[0];

          link.setAttribute('href', url);
          link.setAttribute('download', `belfleks_leads_${todayStr}.csv`);
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          URL.revokeObjectURL(url);

          this.emitToast(`Экспортировано ${allRecords.length} заявок`, 'success');
        } catch (e) {
          console.error('Error exporting CSV:', e);
          this.emitToast('Ошибка при экспорте CSV', 'error');
        }
      },

      emitToast(message, type = 'success') {
        window.dispatchEvent(new CustomEvent('admin-toast', {
          detail: { message, type }
        }));
      }
    };
  };
</script>
