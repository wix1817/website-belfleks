---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Toast from '../../../components/admin/ui/Toast.astro';
import { PB_URL } from '../../../lib/adminAuth';

export const prerender = false;
---

<AdminLayout title="Документы — Админка БелФлекс" activeNav="documents">
  <div
    x-data={`documentsManager('${PB_URL}')`}
    x-init="init()"
    class="space-y-6"
  >
    <Toast />

    <!-- Top Action Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-border">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight font-accent italic">
            Документы и сертификаты
          </h1>
          <span
            x-show="!loading"
            class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 font-mono"
            x-text="totalItems + ' шт.'"
          ></span>
        </div>
        <p class="text-xs text-text-secondary mt-1">
          Сертификаты соответствия, каталоги, технические паспорта и презентации для скачивания.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          @click="openModal()"
          class="inline-flex items-center justify-center gap-2 bg-[#EF1C24] hover:bg-[#d91920] active:scale-[0.99] text-white font-sans text-xs font-semibold py-2.5 px-4 rounded-[8px] transition-all shadow-xs flex-shrink-0 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Загрузить документ
        </button>
      </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="bg-white p-4 rounded-[8px] border border-border shadow-xs flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
      <!-- Search Input -->
      <div class="relative flex-1 max-w-md">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          x-model="searchQuery"
          @input.debounce.300ms="currentPage = 1; fetchDocuments()"
          placeholder="Поиск по названию документа..."
          class="w-full pl-9 pr-8 py-2 bg-[#F7FAFC] border border-border rounded-[8px] text-xs sm:text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary transition-all"
        />
        <button
          type="button"
          x-show="searchQuery.length > 0"
          @click="searchQuery = ''; currentPage = 1; fetchDocuments()"
          class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 text-xs cursor-pointer"
        >
          ×
        </button>
      </div>

      <!-- Category Filter -->
      <div class="flex items-center gap-2">
        <select
          x-model="categoryFilter"
          @change="currentPage = 1; fetchDocuments()"
          class="py-2 px-3 bg-[#F7FAFC] border border-border rounded-[8px] text-xs sm:text-sm text-gray-900 focus:outline-none focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary transition-all cursor-pointer"
        >
          <option value="">Все категории</option>
          <template x-for="cat in categoriesList" :key="cat">
            <option :value="cat" x-text="cat"></option>
          </template>
        </select>

        <button
          type="button"
          @click="fetchDocuments()"
          :disabled="loading"
          class="p-2 bg-[#F7FAFC] hover:bg-gray-100 border border-border rounded-[8px] text-gray-600 hover:text-gray-900 transition-colors cursor-pointer text-xs flex items-center gap-1.5 shadow-2xs"
          title="Обновить список"
        >
          <svg class="w-4 h-4" :class="{ 'animate-spin': loading }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span class="hidden sm:inline">Обновить</span>
        </button>
      </div>
    </div>

    <!-- Documents Table -->
    <div class="bg-white border border-border rounded-[8px] shadow-xs overflow-hidden">
      <!-- Loading State -->
      <div x-show="loading" class="py-20 text-center text-primary font-medium text-sm flex items-center justify-center gap-2">
        <svg class="animate-spin h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Загрузка документов...</span>
      </div>

      <!-- Table Content -->
      <div x-show="!loading" class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs sm:text-sm font-sans">
          <thead>
            <tr class="bg-[#F7FAFC] border-b border-border text-gray-500 font-semibold text-[11px] uppercase tracking-wider">
              <th scope="col" class="py-3 px-4 min-w-[280px]">Документ</th>
              <th scope="col" class="py-3 px-4 min-w-[180px]">Категория</th>
              <th scope="col" class="py-3 px-4 w-32">Дата</th>
              <th scope="col" class="py-3 px-4 text-right w-36 pr-5">Действия</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <template x-for="doc in items" :key="doc.id">
              <tr class="hover:bg-[#F7FAFC] transition-colors">
                <!-- Title & Description -->
                <td class="py-3.5 px-4">
                  <div class="flex items-center gap-3">
                    <!-- PDF Icon -->
                    <div class="w-9 h-9 rounded-[6px] bg-red-50 border border-red-100 flex items-center justify-center text-primary flex-shrink-0">
                      <svg class="w-5 h-5 text-[#EF1C24]" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M11.363 2c4.155 0 2.637 6 2.637 6s6-1.65 6 2.457v11.543h-16v-20h7.363zm.826 2h-6.189v16h12v-9.543c0-1.859-3.799-.457-3.799-.457s.018-6-2.012-6zm-.826 8c1.654 0 3 1.346 3 3s-1.346 3-3 3-3-1.346-3-3 1.346-3 3-3z"/>
                      </svg>
                    </div>
                    <div>
                      <div class="font-bold text-gray-900 text-sm" x-text="doc.title"></div>
                      <template x-if="doc.description">
                        <p class="text-[11px] text-text-secondary line-clamp-1 mt-0.5" x-text="doc.description"></p>
                      </template>
                      <template x-if="doc.file">
                        <span class="text-[10px] font-mono text-gray-400" x-text="doc.file"></span>
                      </template>
                    </div>
                  </div>
                </td>

                <!-- Category -->
                <td class="py-3.5 px-4">
                  <span
                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold"
                    :class="getCategoryBadgeClass(doc.category)"
                    x-text="doc.category || 'Без категории'"
                  ></span>
                </td>

                <!-- Date -->
                <td class="py-3.5 px-4 whitespace-nowrap font-mono text-xs text-gray-600">
                  <span x-text="formatDate(doc.date || doc.created)"></span>
                </td>

                <!-- Actions -->
                <td class="py-3.5 px-4 text-right pr-5 whitespace-nowrap">
                  <div class="flex items-center justify-end gap-1.5">
                    <!-- Download/View file -->
                    <a
                      :href="getFileUrl(doc)"
                      target="_blank"
                      class="p-1.5 text-gray-500 hover:text-primary hover:bg-gray-100 rounded-[6px] transition-colors cursor-pointer"
                      title="Скачать / Просмотреть PDF"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                      </svg>
                    </a>

                    <!-- Edit -->
                    <button
                      type="button"
                      @click="openModal(doc)"
                      class="p-1.5 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-[6px] transition-colors cursor-pointer"
                      title="Редактировать"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                    </button>

                    <!-- Delete -->
                    <button
                      type="button"
                      @click="deleteDocument(doc)"
                      class="p-1.5 text-gray-500 hover:text-[#EF1C24] hover:bg-red-50 rounded-[6px] transition-colors cursor-pointer"
                      title="Удалить документ"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            </template>

            <tr x-show="items.length === 0">
              <td colspan="4" class="py-16 text-center text-gray-400">
                <svg class="w-12 h-12 mx-auto text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <p class="text-sm font-medium text-gray-700">Документов не найдено</p>
                <p class="text-xs text-gray-500 mt-1">Загрузите новый документ с помощью кнопки вверху.</p>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div
        x-show="totalPages > 1"
        class="bg-[#F7FAFC] px-4 py-3 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-600 font-sans"
      >
        <div>
          Показано <span class="font-semibold text-gray-900" x-text="((currentPage - 1) * perPage) + 1"></span> -
          <span class="font-semibold text-gray-900" x-text="Math.min(currentPage * perPage, totalItems)"></span> из
          <span class="font-semibold text-gray-900" x-text="totalItems"></span> документов
        </div>

        <div class="flex items-center gap-1">
          <button
            type="button"
            @click="changePage(currentPage - 1)"
            :disabled="currentPage <= 1"
            class="px-3 py-1.5 rounded-[6px] border border-border bg-white hover:bg-gray-50 text-gray-700 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            ← Назад
          </button>

          <span class="px-3 py-1.5 font-semibold text-gray-900">
            <span x-text="currentPage"></span> / <span x-text="totalPages"></span>
          </span>

          <button
            type="button"
            @click="changePage(currentPage + 1)"
            :disabled="currentPage >= totalPages"
            class="px-3 py-1.5 rounded-[6px] border border-border bg-white hover:bg-gray-50 text-gray-700 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Вперед →
          </button>
        </div>
      </div>
    </div>

    <!-- Upload/Edit Modal -->
    <div
      x-show="modalOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs"
      @keydown.escape.window="modalOpen = false"
    >
      <div
        @click.away="modalOpen = false"
        class="bg-white rounded-[12px] border border-border shadow-xl max-w-md w-full overflow-hidden text-gray-900 font-sans"
      >
        <!-- Header -->
        <div class="px-6 py-4 bg-[#F7FAFC] border-b border-border flex items-center justify-between">
          <h3 class="font-bold text-base text-gray-900" x-text="isEdit ? 'Редактирование документа' : 'Загрузка документа'"></h3>
          <button
            type="button"
            @click="modalOpen = false"
            class="text-gray-400 hover:text-gray-600 text-lg cursor-pointer"
          >
            ×
          </button>
        </div>

        <!-- Body -->
        <form @submit.prevent="saveDocument()" class="p-6 space-y-4 text-xs sm:text-sm">
          <!-- Title -->
          <div>
            <label class="block text-xs font-semibold text-[#3B3B3B] mb-1">
              Название документа <span class="text-[#EF1C24]">*</span>
            </label>
            <input
              type="text"
              x-model="form.title"
              placeholder="например: Сертификат соответствия ГОСТ"
              required
              class="w-full bg-[#F7FAFC] border border-border focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary rounded-[6px] py-2 px-3 text-xs sm:text-sm text-gray-900"
            />
          </div>

          <!-- Category -->
          <div>
            <label class="block text-xs font-semibold text-[#3B3B3B] mb-1">
              Категория документа
            </label>
            <select
              x-model="form.category"
              class="w-full bg-[#F7FAFC] border border-border focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary rounded-[6px] py-2 px-3 text-xs sm:text-sm text-gray-900 cursor-pointer"
            >
              <template x-for="cat in categoriesList" :key="cat">
                <option :value="cat" x-text="cat"></option>
              </template>
            </select>
          </div>

          <!-- Date -->
          <div>
            <label class="block text-xs font-semibold text-[#3B3B3B] mb-1">
              Дата документа
            </label>
            <input
              type="date"
              x-model="form.date"
              class="w-full bg-[#F7FAFC] border border-border focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary rounded-[6px] py-2 px-3 text-xs text-gray-900"
            />
          </div>

          <!-- Description -->
          <div>
            <label class="block text-xs font-semibold text-[#3B3B3B] mb-1">
              Краткое описание (опционально)
            </label>
            <textarea
              rows="2"
              x-model="form.description"
              placeholder="Описание содержания документа..."
              class="w-full bg-[#F7FAFC] border border-border focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary rounded-[6px] py-2 px-3 text-xs text-gray-900 resize-none"
            ></textarea>
          </div>

          <!-- File Upload -->
          <div>
            <label class="block text-xs font-semibold text-[#3B3B3B] mb-1">
              Файл (PDF, макс. 20 МБ) <span x-show="!isEdit" class="text-[#EF1C24]">*</span>
            </label>
            
            <div
              @dragover.prevent="isDraggingOver = true"
              @dragleave.prevent="isDraggingOver = false"
              @drop.prevent="handleFileDrop($event)"
              @click="$refs.pdfInput.click()"
              class="border-2 border-dashed rounded-[8px] p-4 text-center cursor-pointer transition-all"
              :class="isDraggingOver ? 'border-[#EF1C24] bg-red-50/20' : 'border-border bg-[#F7FAFC] hover:bg-gray-50'"
            >
              <input
                type="file"
                x-ref="pdfInput"
                @change="handleFileInput($event)"
                accept="application/pdf"
                class="hidden"
              />
              
              <template x-if="selectedFile">
                <div class="flex items-center justify-center gap-2 text-primary font-medium text-xs">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span x-text="selectedFile.name + ' (' + formatBytes(selectedFile.size) + ')'"></span>
                </div>
              </template>

              <template x-if="!selectedFile">
                <div>
                  <svg class="w-8 h-8 mx-auto text-gray-400 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
                  </svg>
                  <p class="text-xs text-gray-700 font-medium">
                    Нажмите для выбора или перетащите <span class="text-primary font-bold">PDF файл</span>
                  </p>
                  <template x-if="isEdit && existingFileName">
                    <p class="text-[11px] text-gray-500 mt-1 font-mono">
                      Текущий файл: <span x-text="existingFileName"></span>
                    </p>
                  </template>
                </div>
              </template>
            </div>
          </div>

          <!-- Footer Buttons -->
          <div class="flex items-center justify-end gap-2 pt-3 border-t border-border">
            <button
              type="button"
              @click="modalOpen = false"
              class="py-2 px-4 rounded-[8px] border border-border bg-white text-gray-700 hover:bg-gray-50 text-xs font-semibold cursor-pointer"
            >
              Отмена
            </button>
            <button
              type="submit"
              :disabled="saving"
              class="py-2 px-5 rounded-[8px] bg-[#EF1C24] hover:bg-[#d91920] text-white text-xs font-semibold cursor-pointer shadow-xs disabled:opacity-50 flex items-center gap-1.5"
            >
              <template x-if="saving">
                <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </template>
              <span x-text="isEdit ? 'Сохранить изменения' : 'Загрузить'"></span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>

<!-- Global Documents Manager Alpine Script -->
<script is:inline>
  window.documentsManager = function(pbUrl) {
    return {
      pb: null,
      pbUrl: pbUrl || 'http://127.0.0.1:8090',
      loading: true,
      saving: false,
      items: [],
      totalItems: 0,
      totalPages: 1,
      currentPage: 1,
      perPage: 20,

      searchQuery: '',
      categoryFilter: '',
      modalOpen: false,
      isEdit: false,
      editId: '',
      existingFileName: '',
      selectedFile: null,
      isDraggingOver: false,

      categoriesList: [
        'Сертификаты соответствия',
        'Техническая документация',
        'Прайс-листы',
        'Презентации',
        'Каталоги продукции',
        'Другое'
      ],

      form: {
        title: '',
        category: 'Сертификаты соответствия',
        description: '',
        date: '',
      },

      getEffectivePbUrl() {
        if (typeof window !== 'undefined') {
          if (window.location.hostname === 'localhost' && this.pbUrl.includes('127.0.0.1')) {
            return this.pbUrl.replace('127.0.0.1', 'localhost');
          }
          if (window.location.hostname === '127.0.0.1' && this.pbUrl.includes('localhost')) {
            return this.pbUrl.replace('localhost', '127.0.0.1');
          }
        }
        return this.pbUrl || 'http://127.0.0.1:8090';
      },

      async init() {
        for (let i = 0; i < 20; i++) {
          if (window.PocketBase) break;
          await new Promise(r => setTimeout(r, 50));
        }

        this.initPb();
        await this.fetchDocuments();
      },

      initPb() {
        if (window.PocketBase) {
          const url = this.getEffectivePbUrl();
          this.pb = new window.PocketBase(url);
          this.pb.autoCancellation(false);
          this.pb.authStore.loadFromCookie(document.cookie);
        }
      },

      async fetchDocuments() {
        this.loading = true;
        try {
          if (!this.pb) this.initPb();
          if (!this.pb) {
            await new Promise(r => setTimeout(r, 100));
            this.initPb();
          }
          if (!this.pb) throw new Error('Библиотека PocketBase не загружена');

          const filterParts = [];
          if (this.searchQuery.trim()) {
            const q = this.searchQuery.trim().replace(/"/g, '\\"');
            filterParts.push(`(title ~ "${q}" || description ~ "${q}")`);
          }
          if (this.categoryFilter) {
            filterParts.push(`category = "${this.categoryFilter}"`);
          }

          const options = {
            sort: '-created,-date',
            $autoCancel: false,
            requestKey: null
          };

          if (filterParts.length > 0) {
            options.filter = filterParts.join(' && ');
          }

          const result = await this.pb.collection('documents').getList(this.currentPage, this.perPage, options);
          this.items = result.items || [];
          this.totalItems = result.totalItems || 0;
          this.totalPages = result.totalPages || 1;
        } catch (e) {
          console.error('Error fetching documents:', e);
          this.emitToast('Ошибка загрузки документов: ' + (e?.message || ''), 'error');
        } finally {
          this.loading = false;
        }
      },

      changePage(page) {
        if (page < 1 || page > this.totalPages) return;
        this.currentPage = page;
        this.fetchDocuments();
      },

      getFileUrl(doc) {
        if (!doc || !doc.file) return '#';
        const effectiveUrl = this.getEffectivePbUrl();
        return `${effectiveUrl}/api/files/documents/${doc.id}/${doc.file}`;
      },

      formatDate(dateStr) {
        if (!dateStr) return '—';
        try {
          const d = new Date(dateStr);
          return d.toLocaleDateString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric' });
        } catch {
          return dateStr;
        }
      },

      formatBytes(bytes) {
        if (!bytes) return '0 B';
        const k = 1024;
        const sizes = ['B', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
      },

      getCategoryBadgeClass(category) {
        switch (category) {
          case 'Сертификаты соответствия':
            return 'bg-green-50 text-green-700 border border-green-200';
          case 'Техническая документация':
            return 'bg-blue-50 text-blue-700 border border-blue-200';
          case 'Каталоги продукции':
            return 'bg-purple-50 text-purple-700 border border-purple-200';
          case 'Прайс-листы':
            return 'bg-amber-50 text-amber-700 border border-amber-200';
          case 'Презентации':
            return 'bg-rose-50 text-rose-700 border border-rose-200';
          default:
            return 'bg-gray-100 text-gray-700 border border-gray-200';
        }
      },

      openModal(doc = null) {
        if (doc) {
          this.isEdit = true;
          this.editId = doc.id;
          this.existingFileName = doc.file || '';
          this.form.title = doc.title || '';
          this.form.category = doc.category || 'Сертификаты соответствия';
          this.form.description = doc.description || '';
          this.form.date = doc.date ? doc.date.split('T')[0].split(' ')[0] : '';
          this.selectedFile = null;
        } else {
          this.isEdit = false;
          this.editId = '';
          this.existingFileName = '';
          this.form.title = '';
          this.form.category = 'Сертификаты соответствия';
          this.form.description = '';
          this.form.date = new Date().toISOString().split('T')[0];
          this.selectedFile = null;
        }
        this.modalOpen = true;
      },

      handleFileInput(e) {
        const file = e.target.files?.[0];
        if (file) this.processPdf(file);
        e.target.value = '';
      },

      handleFileDrop(e) {
        this.isDraggingOver = false;
        const file = e.dataTransfer?.files?.[0];
        if (file) this.processPdf(file);
      },

      processPdf(file) {
        if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
          this.emitToast('Разрешена загрузка только файлов формата PDF', 'error');
          return;
        }
        if (file.size > 20 * 1024 * 1024) {
          this.emitToast('Размер файла не должен превышать 20 МБ', 'error');
          return;
        }
        this.selectedFile = file;
        if (!this.form.title) {
          this.form.title = file.name.replace(/\.pdf$/i, '');
        }
      },

      async saveDocument() {
        if (!this.form.title.trim()) {
          this.emitToast('Введите название документа', 'error');
          return;
        }
        if (!this.isEdit && !this.selectedFile) {
          this.emitToast('Выберите PDF файл для загрузки', 'error');
          return;
        }

        this.saving = true;
        try {
          if (!this.pb) this.initPb();

          const formData = new FormData();
          formData.append('title', this.form.title.trim());
          formData.append('category', this.form.category);
          formData.append('description', this.form.description.trim());
          if (this.form.date) {
            formData.append('date', `${this.form.date} 00:00:00.000Z`);
          }
          if (this.selectedFile) {
            formData.append('file', this.selectedFile);
          }

          if (this.isEdit) {
            await this.pb.collection('documents').update(this.editId, formData);
            this.emitToast('Документ успешно обновлен', 'success');
          } else {
            await this.pb.collection('documents').create(formData);
            this.emitToast('Документ успешно загружен', 'success');
          }

          this.modalOpen = false;
          await this.fetchDocuments();
        } catch (e) {
          console.error('Error saving document:', e);
          const msg = e?.response?.message || e?.message || 'Ошибка сохранения документа';
          this.emitToast(msg, 'error');
        } finally {
          this.saving = false;
        }
      },

      async deleteDocument(doc) {
        if (!doc || !doc.id) return;
        if (!confirm(`Вы действительно хотите удалить документ "${doc.title}"?`)) {
          return;
        }

        try {
          if (!this.pb) this.initPb();
          await this.pb.collection('documents').delete(doc.id);
          this.emitToast('Документ удален', 'success');
          await this.fetchDocuments();
        } catch (e) {
          console.error('Error deleting document:', e);
          this.emitToast('Ошибка при удалении документа', 'error');
        }
      },

      emitToast(message, type = 'success') {
        window.dispatchEvent(new CustomEvent('admin-toast', {
          detail: { message, type }
        }));
      }
    };
  };
</script>
