---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Toast from '../../../components/admin/ui/Toast.astro';
import { PB_URL } from '../../../lib/adminAuth';

export const prerender = false;
---

<AdminLayout title="Категории товаров | БелФлекс Админ" activeNav="categories">
  <div
    x-data={`categoriesManager('${PB_URL}')`}
    x-init="init()"
    class="space-y-6"
  >
    <Toast />

    <!-- Top Action Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-border">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight font-accent italic">Категории</h1>
          <span
            x-show="!loading"
            class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 font-mono"
            x-text="totalCategoriesCount + ' кат.'"
          ></span>
        </div>
        <p class="text-xs text-text-secondary mt-1">
          Древовидная структура категорий и подкатегорий каталога продукции.
        </p>
      </div>

      <a
        href="/manage/categories/new"
        class="inline-flex items-center justify-center gap-2 bg-[#EF1C24] hover:bg-[#d91920] active:scale-[0.99] text-white font-sans text-xs font-semibold py-2.5 px-4 rounded-[8px] transition-all shadow-xs flex-shrink-0 cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        Добавить категорию
      </a>
    </div>

    <!-- Filter & Search Bar -->
    <div class="bg-white p-4 rounded-[8px] border border-border shadow-xs flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
      <!-- Search -->
      <div class="relative flex-1 max-w-md">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          x-model="searchQuery"
          placeholder="Поиск по названию или slug..."
          class="w-full pl-9 pr-8 py-2 bg-[#F7FAFC] border border-border rounded-[8px] text-xs sm:text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary transition-all"
        />
        <button
          type="button"
          x-show="searchQuery.length > 0"
          @click="searchQuery = ''"
          class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 text-xs cursor-pointer"
        >
          ×
        </button>
      </div>

      <!-- Quick Actions -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          @click="loadData()"
          :disabled="loading"
          class="p-2 bg-[#F7FAFC] hover:bg-gray-100 border border-border rounded-[8px] text-gray-600 hover:text-gray-900 transition-colors cursor-pointer text-xs flex items-center gap-1.5 shadow-2xs"
          title="Обновить список"
        >
          <svg class="w-4 h-4" :class="{ 'animate-spin': loading }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span class="hidden sm:inline">Обновить</span>
        </button>
      </div>
    </div>

    <!-- Tree Categories Table -->
    <div class="bg-white border border-border rounded-[8px] shadow-xs overflow-hidden">
      <!-- Loading state -->
      <div x-show="loading" class="py-20 text-center text-primary font-medium text-sm flex items-center justify-center gap-2">
        <svg class="animate-spin h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Загрузка категорий...</span>
      </div>

      <!-- Categories List Table -->
      <div x-show="!loading" class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs sm:text-sm font-sans">
          <thead>
            <tr class="bg-[#F7FAFC] border-b border-border text-gray-500 font-semibold text-[11px] uppercase tracking-wider">
              <th scope="col" class="py-3 px-4 min-w-[280px]">Категория</th>
              <th scope="col" class="py-3 px-3 text-center w-28">Товаров</th>
              <th scope="col" class="py-3 px-3 text-center w-28">Порядок</th>
              <th scope="col" class="py-3 px-3 text-center w-28">Статус</th>
              <th scope="col" class="py-3 px-4 text-right w-36 pr-5">Действия</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <template x-for="item in filteredTreeList" :key="item.id">
              <tr
                class="hover:bg-[#F7FAFC] transition-colors"
                :class="{
                  'bg-white': item.level === 0,
                  'bg-gray-50/50': item.level > 0
                }"
              >
                <!-- Category Name & Image with Tree Indentation -->
                <td class="py-3 px-4">
                  <div
                    class="flex items-center gap-3"
                    :style="`padding-left: ${item.level * 28}px`"
                  >
                    <!-- Tree Branch Connector Icon (for subcategories) -->
                    <template x-if="item.level > 0">
                      <span class="text-gray-300 select-none flex-shrink-0 font-mono text-sm">└─</span>
                    </template>

                    <!-- Thumbnail Image (40x40) -->
                    <div class="w-10 h-10 rounded-[6px] bg-gray-100 border border-border overflow-hidden flex-shrink-0 flex items-center justify-center shadow-2xs">
                      <template x-if="item.image">
                        <img
                          :src="`${pbUrl}/api/files/categories/${item.id}/${item.image}?thumb=80x80`"
                          :alt="item.name"
                          class="w-full h-full object-cover"
                          loading="lazy"
                        />
                      </template>
                      <template x-if="!item.image">
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h7"/>
                        </svg>
                      </template>
                    </div>

                    <!-- Title, Slug & Subcategories count -->
                    <div class="min-w-0">
                      <div class="flex items-center gap-2">
                        <a
                          :href="'/manage/categories/' + item.id"
                          class="font-bold text-gray-900 hover:text-primary transition-colors truncate"
                          :class="item.level === 0 ? 'text-sm' : 'text-xs sm:text-sm text-gray-800'"
                          x-text="item.name"
                        ></a>
                        <template x-if="item.childrenCount > 0">
                          <span class="text-[10px] px-1.5 py-0.2 bg-blue-50 text-blue-700 border border-blue-200 rounded-full font-medium" x-text="item.childrenCount + ' подкат.'"></span>
                        </template>
                      </div>
                      <div class="text-[11px] font-mono text-text-secondary mt-0.5 truncate">
                        /<span x-text="item.parentSlug ? item.parentSlug + '/' : ''"></span><span x-text="item.slug"></span>
                      </div>
                    </div>
                  </div>
                </td>

                <!-- Products count -->
                <td class="py-3 px-3 text-center">
                  <span
                    class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold font-mono"
                    :class="(productCounts[item.id] || 0) > 0 ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-gray-100 text-gray-500'"
                    x-text="(productCounts[item.id] || 0) + ' шт.'"
                  ></span>
                </td>

                <!-- Sort Order with Quick Up/Down Controls -->
                <td class="py-3 px-3 text-center">
                  <div class="inline-flex items-center gap-1">
                    <button
                      type="button"
                      @click="moveCategory(item, -1)"
                      class="w-6 h-6 rounded hover:bg-gray-200 text-gray-500 hover:text-gray-800 flex items-center justify-center text-xs transition-colors cursor-pointer"
                      title="Переместить выше"
                    >
                      ▲
                    </button>
                    <span class="font-mono text-xs text-gray-700 w-6 text-center font-bold" x-text="item.sort_order || 0"></span>
                    <button
                      type="button"
                      @click="moveCategory(item, 1)"
                      class="w-6 h-6 rounded hover:bg-gray-200 text-gray-500 hover:text-gray-800 flex items-center justify-center text-xs transition-colors cursor-pointer"
                      title="Переместить ниже"
                    >
                      ▼
                    </button>
                  </div>
                </td>

                <!-- Active status toggle -->
                <td class="py-3 px-3 text-center">
                  <button
                    type="button"
                    @click="toggleActive(item)"
                    :class="item.is_active ? 'bg-green-500' : 'bg-gray-300'"
                    class="relative inline-flex h-5 w-9 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none"
                    role="switch"
                    :aria-checked="item.is_active"
                    :title="item.is_active ? 'Категория активна (нажмите чтобы скрыть)' : 'Категория скрыта (нажмите чтобы включить)'"
                  >
                    <span
                      :class="item.is_active ? 'translate-x-4' : 'translate-x-0'"
                      class="pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"
                    ></span>
                  </button>
                </td>

                <!-- Actions (Edit, View on site, Delete) -->
                <td class="py-3 px-4 text-right pr-5">
                  <div class="flex items-center justify-end gap-1.5">
                    <!-- Edit -->
                    <a
                      :href="'/manage/categories/' + item.id"
                      class="p-1.5 text-gray-500 hover:text-primary hover:bg-gray-100 rounded-[6px] transition-colors cursor-pointer"
                      title="Редактировать"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                    </a>

                    <!-- View on public site -->
                    <a
                      :href="item.publicUrl"
                      target="_blank"
                      class="p-1.5 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-[6px] transition-colors cursor-pointer"
                      title="Открыть на сайте"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>

                    <!-- Delete -->
                    <button
                      type="button"
                      @click="deleteCategory(item)"
                      class="p-1.5 text-gray-500 hover:text-[#EF1C24] hover:bg-red-50 rounded-[6px] transition-colors cursor-pointer"
                      title="Удалить категорию"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            </template>

            <!-- Empty Search State -->
            <tr x-show="filteredTreeList.length === 0">
              <td colspan="5" class="py-12 text-center text-gray-400 text-xs sm:text-sm">
                Категории не найдены.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<!-- Global Categories Manager Alpine Script -->
<script is:inline>
  window.categoriesManager = function(pbUrl) {
    return {
      pb: null,
      pbUrl: pbUrl || 'http://127.0.0.1:8090',
      loading: true,
      categories: [],
      productCounts: {},
      searchQuery: '',

      async init() {
        if (window.PocketBase) {
          this.pb = new window.PocketBase(this.pbUrl);
          this.pb.autoCancellation(false);
          this.pb.authStore.loadFromCookie(document.cookie);
        }
        await this.loadData();
      },

      async loadData() {
        this.loading = true;
        try {
          if (!this.pb && window.PocketBase) {
            this.pb = new window.PocketBase(this.pbUrl);
            this.pb.authStore.loadFromCookie(document.cookie);
          }
          if (!this.pb) return;

          // Fetch all categories
          const list = await this.pb.collection('categories').getFullList({
            sort: 'parent,sort_order,name',
            $autoCancel: false,
            requestKey: null
          });
          this.categories = list;

          // Fetch all active products to calculate accurate counts per category
          const prods = await this.pb.collection('products').getFullList({
            fields: 'id,category',
            $autoCancel: false,
            requestKey: null
          });

          const counts = {};
          prods.forEach(p => {
            if (p.category) {
              counts[p.category] = (counts[p.category] || 0) + 1;
            }
          });
          this.productCounts = counts;
        } catch (e) {
          console.error('Error loading categories:', e);
          this.showToast('Ошибка загрузки категорий: ' + (e?.message || ''), 'error');
        } finally {
          this.loading = false;
        }
      },

      get totalCategoriesCount() {
        return this.categories.length;
      },

      get treeList() {
        const roots = this.categories
          .filter(c => !c.parent)
          .sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0));

        const result = [];

        roots.forEach(root => {
          const children = this.categories
            .filter(c => c.parent === root.id)
            .sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0));

          result.push({
            ...root,
            level: 0,
            parentSlug: '',
            childrenCount: children.length,
            publicUrl: `/katalog/${root.slug}`
          });

          children.forEach(child => {
            result.push({
              ...child,
              level: 1,
              parentSlug: root.slug,
              childrenCount: 0,
              publicUrl: `/katalog/${root.slug}/${child.slug}`
            });
          });
        });

        // Add orphaned categories if any
        const allIncludedIds = new Set(result.map(r => r.id));
        this.categories.forEach(cat => {
          if (!allIncludedIds.has(cat.id)) {
            result.push({
              ...cat,
              level: 0,
              parentSlug: '',
              childrenCount: 0,
              publicUrl: `/katalog/${cat.slug}`
            });
          }
        });

        return result;
      },

      get filteredTreeList() {
        const q = this.searchQuery.trim().toLowerCase();
        if (!q) return this.treeList;

        return this.treeList.filter(item => {
          return item.name.toLowerCase().includes(q) || item.slug.toLowerCase().includes(q);
        });
      },

      async toggleActive(item) {
        const oldVal = item.is_active;
        item.is_active = !oldVal;

        try {
          if (!this.pb && window.PocketBase) this.pb = new window.PocketBase(this.pbUrl);
          await this.pb.collection('categories').update(item.id, {
            is_active: item.is_active
          });
          this.showToast(`Категория "${item.name}" ${item.is_active ? 'включена' : 'скрыта'}`, 'info');
        } catch (e) {
          console.error('Error toggling category status:', e);
          item.is_active = oldVal;
          this.showToast('Не удалось изменить статус', 'error');
        }
      },

      async moveCategory(item, delta) {
        // Find siblings with the exact same parent
        const siblings = this.categories
          .filter(c => (c.parent || '') === (item.parent || ''))
          .sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0));

        const currentIndex = siblings.findIndex(c => c.id === item.id);
        if (currentIndex === -1) return;

        const targetIndex = currentIndex + delta;
        if (targetIndex < 0 || targetIndex >= siblings.length) return;

        const targetItem = siblings[targetIndex];

        // Swap sort_order
        const currentOrder = item.sort_order || 0;
        let targetOrder = targetItem.sort_order || 0;

        if (currentOrder === targetOrder) {
          targetOrder = delta > 0 ? currentOrder + 1 : Math.max(0, currentOrder - 1);
        }

        try {
          if (!this.pb && window.PocketBase) this.pb = new window.PocketBase(this.pbUrl);
          await this.pb.collection('categories').update(item.id, { sort_order: targetOrder });
          await this.pb.collection('categories').update(targetItem.id, { sort_order: currentOrder });

          item.sort_order = targetOrder;
          targetItem.sort_order = currentOrder;

          await this.loadData();
          this.showToast('Порядок изменен', 'info');
        } catch (e) {
          console.error('Error reordering category:', e);
          this.showToast('Ошибка при изменении порядка', 'error');
        }
      },

      async deleteCategory(item) {
        // 1. Check for child subcategories
        const children = this.categories.filter(c => c.parent === item.id);
        if (children.length > 0) {
          alert(`Нельзя удалить категорию "${item.name}", так как в ней есть ${children.length} подкатегорий. Сначала удалите или переместите подкатегории.`);
          return;
        }

        // 2. Check for products in category
        const count = this.productCounts[item.id] || 0;
        if (count > 0) {
          if (!confirm(`В категории "${item.name}" находится ${count} товаров. При удалении категории товары останутся без категории. Продолжить удаление?`)) {
            return;
          }
        } else {
          if (!confirm(`Вы действительно хотите удалить категорию "${item.name}"?`)) {
            return;
          }
        }

        try {
          if (!this.pb && window.PocketBase) this.pb = new window.PocketBase(this.pbUrl);
          await this.pb.collection('categories').delete(item.id);
          this.showToast(`Категория "${item.name}" удалена`, 'success');
          await this.loadData();
        } catch (e) {
          console.error('Error deleting category:', e);
          this.showToast('Ошибка при удалении категории', 'error');
        }
      },

      showToast(message, type = 'success') {
        window.dispatchEvent(new CustomEvent('admin-toast', {
          detail: { message, type }
        }));
      }
    };
  };
</script>
