---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Toast from '../../components/admin/ui/Toast.astro';
import { PB_URL } from '../../lib/adminAuth';

export const prerender = false;
---

<AdminLayout title="Настройки сайта — Админка БелФлекс" activeNav="settings">
  <div
    x-data={`settingsManager('${PB_URL}')`}
    x-init="init()"
    class="space-y-6 max-w-5xl"
  >
    <Toast />

    <!-- Top Header & Save Button -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-border">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight font-accent italic">
          Настройки сайта
        </h1>
        <p class="text-xs text-text-secondary mt-1">
          Глобальные контактные данные, логотипы, ссылки на мессенджеры и коды интеграций.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <!-- Unsaved Changes Badge -->
        <template x-if="isDirty">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 border border-amber-200 text-amber-800 text-xs font-semibold animate-pulse shadow-2xs">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            <span>Несохранённые изменения</span>
          </span>
        </template>

        <button
          type="button"
          @click="saveSettings()"
          :disabled="saving"
          class="inline-flex items-center justify-center gap-2 bg-[#EF1C24] hover:bg-[#d91920] active:scale-[0.99] text-white font-sans text-xs font-semibold py-2.5 px-6 rounded-[8px] transition-all shadow-xs cursor-pointer disabled:opacity-50"
        >
          <template x-if="saving">
            <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </template>
          Сохранить настройки
        </button>
      </div>
    </div>

    <!-- Loading State -->
    <div x-show="loading" class="py-20 text-center text-primary font-medium text-sm flex items-center justify-center gap-2">
      <svg class="animate-spin h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span>Загрузка настроек...</span>
    </div>

    <!-- Settings Form Sections -->
    <form x-show="!loading" @submit.prevent="saveSettings()" class="space-y-6">
      <!-- SECTION 1: ОСНОВНОЕ -->
      <div class="bg-white rounded-[8px] p-6 border border-border shadow-xs">
        <h2 class="text-base font-bold text-gray-900 font-sans mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#EF1C24]"></span>
          Основная информация
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Название сайта -->
          <div class="md:col-span-2">
            <label class="block text-xs font-semibold text-[#3B3B3B] mb-1.5">
              Название сайта / Организации <span class="text-[#EF1C24]">*</span>
            </label>
            <input
              type="text"
              x-model="form.site_name"
              placeholder="например: ООО «БелФлекс»"
              required
              class="w-full bg-[#F7FAFC] border border-border focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary rounded-[8px] py-2.5 px-3 text-xs sm:text-sm text-gray-900 transition-all"
            />
          </div>

          <!-- Описание сайта -->
          <div class="md:col-span-2">
            <label class="block text-xs font-semibold text-[#3B3B3B] mb-1.5">
              Описание сайта (для мета-тегов по умолчанию)
            </label>
            <textarea
              rows="3"
              x-model="form.site_description"
              placeholder="Официальный поставщик промышленных рукавов, соединений и хомутов..."
              class="w-full bg-[#F7FAFC] border border-border focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary rounded-[8px] py-2 px-3 text-xs sm:text-sm text-gray-900 transition-all resize-y"
            ></textarea>
          </div>
        </div>
      </div>

      <!-- SECTION 2: КОНТАКТНЫЕ ДАННЫЕ -->
      <div class="bg-white rounded-[8px] p-6 border border-border shadow-xs">
        <h2 class="text-base font-bold text-gray-900 font-sans mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-blue-500"></span>
          Контакты и реквизиты
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Телефон 1 -->
          <div>
            <label class="block text-xs font-semibold text-[#3B3B3B] mb-1.5">
              Основной телефон (Телефон 1) <span class="text-[#EF1C24]">*</span>
            </label>
            <input
              type="text"
              x-model="form.phone_main"
              placeholder="+375 (44) 780-00-59"
              required
              class="w-full bg-[#F7FAFC] border border-border focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary rounded-[8px] py-2.5 px-3 text-xs sm:text-sm text-gray-900 font-mono transition-all"
            />
            <p class="text-[11px] text-gray-500 mt-1">Отображается в шапке сайта, подвале и контактах.</p>
          </div>

          <!-- Телефон 2 -->
          <div>
            <label class="block text-xs font-semibold text-[#3B3B3B] mb-1.5">
              Дополнительный телефон (Телефон 2)
            </label>
            <input
              type="text"
              x-model="form.phone_secondary"
              placeholder="+375 (17) 300-00-00"
              class="w-full bg-[#F7FAFC] border border-border focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary rounded-[8px] py-2.5 px-3 text-xs sm:text-sm text-gray-900 font-mono transition-all"
            />
          </div>

          <!-- Email -->
          <div>
            <label class="block text-xs font-semibold text-[#3B3B3B] mb-1.5">
              Email для заявок и писем
            </label>
            <input
              type="email"
              x-model="form.email"
              placeholder="zakaz@belfleks.by"
              class="w-full bg-[#F7FAFC] border border-border focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary rounded-[8px] py-2.5 px-3 text-xs sm:text-sm text-gray-900 transition-all"
            />
          </div>

          <!-- Адрес -->
          <div>
            <label class="block text-xs font-semibold text-[#3B3B3B] mb-1.5">
              Адрес офиса и склада
            </label>
            <input
              type="text"
              x-model="form.address"
              placeholder="г. Гродно, ул. Лидская 15"
              class="w-full bg-[#F7FAFC] border border-border focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary rounded-[8px] py-2.5 px-3 text-xs sm:text-sm text-gray-900 transition-all"
            />
          </div>

          <!-- Часы работы -->
          <div class="md:col-span-2">
            <label class="block text-xs font-semibold text-[#3B3B3B] mb-1.5">
              Режим работы
            </label>
            <textarea
              rows="2"
              x-model="form.working_hours"
              placeholder="Пн–Пт: 8:30 – 17:00&#10;Сб–Вс: выходной"
              class="w-full bg-[#F7FAFC] border border-border focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary rounded-[8px] py-2 px-3 text-xs sm:text-sm text-gray-900 transition-all resize-y"
            ></textarea>
          </div>
        </div>
      </div>

      <!-- SECTION 3: МЕССЕНДЖЕРЫ -->
      <div class="bg-white rounded-[8px] p-6 border border-border shadow-xs">
        <h2 class="text-base font-bold text-gray-900 font-sans mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#2AABEE]"></span>
          Мессенджеры и социальные сети
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Telegram -->
          <div>
            <label class="block text-xs font-semibold text-[#3B3B3B] mb-1.5 flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#2AABEE]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
              </svg>
              Ссылка на Telegram
            </label>
            <input
              type="text"
              x-model="form.telegram_link"
              placeholder="https://t.me/belfleks"
              class="w-full bg-[#F7FAFC] border border-border focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary rounded-[8px] py-2.5 px-3 text-xs sm:text-sm text-gray-900 transition-all font-mono"
            />
          </div>

          <!-- Viber -->
          <div>
            <label class="block text-xs font-semibold text-[#3B3B3B] mb-1.5 flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#7360f2]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M11.4.002C5.161.082.762 4.57.563 10.8c-.08 2.6.557 5.041 1.882 7.122L.563 24l6.24-1.883c1.961 1.122 4.16 1.722 6.44 1.722h.04c6.281 0 10.717-4.558 10.717-10.8C24 6.762 18.318.04 11.4.002zm.04 19.839h-.04c-2.078 0-4.12-.558-5.879-1.641l-.4-.241-4.159 1.239 1.24-4.039-.28-.4c-1.199-1.72-1.8-3.8-1.8-5.919C.122 3.84 5.282.64 11.44.641c6.281.041 10.761 4.881 10.719 10.96-.001 5.919-4.6 10.24-10.72 10.24z"/>
              </svg>
              Ссылка на Viber
            </label>
            <input
              type="text"
              x-model="form.viber_link"
              placeholder="viber://chat?number=%2B375447800059"
              class="w-full bg-[#F7FAFC] border border-border focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary rounded-[8px] py-2.5 px-3 text-xs sm:text-sm text-gray-900 transition-all font-mono"
            />
          </div>
        </div>
      </div>

      <!-- SECTION 4: ЛОГОТИПЫ И ИКОНКИ -->
      <div class="bg-white rounded-[8px] p-6 border border-border shadow-xs">
        <h2 class="text-base font-bold text-gray-900 font-sans mb-1 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-purple-500"></span>
          Логотипы и Favicon
        </h2>
        <p class="text-xs text-text-secondary mb-5">
          Загрузите официальные логотипы компании для шапки, мобильного меню и вкладки браузера.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- 1. Основной логотип (Прямоугольный) -->
          <div class="p-4 border border-border rounded-[8px] bg-[#F7FAFC] space-y-3">
            <span class="block text-xs font-bold text-gray-900">Основной логотип (шапка)</span>
            
            <div class="h-20 bg-white border border-border rounded-[6px] flex items-center justify-center p-2 relative overflow-hidden group shadow-2xs">
              <template x-if="previews.logo_full">
                <img :src="previews.logo_full" alt="Full logo" class="max-h-full max-w-full object-contain" />
              </template>
              <template x-if="!previews.logo_full">
                <span class="text-[11px] text-gray-400">Логотип не выбран</span>
              </template>
              <template x-if="previews.logo_full">
                <button
                  type="button"
                  @click="removeFile('logo_full')"
                  class="absolute top-1 right-1 w-5 h-5 rounded-full bg-black/70 hover:bg-[#EF1C24] text-white flex items-center justify-center text-xs transition-colors cursor-pointer"
                  title="Удалить"
                >
                  ×
                </button>
              </template>
            </div>

            <button
              type="button"
              @click="$refs.logoFullInput.click()"
              class="w-full py-1.5 px-3 rounded-[6px] bg-white border border-border hover:border-primary text-gray-700 hover:text-primary text-xs font-semibold transition-colors cursor-pointer text-center"
            >
              Выбрать файл
            </button>
            <input
              type="file"
              x-ref="logoFullInput"
              @change="handleFileChange($event, 'logo_full')"
              accept="image/svg+xml,image/png,image/webp,image/jpeg"
              class="hidden"
            />
            <p class="text-[10px] text-gray-400 text-center">SVG или PNG (горизонтальный)</p>
          </div>

          <!-- 2. Квадратный логотип -->
          <div class="p-4 border border-border rounded-[8px] bg-[#F7FAFC] space-y-3">
            <span class="block text-xs font-bold text-gray-900">Квадратный логотип (иконка)</span>
            
            <div class="h-20 bg-white border border-border rounded-[6px] flex items-center justify-center p-2 relative overflow-hidden group shadow-2xs">
              <template x-if="previews.logo_square">
                <img :src="previews.logo_square" alt="Square logo" class="h-16 w-16 object-contain" />
              </template>
              <template x-if="!previews.logo_square">
                <span class="text-[11px] text-gray-400">Иконка не выбрана</span>
              </template>
              <template x-if="previews.logo_square">
                <button
                  type="button"
                  @click="removeFile('logo_square')"
                  class="absolute top-1 right-1 w-5 h-5 rounded-full bg-black/70 hover:bg-[#EF1C24] text-white flex items-center justify-center text-xs transition-colors cursor-pointer"
                  title="Удалить"
                >
                  ×
                </button>
              </template>
            </div>

            <button
              type="button"
              @click="$refs.logoSquareInput.click()"
              class="w-full py-1.5 px-3 rounded-[6px] bg-white border border-border hover:border-primary text-gray-700 hover:text-primary text-xs font-semibold transition-colors cursor-pointer text-center"
            >
              Выбрать файл
            </button>
            <input
              type="file"
              x-ref="logoSquareInput"
              @change="handleFileChange($event, 'logo_square')"
              accept="image/svg+xml,image/png,image/webp,image/jpeg"
              class="hidden"
            />
            <p class="text-[10px] text-gray-400 text-center">SVG или PNG 1:1</p>
          </div>

          <!-- 3. Favicon -->
          <div class="p-4 border border-border rounded-[8px] bg-[#F7FAFC] space-y-3">
            <span class="block text-xs font-bold text-gray-900">Favicon (иконка вкладки)</span>
            
            <div class="h-20 bg-white border border-border rounded-[6px] flex items-center justify-center p-2 relative overflow-hidden group shadow-2xs">
              <template x-if="previews.favicon">
                <img :src="previews.favicon" alt="Favicon" class="h-8 w-8 object-contain" />
              </template>
              <template x-if="!previews.favicon">
                <span class="text-[11px] text-gray-400">Favicon не выбран</span>
              </template>
              <template x-if="previews.favicon">
                <button
                  type="button"
                  @click="removeFile('favicon')"
                  class="absolute top-1 right-1 w-5 h-5 rounded-full bg-black/70 hover:bg-[#EF1C24] text-white flex items-center justify-center text-xs transition-colors cursor-pointer"
                  title="Удалить"
                >
                  ×
                </button>
              </template>
            </div>

            <button
              type="button"
              @click="$refs.faviconInput.click()"
              class="w-full py-1.5 px-3 rounded-[6px] bg-white border border-border hover:border-primary text-gray-700 hover:text-primary text-xs font-semibold transition-colors cursor-pointer text-center"
            >
              Выбрать файл
            </button>
            <input
              type="file"
              x-ref="faviconInput"
              @change="handleFileChange($event, 'favicon')"
              accept="image/x-icon,image/svg+xml,image/png"
              class="hidden"
            />
            <p class="text-[10px] text-gray-400 text-center">SVG, ICO или PNG 32x32</p>
          </div>
        </div>
      </div>

      <!-- SECTION 5: ИНТЕГРАЦИИ И СЧЕТЧИКИ -->
      <div class="bg-white rounded-[8px] p-6 border border-border shadow-xs">
        <h2 class="text-base font-bold text-gray-900 font-sans mb-1 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          Интеграции и скрипты
        </h2>
        <p class="text-xs text-text-secondary mb-5">
          Встраивание онлайн-консультантов, виджетов CRM и счетчиков посещаемости.
        </p>

        <div class="space-y-5">
          <!-- CRM Embed Code -->
          <div>
            <label class="block text-xs font-semibold text-[#3B3B3B] mb-1.5">
              Код CRM виджета / Онлайн-чата (HTML / JS)
            </label>
            <textarea
              rows="4"
              x-model="form.crm_embed_code"
              placeholder="<!-- Вставьте код скрипта CRM виджета -->"
              class="w-full bg-[#1E1E1E] text-green-400 font-mono text-xs border border-gray-700 focus:border-primary rounded-[8px] p-3 leading-relaxed min-h-[100px] resize-y"
            ></textarea>
            <p class="text-[11px] text-gray-500 mt-1">Скрипт подключается автоматически перед закрывающим тегом body.</p>
          </div>

          <!-- Analytics Code -->
          <div>
            <label class="block text-xs font-semibold text-[#3B3B3B] mb-1.5">
              Код счетчиков аналитики (Яндекс.Метрика / Google Analytics)
            </label>
            <textarea
              rows="4"
              x-model="form.analytics_code"
              placeholder="<!-- Вставьте код счетчика Яндекс Метрики или Google Tag -->"
              class="w-full bg-[#1E1E1E] text-green-400 font-mono text-xs border border-gray-700 focus:border-primary rounded-[8px] p-3 leading-relaxed min-h-[100px] resize-y"
            ></textarea>
            <p class="text-[11px] text-gray-500 mt-1">Скрипты аналитики подключаются в секции head сайта.</p>
          </div>
        </div>
      </div>

      <!-- Submit Footer -->
      <div class="flex items-center justify-end gap-3 pt-4">
        <button
          type="submit"
          :disabled="saving"
          class="py-3 px-8 rounded-[8px] bg-[#EF1C24] hover:bg-[#d91920] active:scale-[0.99] text-white font-sans text-xs font-semibold transition-all shadow-xs cursor-pointer disabled:opacity-50 flex items-center gap-2"
        >
          <template x-if="saving">
            <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </template>
          Сохранить все настройки
        </button>
      </div>
    </form>
  </div>
</AdminLayout>

<!-- Global Settings Manager Alpine Script -->
<script is:inline>
  window.settingsManager = function(pbUrl) {
    return {
      pb: null,
      pbUrl: pbUrl || 'http://127.0.0.1:8090',
      loading: true,
      saving: false,
      settingsId: '',

      form: {
        site_name: 'ООО БелФлекс',
        site_description: '',
        phone_main: '+375 (44) 780-00-59',
        phone_secondary: '',
        email: 'zakaz@belfleks.by',
        address: 'г. Гродно, ул. Лидская 15',
        working_hours: 'Пн–Пт: 8:30 – 17:00\nСб–Вс: выходной',
        telegram_link: '',
        viber_link: '',
        crm_embed_code: '',
        analytics_code: '',
      },

      files: {
        logo_full: null,
        logo_square: null,
        favicon: null,
      },

      previews: {
        logo_full: '',
        logo_square: '',
        favicon: '',
      },

      deleteFlags: {
        logo_full: false,
        logo_square: false,
        favicon: false,
      },

      getEffectivePbUrl() {
        if (typeof window !== 'undefined') {
          if (window.location.hostname === 'localhost' && this.pbUrl.includes('127.0.0.1')) {
            return this.pbUrl.replace('127.0.0.1', 'localhost');
          }
          if (window.location.hostname === '127.0.0.1' && this.pbUrl.includes('localhost')) {
            return this.pbUrl.replace('localhost', '127.0.0.1');
          }
        }
        return this.pbUrl || 'http://127.0.0.1:8090';
      },

      // Dirty state tracking
      isDirty: false,
      initialDataHash: '',

      calculateHash() {
        return JSON.stringify({
          form: this.form,
          hasFullLogo: Boolean(this.files.logo_full),
          hasSquareLogo: Boolean(this.files.logo_square),
          hasFavicon: Boolean(this.files.favicon),
          deleteFlags: this.deleteFlags
        });
      },

      takeSnapshot() {
        this.initialDataHash = this.calculateHash();
        this.isDirty = false;
      },

      checkDirty() {
        if (!this.initialDataHash) return;
        this.isDirty = this.calculateHash() !== this.initialDataHash;
      },

      async init() {
        for (let i = 0; i < 20; i++) {
          if (window.PocketBase) break;
          await new Promise(r => setTimeout(r, 50));
        }

        this.initPb();
        await this.loadSettings();

        this.$nextTick(() => {
          this.takeSnapshot();
        });

        this.$watch('form', () => this.checkDirty());

        window.addEventListener('beforeunload', (e) => {
          if (this.isDirty) {
            e.preventDefault();
            e.returnValue = '';
          }
        });

        window.addEventListener('admin-save-form', () => {
          if (!this.saving) this.saveSettings();
        });
      },

      initPb() {
        if (window.PocketBase) {
          const url = this.getEffectivePbUrl();
          this.pb = new window.PocketBase(url);
          this.pb.autoCancellation(false);
          this.pb.authStore.loadFromCookie(document.cookie);
        }
      },

      async loadSettings() {
        this.loading = true;
        try {
          if (!this.pb) this.initPb();
          if (!this.pb) throw new Error('Библиотека PocketBase не загружена');

          const records = await this.pb.collection('site_settings').getFullList({
            $autoCancel: false,
            requestKey: null
          });

          if (records.length > 0) {
            const s = records[0];
            this.settingsId = s.id;
            this.form.site_name = s.site_name || '';
            this.form.site_description = s.site_description || '';
            this.form.phone_main = s.phone_main || '';
            this.form.phone_secondary = s.phone_secondary || '';
            this.form.email = s.email || '';
            this.form.address = s.address || '';
            this.form.working_hours = s.working_hours || '';
            this.form.telegram_link = s.telegram_link || '';
            this.form.viber_link = s.viber_link || '';
            this.form.crm_embed_code = s.crm_embed_code || '';
            this.form.analytics_code = s.analytics_code || '';

            const effectiveUrl = this.getEffectivePbUrl();
            if (s.logo_full) {
              this.previews.logo_full = `${effectiveUrl}/api/files/site_settings/${s.id}/${s.logo_full}`;
            }
            if (s.logo_square) {
              this.previews.logo_square = `${effectiveUrl}/api/files/site_settings/${s.id}/${s.logo_square}`;
            }
            if (s.favicon) {
              this.previews.favicon = `${effectiveUrl}/api/files/site_settings/${s.id}/${s.favicon}`;
            }
          }
        } catch (e) {
          console.error('Error loading site settings:', e);
          this.emitToast('Ошибка загрузки настроек: ' + (e?.message || ''), 'error');
        } finally {
          this.loading = false;
        }
      },

      handleFileChange(e, type) {
        const file = e.target.files?.[0];
        if (!file) return;

        this.files[type] = file;
        this.deleteFlags[type] = false;
        this.previews[type] = URL.createObjectURL(file);
        this.emitToast('Файл выбран', 'info');
      },

      removeFile(type) {
        this.files[type] = null;
        this.previews[type] = '';
        this.deleteFlags[type] = true;
      },

      async saveSettings() {
        if (!this.form.site_name.trim()) {
          this.emitToast('Название сайта обязательно для заполнения', 'error');
          return;
        }
        if (!this.form.phone_main.trim()) {
          this.emitToast('Основной телефон обязателен для заполнения', 'error');
          return;
        }

        this.saving = true;
        try {
          if (!this.pb) this.initPb();

          const formData = new FormData();
          formData.append('site_name', this.form.site_name.trim());
          formData.append('site_description', this.form.site_description.trim());
          formData.append('phone_main', this.form.phone_main.trim());
          formData.append('phone_secondary', this.form.phone_secondary.trim());
          formData.append('email', this.form.email.trim());
          formData.append('address', this.form.address.trim());
          formData.append('working_hours', this.form.working_hours.trim());
          formData.append('telegram_link', this.form.telegram_link.trim());
          formData.append('viber_link', this.form.viber_link.trim());
          formData.append('crm_embed_code', this.form.crm_embed_code.trim());
          formData.append('analytics_code', this.form.analytics_code.trim());

          // Handle logo uploads / deletions
          if (this.files.logo_full) {
            formData.append('logo_full', this.files.logo_full);
          } else if (this.deleteFlags.logo_full) {
            formData.append('logo_full', '');
          }

          if (this.files.logo_square) {
            formData.append('logo_square', this.files.logo_square);
          } else if (this.deleteFlags.logo_square) {
            formData.append('logo_square', '');
          }

          if (this.files.favicon) {
            formData.append('favicon', this.files.favicon);
          } else if (this.deleteFlags.favicon) {
            formData.append('favicon', '');
          }

          let updated;
          if (this.settingsId) {
            updated = await this.pb.collection('site_settings').update(this.settingsId, formData);
          } else {
            updated = await this.pb.collection('site_settings').create(formData);
            this.settingsId = updated.id;
          }

          this.isDirty = false;
          this.emitToast('Настройки успешно сохранены', 'success');
          await this.loadSettings();
          this.takeSnapshot();
        } catch (e) {
          console.error('Error saving settings:', e);
          const msg = e?.response?.message || e?.message || 'Ошибка сохранения настроек';
          this.emitToast(msg, 'error');
        } finally {
          this.saving = false;
        }
      },

      emitToast(message, type = 'success') {
        window.dispatchEvent(new CustomEvent('admin-toast', {
          detail: { message, type }
        }));
      }
    };
  };
</script>
