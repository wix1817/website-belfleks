---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Toast from '../../../components/admin/ui/Toast.astro';
import { PB_URL } from '../../../lib/adminAuth';

export const prerender = false;
---

<AdminLayout title="Страницы — Админка БелФлекс" activeNav="pages">
  <div
    x-data={`pagesManager('${PB_URL}')`}
    x-init="init()"
    class="space-y-6"
  >
    <Toast />

    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-border">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight font-accent italic">Страницы сайта</h1>
          <span
            x-show="!loading"
            class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 font-mono"
            x-text="pages.length + ' стр.'"
          ></span>
        </div>
        <p class="text-xs text-text-secondary mt-1">
          Управление контентом, SEO и заголовками основных страниц сайта.
        </p>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-2">
        <template x-if="missingDefaultPagesCount > 0">
          <button
            type="button"
            @click="createDefaultPages()"
            :disabled="creatingDefaults"
            class="inline-flex items-center gap-1.5 bg-white border border-border hover:border-primary text-gray-700 hover:text-primary font-sans text-xs font-semibold py-2.5 px-4 rounded-[8px] transition-colors shadow-2xs cursor-pointer"
          >
            <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Создать недостающие страницы
          </button>
        </template>
      </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="bg-white p-4 rounded-[8px] border border-border shadow-xs flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
      <!-- Search Input -->
      <div class="relative flex-1 max-w-md">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          x-model="searchQuery"
          placeholder="Поиск по названию страницы..."
          class="w-full pl-9 pr-8 py-2 bg-[#F7FAFC] border border-border rounded-[8px] text-xs sm:text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:border-primary focus:bg-white focus:ring-1 focus:ring-primary transition-all"
        />
        <button
          type="button"
          x-show="searchQuery.length > 0"
          @click="searchQuery = ''"
          class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 text-xs cursor-pointer"
        >
          ×
        </button>
      </div>

      <!-- Refresh -->
      <div>
        <button
          type="button"
          @click="loadPages()"
          :disabled="loading"
          class="p-2 bg-[#F7FAFC] hover:bg-gray-100 border border-border rounded-[8px] text-gray-600 hover:text-gray-900 transition-colors cursor-pointer text-xs flex items-center gap-1.5 shadow-2xs"
          title="Обновить список"
        >
          <svg class="w-4 h-4" :class="{ 'animate-spin': loading }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span class="hidden sm:inline">Обновить</span>
        </button>
      </div>
    </div>

    <!-- Pages Table -->
    <div class="bg-white border border-border rounded-[8px] shadow-xs overflow-hidden">
      <!-- Loading State -->
      <div x-show="loading" class="py-20 text-center text-primary font-medium text-sm flex items-center justify-center gap-2">
        <svg class="animate-spin h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Загрузка страниц...</span>
      </div>

      <!-- Table Content -->
      <div x-show="!loading" class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs sm:text-sm font-sans">
          <thead>
            <tr class="bg-[#F7FAFC] border-b border-border text-gray-500 font-semibold text-[11px] uppercase tracking-wider">
              <th scope="col" class="py-3 px-4 min-w-[240px]">Страница</th>
              <th scope="col" class="py-3 px-4 min-w-[160px]">URL адрес</th>
              <th scope="col" class="py-3 px-4 text-center w-28">Статус</th>
              <th scope="col" class="py-3 px-4 text-right w-36 pr-5">Действия</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <template x-for="p in filteredPages" :key="p.id">
              <tr class="hover:bg-[#F7FAFC] transition-colors">
                <!-- Page Title -->
                <td class="py-3.5 px-4">
                  <div class="flex items-center gap-3">
                    <!-- Page Icon -->
                    <div class="w-9 h-9 rounded-[6px] bg-red-50 border border-red-100 flex items-center justify-center text-primary flex-shrink-0">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                      </svg>
                    </div>
                    <div>
                      <a
                        :href="'/manage/pages/' + p.id"
                        class="font-bold text-gray-900 hover:text-primary transition-colors text-sm block"
                        x-text="p.title || p.name"
                      ></a>
                      <span class="text-[11px] text-text-secondary line-clamp-1" x-text="p.hero_title || p.meta_title || 'Статическая страница'"></span>
                    </div>
                  </div>
                </td>

                <!-- Slug / Public URL -->
                <td class="py-3.5 px-4 font-mono text-xs text-gray-600">
                  <span class="px-2 py-0.5 rounded bg-gray-100 text-gray-700" x-text="getPageUrl(p)"></span>
                </td>

                <!-- Active Toggle -->
                <td class="py-3.5 px-4 text-center">
                  <button
                    type="button"
                    @click="toggleActive(p)"
                    :class="p.is_active ? 'bg-green-500' : 'bg-gray-300'"
                    class="relative inline-flex h-5 w-9 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none"
                    role="switch"
                    :aria-checked="p.is_active"
                    :title="p.is_active ? 'Страница активна' : 'Страница скрыта'"
                  >
                    <span
                      :class="p.is_active ? 'translate-x-4' : 'translate-x-0'"
                      class="pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"
                    ></span>
                  </button>
                </td>

                <!-- Actions -->
                <td class="py-3.5 px-4 text-right pr-5">
                  <div class="flex items-center justify-end gap-1.5">
                    <!-- Edit -->
                    <a
                      :href="'/manage/pages/' + p.id"
                      class="p-1.5 text-gray-500 hover:text-primary hover:bg-gray-100 rounded-[6px] transition-colors cursor-pointer"
                      title="Редактировать"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                    </a>

                    <!-- View on public site -->
                    <a
                      :href="getPageUrl(p)"
                      target="_blank"
                      class="p-1.5 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-[6px] transition-colors cursor-pointer"
                      title="Открыть на сайте"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  </div>
                </td>
              </tr>
            </template>

            <tr x-show="filteredPages.length === 0">
              <td colspan="4" class="py-12 text-center text-gray-400 text-xs sm:text-sm">
                Страницы не найдены.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<!-- Global Pages Manager Alpine Script -->
<script is:inline>
  window.pagesManager = function(pbUrl) {
    return {
      pb: null,
      pbUrl: pbUrl || 'http://127.0.0.1:8090',
      loading: true,
      creatingDefaults: false,
      pages: [],
      searchQuery: '',

      standardPages: [
        { slug: 'home', title: 'Главная', hero_title: 'Промышленные рукава и соединения', hero_subtitle: 'Официальные поставки со склада в Гродно по всей Беларуси' },
        { slug: 'o-kompanii', title: 'О компании', hero_title: 'О компании ООО «БелФлекс»', hero_subtitle: 'Надежный поставщик гибких трубопроводов и промышленных рукавов' },
        { slug: 'kontakty', title: 'Контакты', hero_title: 'Контакты', hero_subtitle: 'Свяжитесь с нашими специалистами для консультации и подбора' },
        { slug: 'politika', title: 'Политика конфиденциальности', hero_title: 'Политика конфиденциальности', hero_subtitle: 'Положение об обработке и защите персональных данных' },
      ],

      async init() {
        if (window.PocketBase) {
          this.pb = new window.PocketBase(this.pbUrl);
          this.pb.autoCancellation(false);
          this.pb.authStore.loadFromCookie(document.cookie);
        }
        await this.loadPages();
      },

      async loadPages() {
        this.loading = true;
        try {
          if (!this.pb && window.PocketBase) {
            this.pb = new window.PocketBase(this.pbUrl);
            this.pb.authStore.loadFromCookie(document.cookie);
          }
          if (!this.pb) return;

          const list = await this.pb.collection('pages').getFullList({
            sort: 'title',
            $autoCancel: false,
            requestKey: null
          });
          this.pages = list;
        } catch (e) {
          console.error('Error loading pages:', e);
          this.showToast('Ошибка загрузки страниц: ' + (e?.message || ''), 'error');
        } finally {
          this.loading = false;
        }
      },

      getPageUrl(page) {
        if (!page || !page.slug || page.slug === 'home') return '/';
        return `/${page.slug}`;
      },

      get missingDefaultPagesCount() {
        const existingSlugs = new Set(this.pages.map(p => p.slug));
        return this.standardPages.filter(p => !existingSlugs.has(p.slug)).length;
      },

      get filteredPages() {
        const q = this.searchQuery.trim().toLowerCase();
        if (!q) return this.pages;

        return this.pages.filter(p => {
          const title = (p.title || p.name || '').toLowerCase();
          const slug = (p.slug || '').toLowerCase();
          return title.includes(q) || slug.includes(q);
        });
      },

      async toggleActive(page) {
        const oldVal = page.is_active;
        page.is_active = !oldVal;

        try {
          if (!this.pb && window.PocketBase) this.pb = new window.PocketBase(this.pbUrl);
          await this.pb.collection('pages').update(page.id, {
            is_active: page.is_active
          });
          this.showToast(`Страница "${page.title}" ${page.is_active ? 'включена' : 'скрыта'}`, 'info');
        } catch (e) {
          console.error('Error toggling page status:', e);
          page.is_active = oldVal;
          this.showToast('Не удалось изменить статус', 'error');
        }
      },

      async createDefaultPages() {
        this.creatingDefaults = true;
        try {
          if (!this.pb && window.PocketBase) this.pb = new window.PocketBase(this.pbUrl);
          const existingSlugs = new Set(this.pages.map(p => p.slug));

          for (const def of this.standardPages) {
            if (!existingSlugs.has(def.slug)) {
              await this.pb.collection('pages').create({
                ...def,
                is_active: true
              });
            }
          }

          this.showToast('Недостающие страницы успешно созданы', 'success');
          await this.loadPages();
        } catch (e) {
          console.error('Error creating default pages:', e);
          this.showToast('Ошибка при создании страниц', 'error');
        } finally {
          this.creatingDefaults = false;
        }
      },

      showToast(message, type = 'success') {
        window.dispatchEvent(new CustomEvent('admin-toast', {
          detail: { message, type }
        }));
      }
    };
  };
</script>
