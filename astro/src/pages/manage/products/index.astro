---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { PB_URL } from '../../../lib/adminAuth';
---

<AdminLayout title="Товары | БелФлекс" activeNav="products">
  <div
    x-data={`productsManager('${PB_URL}')`}
    x-init="init()"
    class="space-y-6"
  >
    <!-- Header with Title and Add Button -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight font-accent italic">
            Товары
          </h1>
          <span
            x-show="!loading"
            x-cloak
            x-text="totalItems + ' шт.'"
            class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-gray-200 text-gray-700 font-sans"
          ></span>
        </div>
        <p class="text-sm text-text-secondary mt-1 font-sans">
          Управление номенклатурой, категориями и публикацией товаров в каталоге.
        </p>
      </div>

      <a
        href="/manage/products/new"
        class="inline-flex items-center justify-center gap-2 bg-[#EF1C24] hover:bg-[#d91920] active:scale-[0.99] text-white font-sans text-xs font-semibold py-2.5 px-4 rounded-[8px] transition-all shadow-xs flex-shrink-0 cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        + Добавить товар
      </a>
    </div>

    <!-- Filters & Search Bar -->
    <div class="bg-white p-4 rounded-[8px] border border-border shadow-xs flex flex-col md:flex-row items-stretch md:items-center gap-3">
      <!-- Search Input with Debounce -->
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          x-model.debounce.300ms="search"
          placeholder="Поиск по названию..."
          class="w-full bg-[#F7FAFC] border border-border rounded-[8px] py-2 pl-9 pr-8 text-xs sm:text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:border-primary focus:bg-white transition-colors"
        />
        <button
          type="button"
          x-show="search"
          x-cloak
          @click="search = ''; onFilterChange()"
          class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-gray-400 hover:text-gray-600 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Categories Filter -->
      <div class="w-full md:w-64">
        <select
          x-model="categoryFilter"
          @change="onFilterChange()"
          class="w-full bg-[#F7FAFC] border border-border rounded-[8px] py-2 px-3 text-xs sm:text-sm text-gray-900 focus:outline-none focus:border-primary focus:bg-white transition-colors cursor-pointer"
        >
          <option value="">Все категории</option>
          <template x-for="cat in categories" :key="cat.id">
            <option :value="cat.id" x-text="(cat.parent ? '— ' : '') + cat.name"></option>
          </template>
        </select>
      </div>

      <!-- Status Filter -->
      <div class="w-full md:w-44">
        <select
          x-model="statusFilter"
          @change="onFilterChange()"
          class="w-full bg-[#F7FAFC] border border-border rounded-[8px] py-2 px-3 text-xs sm:text-sm text-gray-900 focus:outline-none focus:border-primary focus:bg-white transition-colors cursor-pointer"
        >
          <option value="all">Все статусы</option>
          <option value="active">Активные</option>
          <option value="inactive">Неактивные</option>
        </select>
      </div>

      <!-- Reset button if filtered -->
      <button
        type="button"
        x-show="search || categoryFilter || statusFilter !== 'all'"
        x-cloak
        @click="resetFilters()"
        class="text-xs text-gray-500 hover:text-primary transition-colors py-2 px-3 whitespace-nowrap cursor-pointer"
      >
        Сбросить
      </button>
    </div>

    <!-- Main Table Container -->
    <div class="bg-white rounded-[8px] border border-border shadow-xs overflow-hidden relative">
      <!-- Loading Overlay -->
      <div
        x-show="loading"
        x-cloak
        class="absolute inset-0 bg-white/70 backdrop-blur-2xs z-20 flex items-center justify-center min-h-[300px]"
      >
        <div class="flex items-center gap-2.5 text-primary text-sm font-semibold">
          <svg class="animate-spin h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Загрузка товаров...</span>
        </div>
      </div>

      <!-- Responsive Table with Horizontal Scroll -->
      <div class="overflow-x-auto min-h-[320px]">
        <table class="w-full text-left text-sm font-sans">
          <!-- Sticky Header -->
          <thead class="sticky top-0 bg-[#F7FAFC] text-[#515151] uppercase text-xs font-semibold border-b border-border z-10">
            <tr>
              <th scope="col" class="px-4 py-3.5 w-16 text-center">Превью</th>
              <th scope="col" class="px-4 py-3.5">Название</th>
              <th scope="col" class="px-4 py-3.5">Категория</th>
              <th scope="col" class="px-4 py-3.5 text-center w-28">Активен</th>
              <th scope="col" class="px-4 py-3.5 text-center w-24">Порядок</th>
              <th scope="col" class="px-4 py-3.5 text-right w-36">Действия</th>
            </tr>
          </thead>

          <!-- Table Body with Zebra Striping and Hover -->
          <tbody class="divide-y divide-border">
            <template x-for="(prod, index) in products" :key="prod.id">
              <tr class="odd:bg-[#F7FAFC] even:bg-white hover:bg-[#EDF2F7] transition-colors">
                <!-- Thumbnail -->
                <td class="px-4 py-3 text-center">
                  <div class="w-10 h-10 rounded-[6px] bg-gray-100 border border-border overflow-hidden mx-auto flex items-center justify-center flex-shrink-0">
                    <template x-if="prod.images && prod.images.length > 0">
                      <img
                        :src="getImageUrl(prod)"
                        :alt="prod.name"
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                    </template>
                    <template x-if="!prod.images || prod.images.length === 0">
                      <svg class="w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </template>
                  </div>
                </td>

                <!-- Name & Slug -->
                <td class="px-4 py-3">
                  <a
                    :href="'/manage/products/' + prod.id"
                    class="font-semibold text-gray-900 hover:text-primary transition-colors block text-sm leading-snug"
                    x-text="prod.name"
                  ></a>
                  <div class="text-[11px] text-gray-400 font-mono mt-0.5" x-text="prod.slug || prod.id"></div>
                </td>

                <!-- Category Badge -->
                <td class="px-4 py-3">
                  <span
                    class="inline-block text-xs font-medium px-2.5 py-1 rounded-[6px] bg-gray-100 text-gray-700 max-w-[200px] truncate"
                    x-text="prod.expand?.category?.name || 'Без категории'"
                  ></span>
                </td>

                <!-- Active Toggle Switch -->
                <td class="px-4 py-3 text-center">
                  <button
                    type="button"
                    @click.stop="toggleActive(prod)"
                    :class="prod.is_active ? 'bg-green-500' : 'bg-gray-300'"
                    class="relative inline-flex h-5 w-10 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none"
                    role="switch"
                    :aria-checked="prod.is_active"
                    title="Нажмите для переключения статуса"
                  >
                    <span
                      :class="prod.is_active ? 'translate-x-5' : 'translate-x-0'"
                      class="pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"
                    ></span>
                  </button>
                </td>

                <!-- Sort Order -->
                <td class="px-4 py-3 text-center text-xs font-mono text-gray-600">
                  <span x-text="prod.sort_order || 0"></span>
                </td>

                <!-- Action Buttons (Edit, View on Site, Delete) -->
                <td class="px-4 py-3 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <!-- Edit Action -->
                    <a
                      :href="'/manage/products/' + prod.id"
                      class="p-1.5 text-gray-500 hover:text-primary hover:bg-gray-100 rounded-[6px] transition-colors"
                      title="Редактировать"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                      </svg>
                    </a>

                    <!-- View on Site Action -->
                    <a
                      :href="getProductSiteUrl(prod)"
                      target="_blank"
                      class="p-1.5 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-[6px] transition-colors"
                      title="Просмотреть на сайте"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                      </svg>
                    </a>

                    <!-- Delete Action -->
                    <button
                      type="button"
                      @click.stop="deleteProduct(prod)"
                      class="p-1.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-[6px] transition-colors cursor-pointer"
                      title="Удалить товар"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <!-- Empty State -->
      <div
        x-show="!loading && products.length === 0"
        x-cloak
        class="text-center py-16 px-4"
      >
        <div class="w-12 h-12 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center mx-auto mb-3">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
          </svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900 font-sans">Товары не найдены</h3>
        <p class="text-xs text-gray-500 mt-1 max-w-sm mx-auto font-sans">
          Попробуйте изменить параметры поиска или сбросить фильтры категорий и статуса.
        </p>
        <div class="mt-4">
          <button
            type="button"
            @click="resetFilters()"
            class="inline-flex items-center gap-1.5 py-2 px-3.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-[6px] text-xs font-semibold transition-colors cursor-pointer"
          >
            Сбросить фильтры
          </button>
        </div>
      </div>

      <!-- Pagination Footer -->
      <div
        x-show="totalItems > 0"
        class="p-4 bg-[#F7FAFC] border-t border-border flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-600"
      >
        <div>
          Показано <span class="font-semibold text-gray-900" x-text="((page - 1) * perPage) + (products.length > 0 ? 1 : 0)"></span>-<span class="font-semibold text-gray-900" x-text="Math.min(page * perPage, totalItems)"></span> из <span class="font-semibold text-gray-900" x-text="totalItems"></span> товаров
        </div>

        <!-- Page Switcher -->
        <div class="flex items-center gap-1">
          <!-- Prev Button -->
          <button
            type="button"
            :disabled="page <= 1"
            @click="goToPage(page - 1)"
            class="py-1.5 px-3 rounded-[6px] border border-border bg-white text-gray-700 hover:bg-gray-50 disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer"
          >
            Назад
          </button>

          <!-- Numbered Pages -->
          <template x-for="p in visiblePages" :key="p">
            <button
              type="button"
              @click="goToPage(p)"
              :class="p === page ? 'bg-[#EF1C24] text-white border-[#EF1C24] font-bold' : 'bg-white text-gray-700 border-border hover:bg-gray-50'"
              class="w-8 h-8 rounded-[6px] border text-xs font-semibold flex items-center justify-center transition-colors cursor-pointer"
              x-text="p"
            ></button>
          </template>

          <!-- Next Button -->
          <button
            type="button"
            :disabled="page >= totalPages"
            @click="goToPage(page + 1)"
            class="py-1.5 px-3 rounded-[6px] border border-border bg-white text-gray-700 hover:bg-gray-50 disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer"
          >
            Вперёд
          </button>
        </div>
      </div>
    </div>

    <!-- Toast Notification -->
    <div
      x-show="toastMessage"
      x-cloak
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-4"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 translate-y-4"
      class="fixed bottom-6 right-6 z-50 py-3 px-4 rounded-[8px] shadow-lg text-xs font-semibold flex items-center gap-2.5"
      :class="toastType === 'error' ? 'bg-red-600 text-white' : 'bg-gray-900 text-white'"
    >
      <template x-if="toastType === 'success'">
        <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
      </template>
      <template x-if="toastType === 'error'">
        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </template>
      <span x-text="toastMessage"></span>
    </div>
  </div>

  <!-- Alpine Products Component Logic -->
  <script is:inline define:vars={{ PB_URL }}>
    function productsManager(pbUrl) {
      return {
        pb: null,
        products: [],
        categories: [],
        categoriesMap: {},
        loading: false,
        search: '',
        categoryFilter: '',
        statusFilter: 'all',
        page: 1,
        perPage: 20,
        totalPages: 1,
        totalItems: 0,
        toastMessage: '',
        toastType: 'success',
        toastTimeout: null,

        async init() {
          if (window.PocketBase) {
            this.pb = new window.PocketBase(pbUrl);
            this.pb.autoCancellation(false);
          }
          await this.loadCategories();
          await this.loadProducts();
        },

        async loadCategories() {
          try {
            if (!this.pb) return;
            const list = await this.pb.collection('categories').getFullList({
              sort: 'parent,name',
              $autoCancel: false,
              requestKey: null
            });
            this.categories = list;
            this.categoriesMap = list.reduce((acc, cat) => {
              acc[cat.id] = cat;
              return acc;
            }, {});
          } catch (e) {
            console.error('Error loading categories:', e);
          }
        },

        async loadProducts() {
          this.loading = true;
          try {
            if (!this.pb) {
              this.pb = new window.PocketBase(pbUrl);
              this.pb.autoCancellation(false);
            }

            const filterParts = [];
            if (this.search.trim()) {
              filterParts.push(`name ~ "${this.search.trim()}"`);
            }
            if (this.categoryFilter) {
              filterParts.push(`category = "${this.categoryFilter}"`);
            }
            if (this.statusFilter === 'active') {
              filterParts.push(`is_active = true`);
            } else if (this.statusFilter === 'inactive') {
              filterParts.push(`is_active = false`);
            }

            const filterStr = filterParts.join(' && ');

            const result = await this.pb.collection('products').getList(this.page, this.perPage, {
              filter: filterStr,
              expand: 'category',
              sort: '-created',
              $autoCancel: false,
              requestKey: null
            });

            this.products = result.items || [];
            this.totalPages = result.totalPages || 1;
            this.totalItems = result.totalItems || 0;
          } catch (e) {
            console.error('Error loading products:', e);
            this.showToast('Ошибка загрузки товаров', 'error');
          } finally {
            this.loading = false;
          }
        },

        onFilterChange() {
          this.page = 1;
          this.loadProducts();
        },

        resetFilters() {
          this.search = '';
          this.categoryFilter = '';
          this.statusFilter = 'all';
          this.page = 1;
          this.loadProducts();
        },

        goToPage(p) {
          if (p >= 1 && p <= this.totalPages && p !== this.page) {
            this.page = p;
            this.loadProducts();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        },

        get visiblePages() {
          const max = 5;
          let start = Math.max(1, this.page - Math.floor(max / 2));
          let end = Math.min(this.totalPages, start + max - 1);
          if (end - start + 1 < max) {
            start = Math.max(1, end - max + 1);
          }
          const pages = [];
          for (let i = start; i <= end; i++) {
            pages.push(i);
          }
          return pages;
        },

        getImageUrl(prod) {
          if (!prod.images || prod.images.length === 0) return '';
          return `${pbUrl}/api/files/products/${prod.id}/${prod.images[0]}?thumb=100x100`;
        },

        getProductSiteUrl(prod) {
          const cat = prod.expand?.category;
          if (!cat) return `/katalog/${prod.slug}`;
          if (cat.parent) {
            const parentCat = this.categoriesMap[cat.parent];
            const parentSlug = parentCat ? parentCat.slug : 'promyshlennye-rukava';
            return `/katalog/${parentSlug}/${cat.slug}/${prod.slug}`;
          }
          return `/katalog/${cat.slug}/${prod.slug}`;
        },

        async toggleActive(prod) {
          const newState = !prod.is_active;
          const oldState = prod.is_active;
          prod.is_active = newState; // Optimistic update

          try {
            await this.pb.collection('products').update(prod.id, {
              is_active: newState
            });
            this.showToast(newState ? 'Товар активирован' : 'Товар деактивирован');
          } catch (e) {
            console.error('Error toggling product status:', e);
            prod.is_active = oldState; // Rollback
            this.showToast('Не удалось обновить статус', 'error');
          }
        },

        async deleteProduct(prod) {
          if (!confirm(`Вы действительно хотите удалить товар "${prod.name}"?`)) {
            return;
          }

          try {
            await this.pb.collection('products').delete(prod.id);
            this.showToast('Товар успешно удален');
            // If deleting last item on current page, go back 1 page if possible
            if (this.products.length === 1 && this.page > 1) {
              this.page -= 1;
            }
            await this.loadProducts();
          } catch (e) {
            console.error('Error deleting product:', e);
            this.showToast('Ошибка при удалении товара', 'error');
          }
        },

        showToast(msg, type = 'success') {
          this.toastMessage = msg;
          this.toastType = type;
          if (this.toastTimeout) clearTimeout(this.toastTimeout);
          this.toastTimeout = setTimeout(() => {
            this.toastMessage = '';
          }, 3000);
        }
      };
    }
  </script>
</AdminLayout>
