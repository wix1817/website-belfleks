---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CrmModal from '../components/ui/CrmModal.astro';
import { pb } from '../lib/pocketbase';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'ООО БелФлекс — промышленные рукава и соединения в Беларуси. Официальный дилер. Склад в Гродно.',
  ogImage,
  noindex = false,
} = Astro.props;

let settings: Record<string, any> | null = null;
try {
  const records = await pb.collection('site_settings').getFullList({ $autoCancel: false });
  if (records.length > 0) {
    settings = records[0];
  }
} catch (e) {
  // Site settings optional - use defaults
}

// PocketBase URL for client-side use (injected as window global)
const pbUrl = import.meta.env.PUBLIC_PB_URL || 'http://127.0.0.1:8090';

// Page-level description takes priority over site_description
const metaDescription = description;

// Canonical URL
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;

// Open Graph image — use provided, or favicon from settings, or default
const ogImageUrl = ogImage || (Astro.site ? new URL('/favicon.svg', Astro.site).href : '/favicon.svg');

// Full page title
const fullTitle = settings?.site_name ? `${title} | ${settings.site_name}` : title;

// Messengers (from site_settings or fallback)
const telegramLink = settings?.telegram_link || null;
const viberLink = settings?.viber_link || null;
const showFab = telegramLink || viberLink;

// Favicon
const faviconUrl = settings?.favicon
  ? `${pbUrl}/api/files/${settings.collectionId}/${settings.id}/${settings.favicon}`
  : '/favicon.svg';
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}

    <!-- Primary meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang (i18n ready) -->
    <link rel="alternate" hreflang="ru" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings?.site_name || 'БелФлекс'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="ru_RU" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Fonts (preconnect first, then load) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:ital,wght@1,700&display=swap"
      rel="stylesheet"
    />

    <!-- Inject PB URL for client-side use and initialize early Alpine stores -->
    <script is:inline define:vars={{ pbUrl }}>
      window.__PB_URL__ = pbUrl;
      window.openCrmModal = function() {
        if (window.Alpine && window.Alpine.store('crm')) {
          window.Alpine.store('crm').open();
        }
      };
      window.closeCrmModal = function() {
        if (window.Alpine && window.Alpine.store('crm')) {
          window.Alpine.store('crm').close();
        }
      };
      const initCrmStore = () => {
        if (window.Alpine && !window.Alpine.store('crm')) {
          window.Alpine.store('crm', {
            isOpen: false,
            open() {
              this.isOpen = true;
              document.body.style.overflow = 'hidden';
            },
            close() {
              this.isOpen = false;
              document.body.style.overflow = '';
            }
          });
        }
      };
      if (window.Alpine) {
        initCrmStore();
      } else {
        document.addEventListener('alpine:init', initCrmStore);
      }
      document.addEventListener('DOMContentLoaded', () => {
        document.addEventListener('click', (e) => {
          const trigger = e.target.closest('[data-crm-open], .crm-trigger');
          if (trigger) {
            e.preventDefault();
            window.openCrmModal();
          }
        });
      });
    </script>

    <!-- Analytics (from site_settings, deferred) -->
    {settings?.analytics_code && (
      <Fragment set:html={settings.analytics_code} />
    )}
  </head>
  <body x-data class="min-h-screen flex flex-col font-sans bg-bg-primary text-text-primary">
    <Header />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer settings={settings} />
    <CrmModal />

    <!-- Floating Action Buttons (Telegram / Viber) -->
    {showFab && (
      <div class="fixed bottom-6 right-6 z-50 flex flex-col gap-3">
        {telegramLink && (
          <a
            href={telegramLink}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Написать в Telegram"
            class="w-14 h-14 bg-[#2AABEE] hover:bg-[#1a9bd4] text-white rounded-full shadow-lg hover:shadow-xl flex items-center justify-center transition-all duration-200 hover:scale-110"
          >
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.11.03-1.84 1.18-5.18 3.44-.49.34-.93.5-1.33.49-.44-.01-1.28-.25-1.9-.45-.77-.25-1.38-.38-1.33-.8.03-.22.34-.44.93-.68 3.63-1.58 6.06-2.63 7.28-3.14 3.46-1.44 4.18-1.69 4.65-1.7.1 0 .33.02.47.13.12.09.15.22.16.32-.01.04-.01.14-.02.25z"/>
            </svg>
          </a>
        )}
        {viberLink && (
          <a
            href={viberLink}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Написать в Viber"
            class="w-14 h-14 bg-[#7360f2] hover:bg-[#5e4cd4] text-white rounded-full shadow-lg hover:shadow-xl flex items-center justify-center transition-all duration-200 hover:scale-110"
          >
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
              <path d="M11.398.002C8.46.028 3.67.638 1.567 2.573.105 4.035-.003 6.056 0 8.516c.003 2.455.08 6.988 4.272 8.149v1.883c0 .522.596.773.937.41l1.967-2.046c2.74.232 7.49-.17 8.437-.946 2.107-1.793 2.38-5.498 1.793-9.004-.587-3.506-3.51-4.98-6.008-4.96zm1.703 11.643c-.297.334-.644.588-1.014.826l-.018.012a.3.3 0 01-.17.048.3.3 0 01-.244-.12 5.48 5.48 0 01-.573-.805.303.303 0 01.05-.37c.155-.15.3-.293.43-.438.247-.276.373-.604.373-.938V7.74c0-.318-.127-.617-.354-.84a1.193 1.193 0 00-.848-.349c-.32 0-.615.124-.837.349-.227.226-.354.525-.354.84v2.118c0 .334.126.662.373.938.13.145.275.288.43.438a.303.303 0 01.05.37c-.176.295-.37.565-.573.805a.3.3 0 01-.244.12.3.3 0 01-.17-.048l-.018-.012c-.37-.238-.717-.492-1.014-.826C8.57 11.13 8.113 10.2 8 9.19V7.74c0-1.85 1.505-3.357 3.353-3.357 1.849 0 3.353 1.507 3.353 3.357V9.19c-.113 1.009-.57 1.939-1.605 2.455z"/>
            </svg>
          </a>
        )}
      </div>
    )}
  </body>
</html>
