---
import Toast from '../ui/Toast.astro';
import { PB_URL } from '../../../lib/adminAuth';

interface Props {
  productId?: string;
}

const { productId = '' } = Astro.props;
const isEdit = Boolean(productId);
---

<div
  x-data={`productForm('${productId}', '${PB_URL}')`}
  x-init="init()"
  class="space-y-6"
>
  <Toast />

  <!-- Action Bar & Breadcrumbs -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-border">
    <div>
      <div class="flex items-center gap-2 text-xs text-text-secondary mb-1 font-sans">
        <a href="/manage/products" class="hover:text-primary transition-colors">Товары</a>
        <span>/</span>
        <span class="text-gray-900 font-semibold" x-text="isEdit ? (form.name ? form.name : 'Редактирование товара') : 'Новый товар'"></span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight font-accent italic">
        {isEdit ? 'Редактирование товара' : 'Создание товара'}
      </h1>
    </div>

    <!-- Buttons -->
    <div class="flex flex-wrap items-center gap-2.5">
      <a
        href="/manage/products"
        class="inline-flex items-center gap-1.5 py-2.5 px-4 rounded-[8px] border border-border bg-white text-gray-700 hover:bg-gray-50 text-xs font-semibold font-sans transition-colors cursor-pointer"
      >
        Отмена
      </a>

      <template x-if="isEdit">
        <button
          type="button"
          @click="deleteProduct()"
          :disabled="saving"
          class="inline-flex items-center gap-1.5 py-2.5 px-4 rounded-[8px] border border-red-200 bg-red-50 text-[#EF1C24] hover:bg-[#EF1C24] hover:text-white text-xs font-semibold font-sans transition-colors cursor-pointer disabled:opacity-50"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          Удалить
        </button>
      </template>

      <button
        type="button"
        @click="save(false)"
        :disabled="saving"
        class="inline-flex items-center gap-1.5 py-2.5 px-4 rounded-[8px] border border-border bg-white text-gray-800 hover:bg-gray-50 text-xs font-semibold font-sans transition-colors cursor-pointer shadow-xs disabled:opacity-50"
      >
        <template x-if="saving">
          <svg class="animate-spin h-3.5 w-3.5 text-gray-600" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </template>
        Сохранить и продолжить
      </button>

      <button
        type="button"
        @click="save(true)"
        :disabled="saving"
        class="inline-flex items-center gap-1.5 py-2.5 px-5 rounded-[8px] bg-[#EF1C24] hover:bg-[#d91920] active:scale-[0.99] text-white text-xs font-semibold font-sans transition-all shadow-xs cursor-pointer disabled:opacity-50"
      >
        <template x-if="saving">
          <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </template>
        Сохранить
      </button>
    </div>
  </div>

  <!-- Loading State Indicator -->
  <div
    x-show="loading"
    x-cloak
    class="py-20 text-center text-primary font-medium text-sm flex items-center justify-center gap-2"
  >
    <svg class="animate-spin h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    <span>Загрузка данных товара...</span>
  </div>

  <!-- Form Sections -->
  <div x-show="!loading" class="space-y-6">
    <!-- SECTION 1: ОСНОВНОЕ -->
    <div class="bg-white rounded-[8px] p-6 border border-border shadow-xs">
      <h2 class="text-base font-bold text-gray-900 font-sans mb-4 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#EF1C24]"></span>
        Основное
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <!-- Название -->
        <div class="md:col-span-2">
          <label for="product-name" class="block text-sm font-medium text-[#3B3B3B] mb-1.5">
            Название товара <span class="text-[#EF1C24]">*</span>
          </label>
          <input
            id="product-name"
            type="text"
            x-model="form.name"
            @input="onNameInput()"
            placeholder="например: Рукав пищевой Dionysus EF 10 BAR"
            class="w-full bg-[#F7FAFC] border border-[#EDF2F7] focus:border-primary focus:bg-white focus:ring-2 focus:ring-[#EF1C24]/20 rounded-[8px] py-2.5 px-3.5 text-sm text-gray-900 transition-all"
            :class="{ 'border-[#EF1C24] bg-red-50/20': errors.name }"
          />
          <template x-if="errors.name">
            <p class="text-[#EF1C24] text-[12px] mt-1 font-medium" x-text="errors.name"></p>
          </template>
        </div>

        <!-- Slug -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="product-slug" class="block text-sm font-medium text-[#3B3B3B]">
              URL Slug <span class="text-[#EF1C24]">*</span>
            </label>
            <button
              type="button"
              @click="generateSlug()"
              class="text-xs text-primary hover:text-[#d91920] font-semibold transition-colors cursor-pointer"
            >
              Сгенерировать
            </button>
          </div>
          <input
            id="product-slug"
            type="text"
            x-model="form.slug"
            @input="slugTouched = true; delete errors.slug"
            placeholder="rukav-pischevoy-dionysus-ef"
            class="w-full bg-[#F7FAFC] border border-[#EDF2F7] focus:border-primary focus:bg-white focus:ring-2 focus:ring-[#EF1C24]/20 rounded-[8px] py-2.5 px-3.5 text-sm font-mono text-gray-900 transition-all"
            :class="{ 'border-[#EF1C24] bg-red-50/20': errors.slug }"
          />
          <template x-if="errors.slug">
            <p class="text-[#EF1C24] text-[12px] mt-1 font-medium" x-text="errors.slug"></p>
          </template>
          <p class="text-xs text-text-secondary mt-1 font-mono">
            URL: /katalog/.../<span x-text="form.slug || 'slug'"></span>/
          </p>
        </div>

        <!-- Категория -->
        <div>
          <label for="product-category" class="block text-sm font-medium text-[#3B3B3B] mb-1.5">
            Категория каталога
          </label>
          <select
            id="product-category"
            x-model="form.category"
            class="w-full bg-[#F7FAFC] border border-[#EDF2F7] focus:border-primary focus:bg-white focus:ring-2 focus:ring-[#EF1C24]/20 rounded-[8px] py-2.5 px-3.5 text-sm text-gray-900 transition-all cursor-pointer"
          >
            <option value="">Без категории</option>
            <template x-for="cat in categories" :key="cat.id">
              <option :value="cat.id" x-text="(cat.parent ? '— ' : '') + cat.name"></option>
            </template>
          </select>
        </div>

        <!-- Теги (Chips) -->
        <div class="md:col-span-2">
          <label class="block text-sm font-medium text-[#3B3B3B] mb-1.5">
            Теги и преимущества
          </label>
          <div class="bg-[#F7FAFC] border border-[#EDF2F7] focus-within:border-primary focus-within:ring-2 focus-within:ring-[#EF1C24]/20 focus-within:bg-white rounded-[8px] p-2.5 transition-all">
            <!-- Chips List -->
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <template x-for="(tag, idx) in form.tags" :key="idx">
                <span class="inline-flex items-center gap-1.5 py-1 pl-2.5 pr-1.5 bg-white border border-border text-gray-800 rounded-full text-xs font-medium shadow-2xs">
                  <span x-text="tag"></span>
                  <button
                    type="button"
                    @click="removeTag(idx)"
                    class="w-4 h-4 rounded-full hover:bg-red-50 hover:text-[#EF1C24] text-gray-400 flex items-center justify-center transition-colors cursor-pointer"
                  >
                    ×
                  </button>
                </span>
              </template>
            </div>
            <!-- Tag Input -->
            <input
              type="text"
              x-model="tagInput"
              @keydown.enter.prevent="addTag()"
              @keydown.,.prevent="addTag()"
              placeholder="Введите тег и нажмите Enter..."
              class="w-full bg-transparent border-0 p-1 text-xs sm:text-sm text-gray-900 focus:outline-none placeholder-gray-400"
            />
          </div>
          <p class="text-xs text-text-secondary mt-1">
            Например: <span class="italic text-gray-600">Пищевой, FDA, Маслостойкий, До 10 бар</span> (нажмите Enter для добавления).
          </p>
        </div>
      </div>
    </div>

    <!-- SECTION 2: ИЗОБРАЖЕНИЯ ТОВАРА (Drag and drop + Reordering) -->
    <div class="bg-white rounded-[8px] p-6 border border-border shadow-xs">
      <div class="flex items-center justify-between mb-2">
        <h2 class="text-base font-bold text-gray-900 font-sans flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-purple-500"></span>
          Изображения товара
        </h2>
        <span class="text-xs text-text-secondary font-mono" x-text="images.length + '/10 фото'"></span>
      </div>
      <p class="text-xs text-text-secondary mb-4">
        Первое изображение будет основным в каталоге и на карточке товара. Перетаскивайте карточки для изменения порядка.
      </p>

      <!-- Drag & Drop Dropzone -->
      <div
        @dragover.prevent="isDraggingOver = true"
        @dragleave.prevent="isDraggingOver = false"
        @drop.prevent="handleDrop($event)"
        @click="$refs.fileInput.click()"
        class="border-2 border-dashed rounded-[8px] p-6 text-center transition-all cursor-pointer"
        :class="isDraggingOver ? 'border-[#EF1C24] bg-red-50/30 ring-2 ring-[#EF1C24]/10' : 'border-gray-200 hover:border-gray-300 bg-[#F7FAFC]'"
      >
        <input
          type="file"
          x-ref="fileInput"
          @change="handleFileInput($event)"
          multiple
          accept="image/jpeg,image/png,image/webp"
          class="hidden"
        />

        <div class="flex flex-col items-center justify-center pointer-events-none">
          <div class="w-12 h-12 rounded-full bg-white shadow-2xs border border-border flex items-center justify-center text-primary mb-2.5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <p class="text-sm font-semibold text-gray-800">
            Перетащите изображения сюда или <span class="text-primary underline">выберите на диске</span>
          </p>
          <p class="text-xs text-gray-500 mt-1">
            Поддерживаются JPG, PNG, WebP (до 5 МБ на файл, максимум 10 фото)
          </p>
        </div>
      </div>

      <!-- Images Grid (4 cols desktop, 2 cols mobile) -->
      <div x-show="images.length > 0" class="mt-5">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
          <template x-for="(img, idx) in images" :key="img.id">
            <div
              draggable="true"
              @dragstart="onCardDragStart(idx)"
              @dragover.prevent="onCardDragOver(idx)"
              @drop.prevent="onCardDrop(idx)"
              @dragend="onCardDragEnd()"
              class="group relative aspect-square rounded-[6px] overflow-hidden border border-border bg-gray-50 shadow-2xs transition-all cursor-move select-none"
              :class="{
                'ring-2 ring-primary border-primary': idx === 0,
                'opacity-40 scale-95 border-dashed border-gray-400': draggedCardIndex === idx
              }"
            >
              <!-- Thumbnail Image -->
              <img
                :src="img.previewUrl"
                :alt="img.name"
                class="w-full h-full object-cover pointer-events-none"
              />

              <!-- Main Badge (on index 0) -->
              <template x-if="idx === 0">
                <div class="absolute top-2 left-2 bg-[#EF1C24] text-white text-[10px] font-bold px-2 py-0.5 rounded shadow-sm flex items-center gap-1 pointer-events-none">
                  <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                  Главное
                </div>
              </template>

              <!-- Order Number Badge (on index > 0) -->
              <template x-if="idx > 0">
                <div class="absolute top-2 left-2 bg-black/60 backdrop-blur-2xs text-white text-[10px] font-mono px-1.5 py-0.5 rounded pointer-events-none">
                  #<span x-text="idx + 1"></span>
                </div>
              </template>

              <!-- Delete Button -->
              <button
                type="button"
                @click.stop="removeImage(idx)"
                class="absolute top-2 right-2 w-6 h-6 rounded-full bg-black/60 hover:bg-[#EF1C24] text-white flex items-center justify-center text-xs transition-colors cursor-pointer z-10"
                title="Удалить фото"
              >
                ×
              </button>

              <!-- Set as Main Button Overlay (shown on hover if not main) -->
              <template x-if="idx > 0">
                <div class="absolute inset-x-0 bottom-0 p-2 bg-gradient-to-t from-black/80 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                  <button
                    type="button"
                    @click.stop="setMainImage(idx)"
                    class="w-full py-1 px-2 rounded bg-white text-gray-900 hover:bg-red-50 hover:text-primary text-[11px] font-semibold transition-colors cursor-pointer shadow-xs"
                  >
                    Сделать главным
                  </button>
                </div>
              </template>
            </div>
          </template>
        </div>
      </div>
    </div>

    <!-- SECTION 3: ТЕХНИЧЕСКИЕ ХАРАКТЕРИСТИКИ (Visual Constructor) -->
    <div class="bg-white rounded-[8px] p-6 border border-border shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
        <h2 class="text-base font-bold text-gray-900 font-sans flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-teal-500"></span>
          Технические характеристики
        </h2>
        <span class="text-xs text-text-secondary font-mono" x-text="specifications.length + ' парам.'"></span>
      </div>
      <p class="text-xs text-text-secondary mb-4">
        Добавьте характеристики: Внутренний слой, Наружный слой, Усиление, Температурный режим и т.д.
      </p>

      <!-- Quick Template Buttons -->
      <div class="flex flex-wrap items-center gap-1.5 mb-5 p-3 bg-[#F7FAFC] rounded-[8px] border border-border">
        <span class="text-xs text-text-secondary font-medium mr-1 flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          Шаблоны:
        </span>
        <button
          type="button"
          @click="addQuickSpec('Внутренний слой')"
          class="py-1 px-2.5 rounded-[6px] bg-white border border-border hover:border-primary hover:text-primary text-xs text-gray-700 font-medium transition-colors cursor-pointer shadow-2xs"
        >
          + Внутренний слой
        </button>
        <button
          type="button"
          @click="addQuickSpec('Наружный слой')"
          class="py-1 px-2.5 rounded-[6px] bg-white border border-border hover:border-primary hover:text-primary text-xs text-gray-700 font-medium transition-colors cursor-pointer shadow-2xs"
        >
          + Наружный слой
        </button>
        <button
          type="button"
          @click="addQuickSpec('Усиление')"
          class="py-1 px-2.5 rounded-[6px] bg-white border border-border hover:border-primary hover:text-primary text-xs text-gray-700 font-medium transition-colors cursor-pointer shadow-2xs"
        >
          + Усиление
        </button>
        <button
          type="button"
          @click="addQuickSpec('Температурный режим')"
          class="py-1 px-2.5 rounded-[6px] bg-white border border-border hover:border-primary hover:text-primary text-xs text-gray-700 font-medium transition-colors cursor-pointer shadow-2xs"
        >
          + Температура
        </button>
        <button
          type="button"
          @click="addQuickSpec('Рабочее давление')"
          class="py-1 px-2.5 rounded-[6px] bg-white border border-border hover:border-primary hover:text-primary text-xs text-gray-700 font-medium transition-colors cursor-pointer shadow-2xs"
        >
          + Рабочее давление
        </button>
        <button
          type="button"
          @click="addQuickSpec('Вакуумная стойкость')"
          class="py-1 px-2.5 rounded-[6px] bg-white border border-border hover:border-primary hover:text-primary text-xs text-gray-700 font-medium transition-colors cursor-pointer shadow-2xs"
        >
          + Вакуум
        </button>
        <button
          type="button"
          @click="addQuickSpec('Стандарты / Нормы')"
          class="py-1 px-2.5 rounded-[6px] bg-white border border-border hover:border-primary hover:text-primary text-xs text-gray-700 font-medium transition-colors cursor-pointer shadow-2xs"
        >
          + Стандарты
        </button>
      </div>

      <!-- Specifications Table / Rows Container -->
      <div class="border border-[#EDF2F7] rounded-[8px] overflow-hidden bg-white">
        <!-- Table Header -->
        <div class="hidden md:flex items-center px-4 py-2.5 bg-[#F7FAFC] border-b border-[#EDF2F7] text-xs font-semibold text-gray-600 uppercase tracking-wider">
          <div class="w-8 text-center"></div>
          <div class="w-[35%] pl-2">Параметр / Характеристика</div>
          <div class="w-[55%] pl-4">Значение / Описание</div>
          <div class="w-[10%] text-right pr-2">Действие</div>
        </div>

        <!-- Specifications Rows -->
        <div class="divide-y divide-[#EDF2F7]">
          <template x-for="(spec, idx) in specifications" :key="spec.id">
            <div
              draggable="true"
              @dragstart="onSpecDragStart(idx)"
              @dragover.prevent="onSpecDragOver(idx)"
              @drop.prevent="onSpecDrop(idx)"
              @dragend="onSpecDragEnd()"
              class="flex flex-col md:flex-row items-stretch md:items-start p-3 md:p-3.5 hover:bg-[#F7FAFC] transition-colors gap-3 relative"
              :class="{
                'opacity-40 bg-gray-100 border-dashed border-gray-400': draggedSpecIndex === idx
              }"
            >
              <!-- Drag Handle (6 dots icon) -->
              <div
                class="hidden md:flex items-center justify-center w-8 pt-2.5 text-gray-400 hover:text-gray-700 cursor-grab active:cursor-grabbing flex-shrink-0"
                title="Перетащите для изменения порядка"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M7 4a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0zM7 16a2 2 0 11-4 0 2 2 0 014 0zM17 4a2 2 0 11-4 0 2 2 0 014 0zM17 10a2 2 0 11-4 0 2 2 0 014 0zM17 16a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>

              <!-- Label Input (35%) -->
              <div class="w-full md:w-[35%] flex-shrink-0">
                <input
                  type="text"
                  x-model="spec.label"
                  placeholder="например: Внутренний слой"
                  class="w-full bg-white border border-[#EDF2F7] focus:border-primary focus:ring-2 focus:ring-[#EF1C24]/20 rounded-[6px] py-2 px-3 text-xs sm:text-sm font-medium text-gray-900 transition-all placeholder-gray-400"
                />
              </div>

              <!-- Value Textarea (55%) -->
              <div class="w-full md:w-[55%] flex-grow">
                <textarea
                  rows="2"
                  x-model="spec.value"
                  @input="autoResize($el)"
                  placeholder="например: Белый гладкий пищевой EPDM резиновый слой, без запаха и вкуса"
                  class="w-full bg-white border border-[#EDF2F7] focus:border-primary focus:ring-2 focus:ring-[#EF1C24]/20 rounded-[6px] py-2 px-3 text-xs sm:text-sm text-gray-900 transition-all min-h-[58px] resize-y placeholder-gray-400 leading-relaxed"
                ></textarea>
              </div>

              <!-- Delete Button (10%) -->
              <div class="flex items-center justify-end md:w-[10%] pt-1 flex-shrink-0">
                <button
                  type="button"
                  @click="removeSpec(idx)"
                  class="p-1.5 text-gray-400 hover:text-[#EF1C24] hover:bg-red-50 rounded-[6px] transition-colors cursor-pointer"
                  title="Удалить строку"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            </div>
          </template>
        </div>

        <!-- Empty State -->
        <div
          x-show="specifications.length === 0"
          class="p-8 text-center text-gray-400 text-xs"
        >
          <p>Характеристики еще не добавлены.</p>
          <p class="mt-1 text-gray-500">Воспользуйтесь быстрыми шаблонами выше или кнопкой добавления.</p>
        </div>
      </div>

      <!-- Add Specification Button -->
      <div class="mt-3.5">
        <button
          type="button"
          @click="addSpec()"
          class="inline-flex items-center gap-1.5 py-2 px-4 rounded-[6px] border border-dashed border-gray-300 hover:border-primary bg-white hover:bg-red-50/20 text-gray-700 hover:text-primary text-xs font-semibold font-sans transition-all cursor-pointer shadow-2xs"
        >
          <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Добавить характеристику
        </button>
      </div>
    </div>

    <!-- SECTION 4: ТАБЛИЦА ДИАМЕТРОВ (Visual Table Editor & Excel Import/Export) -->
    <div class="bg-white rounded-[8px] p-6 border border-border shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2">
        <div>
          <h2 class="text-base font-bold text-gray-900 font-sans flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            Таблица типоразмеров и диаметров
          </h2>
          <p class="text-xs text-text-secondary mt-0.5">
            Технические характеристики по диаметрам (рукавов, фитингов и соединений).
          </p>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-xs text-text-secondary font-mono px-2 py-1 bg-gray-100 rounded" x-text="tableRows.length + ' строк × ' + tableColumns.length + ' кол.'"></span>
        </div>
      </div>

      <!-- Table Toolbar -->
      <div class="flex flex-wrap items-center justify-between gap-2.5 my-4 p-3 bg-[#F7FAFC] rounded-[8px] border border-border">
        <div class="flex flex-wrap items-center gap-2">
          <!-- Add Row Button -->
          <button
            type="button"
            @click="addTableRow()"
            class="inline-flex items-center gap-1.5 py-1.5 px-3 rounded-[6px] bg-[#EF1C24] hover:bg-[#d91920] text-white text-xs font-semibold font-sans transition-colors cursor-pointer shadow-2xs"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Добавить строку
          </button>

          <!-- Add Column Button -->
          <button
            type="button"
            @click="openAddColumnModal()"
            class="inline-flex items-center gap-1.5 py-1.5 px-3 rounded-[6px] bg-white border border-border hover:border-primary text-gray-800 hover:text-primary text-xs font-semibold font-sans transition-colors cursor-pointer shadow-2xs"
          >
            <svg class="w-3.5 h-3.5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Добавить колонку
          </button>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <!-- Import from Excel -->
          <button
            type="button"
            @click="excelModalOpen = true"
            class="inline-flex items-center gap-1.5 py-1.5 px-3 rounded-[6px] bg-white border border-border hover:border-green-600 text-gray-700 hover:text-green-700 text-xs font-medium font-sans transition-colors cursor-pointer shadow-2xs"
            title="Вставить скопированную таблицу из Excel"
          >
            <svg class="w-3.5 h-3.5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            Вставить из Excel
          </button>

          <!-- Export to Excel -->
          <button
            type="button"
            @click="exportToExcel()"
            :disabled="tableRows.length === 0"
            class="inline-flex items-center gap-1.5 py-1.5 px-3 rounded-[6px] bg-white border border-border hover:border-blue-600 text-gray-700 hover:text-blue-700 text-xs font-medium font-sans transition-colors cursor-pointer shadow-2xs disabled:opacity-40 disabled:cursor-not-allowed"
            title="Скопировать таблицу в буфер для вставки в Excel"
          >
            <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
            </svg>
            Скопировать для Excel
          </button>

          <!-- Reset Default Columns -->
          <button
            type="button"
            @click="resetToDefaultColumns()"
            class="py-1.5 px-2.5 text-xs text-gray-500 hover:text-primary transition-colors cursor-pointer"
            title="Сбросить структуру таблицы к 7 стандартным колонкам"
          >
            Сброс к стандарту
          </button>
        </div>
      </div>

      <!-- Main Data Table -->
      <div class="border border-[#EDF2F7] rounded-[8px] overflow-hidden bg-white">
        <div class="overflow-x-auto max-h-[520px]">
          <table class="w-full text-left text-xs font-sans border-collapse">
            <!-- Sticky Header -->
            <thead class="sticky top-0 bg-[#F7FAFC] text-gray-700 border-b border-[#EDF2F7] z-10 shadow-2xs">
              <tr>
                <th scope="col" class="w-10 px-2.5 py-3 text-center text-gray-400 font-mono">#</th>
                <template x-for="(col, cIdx) in tableColumns" :key="col.id">
                  <th scope="col" class="px-3 py-2.5 min-w-[130px] border-r border-border/60">
                    <div class="flex items-center justify-between gap-1 group">
                      <!-- Column label input -->
                      <input
                        type="text"
                        x-model="col.label"
                        @change="updateColumnKey(col)"
                        class="w-full bg-transparent hover:bg-white focus:bg-white focus:outline-none focus:ring-1 focus:ring-primary rounded px-1.5 py-1 text-xs font-bold text-gray-900 transition-colors"
                        title="Нажмите для переименования колонки"
                      />
                      
                      <!-- Column controls -->
                      <div class="flex items-center gap-0.5 opacity-40 group-hover:opacity-100 transition-opacity">
                        <!-- Move left -->
                        <button
                          type="button"
                          x-show="cIdx > 0"
                          @click="moveColumn(cIdx, -1)"
                          class="p-0.5 text-gray-400 hover:text-gray-700 rounded cursor-pointer"
                          title="Переместить колонку влево"
                        >
                          ‹
                        </button>
                        <!-- Move right -->
                        <button
                          type="button"
                          x-show="cIdx < tableColumns.length - 1"
                          @click="moveColumn(cIdx, 1)"
                          class="p-0.5 text-gray-400 hover:text-gray-700 rounded cursor-pointer"
                          title="Переместить колонку вправо"
                        >
                          ›
                        </button>
                        <!-- Delete column -->
                        <button
                          type="button"
                          @click="deleteColumn(cIdx)"
                          class="p-0.5 text-gray-400 hover:text-[#EF1C24] rounded cursor-pointer ml-0.5"
                          title="Удалить колонку"
                        >
                          ×
                        </button>
                      </div>
                    </div>
                  </th>
                </template>
                <th scope="col" class="w-24 px-3 py-2.5 text-right text-gray-500 font-semibold pr-4">Действия</th>
              </tr>
            </thead>

            <!-- Table Rows -->
            <tbody class="divide-y divide-border">
              <template x-for="(row, rIdx) in tableRows" :key="row.id">
                <tr class="odd:bg-[#F7FAFC] even:bg-white hover:bg-red-50/15 transition-colors">
                  <!-- Row Number -->
                  <td class="px-2.5 py-2 text-center text-gray-400 font-mono text-[11px]" x-text="rIdx + 1"></td>

                  <!-- Cell Inputs -->
                  <template x-for="col in tableColumns" :key="col.id">
                    <td class="px-1 py-1 border-r border-border/40">
                      <input
                        type="text"
                        x-model="row[col.key]"
                        placeholder="—"
                        class="w-full bg-transparent focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#EF1C24] rounded-[4px] py-1.5 px-2 text-xs sm:text-sm text-gray-900 placeholder-gray-300 transition-colors"
                      />
                    </td>
                  </template>

                  <!-- Row Actions (Duplicate, Delete) -->
                  <td class="px-3 py-1 text-right pr-4">
                    <div class="flex items-center justify-end gap-1">
                      <button
                        type="button"
                        @click="duplicateRow(rIdx)"
                        class="p-1.5 text-gray-400 hover:text-primary hover:bg-gray-100 rounded transition-colors cursor-pointer"
                        title="Дублировать строку"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                        </svg>
                      </button>
                      <button
                        type="button"
                        @click="deleteRow(rIdx)"
                        class="p-1.5 text-gray-400 hover:text-[#EF1C24] hover:bg-red-50 rounded transition-colors cursor-pointer"
                        title="Удалить строку"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>

        <!-- Empty State -->
        <div
          x-show="tableRows.length === 0"
          class="p-8 text-center text-gray-400 text-xs"
        >
          <p>В таблице нет строк данных.</p>
          <button
            type="button"
            @click="addTableRow()"
            class="mt-2 text-primary font-semibold hover:underline cursor-pointer"
          >
            + Добавить первую строку
          </button>
        </div>
      </div>
    </div>

    <!-- SECTION 5: СВЯЗАННЫЕ ТОВАРЫ (UPSELL & CROSS-SELL) -->
    <div class="bg-white rounded-[8px] p-6 border border-border shadow-xs">
      <h2 class="text-base font-bold text-gray-900 font-sans mb-1 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
        Связанные товары (Upsell / Cross-sell)
      </h2>
      <p class="text-xs text-text-secondary mb-5">
        Настройте товары, которые рекомендуются на детальной странице данного рукава (фитинги, хомуты, соединения или сопутствующие рукава).
      </p>

      <template x-if="!isEdit">
        <div class="p-4 bg-gray-50 border border-border rounded-[8px] text-xs text-gray-500 flex items-center gap-2">
          <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Сохраните товар, чтобы настроить связанные товары (Upsell и Cross-sell).</span>
        </div>
      </template>

      <template x-if="isEdit">
        <div class="space-y-6">
          <!-- Блок 1: С этим товаром используют (Upsell) -->
          <div>
            <label class="block text-sm font-semibold text-gray-800 mb-1">
              С этим товаром используют (Upsell)
            </label>
            <p class="text-xs text-text-secondary mb-2">
              Рекомендуемые аксессуары, хомуты, быстроразъемные соединения (БРС) и фитинги.
            </p>

            <!-- Search autocomplete input -->
            <div class="relative" @click.outside="upsellDropdownOpen = false">
              <input
                type="text"
                x-model="upsellQuery"
                @input.debounce.200ms="searchUpsell()"
                @focus="if ((upsellQuery || '').trim().length >= 2) { upsellDropdownOpen = true; searchUpsell(); }"
                placeholder="Поиск товара для добавления (начните вводить название)..."
                class="w-full bg-[#F7FAFC] border border-border focus:border-primary focus:bg-white focus:ring-2 focus:ring-[#EF1C24]/20 rounded-[8px] py-2 px-3 text-xs sm:text-sm text-gray-900 transition-all"
              />

              <!-- Search Results Dropdown -->
              <div
                x-show="upsellDropdownOpen && (upsellResults.length > 0 || upsellLoading)"
                x-cloak
                class="absolute left-0 right-0 top-full mt-1 bg-white border border-border rounded-[8px] shadow-lg max-h-60 overflow-y-auto z-30 divide-y divide-border"
              >
                <div x-show="upsellLoading" class="p-3 text-center text-xs text-gray-400 flex items-center justify-center gap-2">
                  <svg class="animate-spin h-3.5 w-3.5 text-primary" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  <span>Поиск товаров...</span>
                </div>
                <template x-for="item in upsellResults" :key="item.id">
                  <div
                    @click="addUpsell(item)"
                    class="p-2.5 hover:bg-red-50/40 transition-colors flex items-center justify-between cursor-pointer"
                  >
                    <div class="flex items-center gap-2.5 min-w-0 pr-2">
                      <div class="w-9 h-9 rounded bg-gray-50 border border-border overflow-hidden flex-shrink-0 flex items-center justify-center">
                        <template x-if="getProductImageUrl(item)">
                          <img :src="getProductImageUrl(item)" class="w-full h-full object-cover" />
                        </template>
                        <template x-if="!getProductImageUrl(item)">
                          <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                          </svg>
                        </template>
                      </div>
                      <div class="min-w-0">
                        <div class="text-xs font-semibold text-gray-900 truncate" x-text="item.name"></div>
                        <div class="text-[10px] text-gray-400 font-mono truncate" x-text="item.slug"></div>
                      </div>
                    </div>
                    <span class="text-xs text-primary font-semibold flex-shrink-0">+ Добавить</span>
                  </div>
                </template>
              </div>
            </div>

            <!-- Selected Upsells Chips -->
            <div class="flex flex-wrap items-center gap-2 mt-3">
              <template x-for="(prod, uIdx) in selectedUpsells" :key="prod.id">
                <span class="inline-flex items-center gap-2 py-1 pl-1 pr-2.5 bg-white border border-border text-gray-800 rounded-[6px] text-xs font-medium shadow-2xs">
                  <div class="w-6 h-6 rounded bg-gray-50 border border-border/60 overflow-hidden flex items-center justify-center flex-shrink-0">
                    <template x-if="getProductImageUrl(prod)">
                      <img :src="getProductImageUrl(prod)" class="w-full h-full object-cover" />
                    </template>
                    <template x-if="!getProductImageUrl(prod)">
                      <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </template>
                  </div>
                  <span class="line-clamp-1 max-w-[220px]" x-text="prod.name"></span>
                  <button
                    type="button"
                    @click="removeUpsell(uIdx)"
                    class="w-4 h-4 rounded-full hover:bg-red-50 hover:text-[#EF1C24] text-gray-400 flex items-center justify-center transition-colors cursor-pointer"
                  >
                    ×
                  </button>
                </span>
              </template>
              <span x-show="selectedUpsells.length === 0" class="text-xs text-gray-400 italic">
                Товары еще не выбраны
              </span>
            </div>
          </div>

          <!-- Блок 2: Рекомендуем также (Cross-sell) -->
          <div class="pt-4 border-t border-border">
            <label class="block text-sm font-semibold text-gray-800 mb-1">
              Рекомендуем также (Cross-sell)
            </label>
            <p class="text-xs text-text-secondary mb-2">
              Альтернативные или сопутствующие рукава других серий и диаметров.
            </p>

            <!-- Search autocomplete input -->
            <div class="relative" @click.outside="crossellDropdownOpen = false">
              <input
                type="text"
                x-model="crossellQuery"
                @input.debounce.200ms="searchCrossell()"
                @focus="if ((crossellQuery || '').trim().length >= 2) { crossellDropdownOpen = true; searchCrossell(); }"
                placeholder="Поиск товара для добавления (начните вводить название)..."
                class="w-full bg-[#F7FAFC] border border-border focus:border-primary focus:bg-white focus:ring-2 focus:ring-[#EF1C24]/20 rounded-[8px] py-2 px-3 text-xs sm:text-sm text-gray-900 transition-all"
              />

              <!-- Search Results Dropdown -->
              <div
                x-show="crossellDropdownOpen && (crossellResults.length > 0 || crossellLoading)"
                x-cloak
                class="absolute left-0 right-0 top-full mt-1 bg-white border border-border rounded-[8px] shadow-lg max-h-60 overflow-y-auto z-30 divide-y divide-border"
              >
                <div x-show="crossellLoading" class="p-3 text-center text-xs text-gray-400 flex items-center justify-center gap-2">
                  <svg class="animate-spin h-3.5 w-3.5 text-primary" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  <span>Поиск товаров...</span>
                </div>
                <template x-for="item in crossellResults" :key="item.id">
                  <div
                    @click="addCrossell(item)"
                    class="p-2.5 hover:bg-red-50/40 transition-colors flex items-center justify-between cursor-pointer"
                  >
                    <div class="flex items-center gap-2.5 min-w-0 pr-2">
                      <div class="w-9 h-9 rounded bg-gray-50 border border-border overflow-hidden flex-shrink-0 flex items-center justify-center">
                        <template x-if="getProductImageUrl(item)">
                          <img :src="getProductImageUrl(item)" class="w-full h-full object-cover" />
                        </template>
                        <template x-if="!getProductImageUrl(item)">
                          <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                          </svg>
                        </template>
                      </div>
                      <div class="min-w-0">
                        <div class="text-xs font-semibold text-gray-900 truncate" x-text="item.name"></div>
                        <div class="text-[10px] text-gray-400 font-mono truncate" x-text="item.slug"></div>
                      </div>
                    </div>
                    <span class="text-xs text-primary font-semibold flex-shrink-0">+ Добавить</span>
                  </div>
                </template>
              </div>
            </div>

            <!-- Selected Crossells Chips -->
            <div class="flex flex-wrap items-center gap-2 mt-3">
              <template x-for="(prod, cIdx) in selectedCrossells" :key="prod.id">
                <span class="inline-flex items-center gap-2 py-1 pl-1 pr-2.5 bg-white border border-border text-gray-800 rounded-[6px] text-xs font-medium shadow-2xs">
                  <div class="w-6 h-6 rounded bg-gray-50 border border-border/60 overflow-hidden flex items-center justify-center flex-shrink-0">
                    <template x-if="getProductImageUrl(prod)">
                      <img :src="getProductImageUrl(prod)" class="w-full h-full object-cover" />
                    </template>
                    <template x-if="!getProductImageUrl(prod)">
                      <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </template>
                  </div>
                  <span class="line-clamp-1 max-w-[220px]" x-text="prod.name"></span>
                  <button
                    type="button"
                    @click="removeCrossell(cIdx)"
                    class="w-4 h-4 rounded-full hover:bg-red-50 hover:text-[#EF1C24] text-gray-400 flex items-center justify-center transition-colors cursor-pointer"
                  >
                    ×
                  </button>
                </span>
              </template>
              <span x-show="selectedCrossells.length === 0" class="text-xs text-gray-400 italic">
                Товары еще не выбраны
              </span>
            </div>
          </div>
        </div>
      </template>
    </div>

    <!-- SECTION 6: FAQ (ЧАСТО ЗАДАВАЕМЫЕ ВОПРОСЫ) -->
    <div class="bg-white rounded-[8px] p-6 border border-border shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
        <h2 class="text-base font-bold text-gray-900 font-sans flex items-center gap-2">
