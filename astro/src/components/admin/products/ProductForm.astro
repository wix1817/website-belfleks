        <div class="flex items-center justify-between p-3.5 bg-[#F7FAFC] rounded-[8px] border border-border">
          <div>
            <label class="block text-sm font-semibold text-gray-900 cursor-pointer" @click="form.is_featured = !form.is_featured">
