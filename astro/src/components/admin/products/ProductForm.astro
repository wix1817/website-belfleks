          />
          <p class="text-xs text-text-secondary mt-1">Чем меньше число, тем выше в списке.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: Import from Excel -->
  <div
    x-show="excelModalOpen"
    x-cloak
