  >
    <div
      class="bg-white rounded-[10px] max-w-2xl w-full p-6 shadow-2xl border border-border space-y-4"
      @click.stop
    >
      <div class="flex items-center justify-between pb-3 border-b border-border">
        <h3 class="text-base font-bold text-gray-900 font-sans flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-green-500"></span>
