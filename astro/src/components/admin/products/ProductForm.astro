            </label>
            <span class="text-xs text-text-secondary">Показывать на главной</span>
          </div>
          <button
            type="button"
            @click="form.is_featured = !form.is_featured"
            :class="form.is_featured ? 'bg-[#EF1C24]' : 'bg-gray-300'"
