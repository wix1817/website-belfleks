          @keydown.enter.prevent="confirmAddColumn()"
          placeholder="например: Вакуум, бар"
          class="w-full bg-[#F7FAFC] border border-border focus:border-primary focus:bg-white focus:ring-2 focus:ring-[#EF1C24]/20 rounded-[6px] py-2 px-3 text-xs sm:text-sm text-gray-900"
        />
      </div>

      <div class="flex items-center justify-end gap-2 pt-2">
        <button
          type="button"
          @click="addColModalOpen = false; newColLabel = ''"
          class="py-1.5 px-3 rounded-[6px] border border-border bg-white text-gray-700 hover:bg-gray-50 text-xs font-semibold cursor-pointer"
        >
          Отмена
        </button>
        <button
          type="button"
          @click="confirmAddColumn()"
          class="py-1.5 px-4 rounded-[6px] bg-[#EF1C24] hover:bg-[#d91920] text-white text-xs font-semibold cursor-pointer shadow-xs"
        >
          Добавить
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Global Product Form Alpine Script -->
<script is:inline>
  window.productForm = function(id, pbUrl) {
    return {
      pb: null,
      productId: id || '',
      pbUrl: pbUrl || 'http://127.0.0.1:8090',
      isEdit: Boolean(id),
      loading: false,
      saving: false,
      slugTouched: false,
      tagInput: '',
      categories: [],
      errors: {},
      images: [], // array of { id, name, file, previewUrl, isExisting, rawFileName, fullUrl }
      specifications: [], // array of { id, label, value }
      tableColumns: [], // array of { id, label, key }
      tableRows: [], // array of { id, [colKey]: string }
      isDraggingOver: false,
      draggedCardIndex: null,
      draggedSpecIndex: null,

      // Modals
      excelModalOpen: false,
      excelRawText: '',
      addColModalOpen: false,
      newColLabel: '',

      // Upsell & Cross-sell
      selectedUpsells: [], // array of { id, name, slug, images }
      selectedCrossells: [], // array of { id, name, slug, images }
      upsellQuery: '',
      upsellResults: [],
      upsellLoading: false,
      upsellDropdownOpen: false,
      crossellQuery: '',
      crossellResults: [],
      crossellLoading: false,
      crossellDropdownOpen: false,

      // FAQ
      faqList: [], // array of { id, question, answer }
      draggedFaqIndex: null,

      form: {
        name: '',
        slug: '',
        category: '',
        short_description: '',
        description: '',
        tags: [],
        meta_title: '',
        meta_description: '',
        is_active: true,
        is_featured: false,
        sort_order: 0,
      },

      defaultColumnsList: [
        { label: 'Диаметр, мм', key: 'diameter_mm' },
        { label: 'Наружный диаметр, мм', key: 'outer_diameter_mm' },
        { label: 'Рабочее давление, бар', key: 'working_pressure_bar' },
        { label: 'Разрывное давление, бар', key: 'burst_pressure_bar' },
        { label: 'Радиус изгиба, мм', key: 'bend_radius_mm' },
        { label: 'Длина бухты, м', key: 'coil_length_m' },
        { label: 'Вес, г/м', key: 'weight_g_m' }
      ],

      getProductImageUrl(item) {
        if (!item) return '';
        const img = Array.isArray(item.images) ? item.images[0] : (item.images || item.image || null);
        if (!img) return '';
        return `${this.pbUrl}/api/files/products/${item.id}/${img}?thumb=100x100`;
      },

      async init() {
        this.initPb(this.pbUrl);
        await this.loadCategories();

        if (this.productId) {
          await this.loadProductData();
        } else {
          this.resetToDefaultColumns();
        }
      },

      initPb(url) {
        if (window.PocketBase) {
          this.pb = new window.PocketBase(url || this.pbUrl);
          this.pb.autoCancellation(false);
          this.pb.authStore.loadFromCookie(document.cookie);
        }
      },

      async loadCategories() {
        try {
          if (!this.pb) this.initPb(this.pbUrl);
          if (!this.pb) return;

          const list = await this.pb.collection('categories').getFullList({
            sort: 'parent,name',
            $autoCancel: false,
            requestKey: null
          });
          this.categories = list;
        } catch (e) {
          console.error('Error loading categories:', e);
        }
      },

      async loadProductData() {
        this.loading = true;
        try {
          if (!this.pb) this.initPb(this.pbUrl);
          if (!this.pb) return;

          const record = await this.pb.collection('products').getOne(this.productId, {
            expand: 'upsell,crossell',
            $autoCancel: false,
            requestKey: null
          });

          this.form.name = record.name || '';
          this.form.slug = record.slug || '';
          this.form.category = record.category || '';
          this.form.short_description = record.short_description || '';
          this.form.description = record.description || '';
          this.form.tags = Array.isArray(record.tags) ? record.tags : [];
          this.form.meta_title = record.meta_title || '';
          this.form.meta_description = record.meta_description || '';
          this.form.is_active = record.is_active !== undefined ? record.is_active : true;
          this.form.is_featured = record.is_featured || false;
          this.form.sort_order = record.sort_order || 0;

          // Populate existing images
          const rawImages = Array.isArray(record.images)
            ? record.images
            : (record.images ? [record.images] : []);

          this.images = rawImages.map((imgName, idx) => {
            const fileUrl = `${this.pbUrl}/api/files/products/${record.id}/${imgName}`;
            return {
              id: `existing_${idx}_${imgName}`,
              name: imgName,
              file: null,
              previewUrl: `${fileUrl}?thumb=300x300`,
              fullUrl: fileUrl,
              isExisting: true,
              rawFileName: imgName
            };
          });

          // Populate technical specifications
          if (record.specifications) {
            if (Array.isArray(record.specifications)) {
              this.specifications = record.specifications.map((s, idx) => ({
                id: `spec_${idx}_${Date.now()}`,
                label: s.label || s.name || '',
                value: s.value || ''
              }));
            } else if (typeof record.specifications === 'object') {
              this.specifications = Object.entries(record.specifications).map(([k, v], idx) => ({
                id: `spec_${idx}_${Date.now()}`,
                label: k,
                value: String(v)
              }));
            }
          }

          // Populate diameter table
          if (record.diameter_table && Array.isArray(record.diameter_table) && record.diameter_table.length > 0) {
            this.loadDiameterTableData(record.diameter_table);
          } else {
            this.resetToDefaultColumns();
          }

          // Populate Upsell & Cross-sell
          if (record.expand?.upsell) {
            const upsells = Array.isArray(record.expand.upsell) ? record.expand.upsell : [record.expand.upsell];
            this.selectedUpsells = upsells.map(u => ({
              id: u.id,
              name: u.name,
              slug: u.slug,
              images: Array.isArray(u.images) ? u.images : (u.images ? [u.images] : [])
            }));
          }
          if (record.expand?.crossell) {
            const crossells = Array.isArray(record.expand.crossell) ? record.expand.crossell : [record.expand.crossell];
            this.selectedCrossells = crossells.map(c => ({
              id: c.id,
              name: c.name,
              slug: c.slug,
              images: Array.isArray(c.images) ? c.images : (c.images ? [c.images] : [])
            }));
          }

          // Populate FAQ
          if (record.faq && Array.isArray(record.faq)) {
            this.faqList = record.faq.map((f, idx) => ({
              id: `faq_${idx}_${Date.now()}`,
              question: f.question || '',
              answer: f.answer || ''
            }));
          }

          // Set editor content
          this.$nextTick(() => {
            if (this.$refs.editor) {
              this.$refs.editor.innerHTML = this.form.description;
            }
          });
        } catch (e) {
          console.error('Error loading product record:', e);
          this.emitToast('Ошибка загрузки данных товара', 'error');
        } finally {
          this.loading = false;
        }
      },

      // --- Upsell & Cross-sell Search and Management ---
      async searchUpsell() {
        const q = (this.upsellQuery || '').trim();
        if (q.length < 2) {
          this.upsellResults = [];
          this.upsellDropdownOpen = false;
          return;
        }

        this.upsellLoading = true;
        this.upsellDropdownOpen = true;
        try {
          if (!this.pb) this.initPb(this.pbUrl);
          const filter = `name ~ "${q}"${this.productId ? ` && id != "${this.productId}"` : ''}`;
          const res = await this.pb.collection('products').getList(1, 10, {
            filter: filter,
            sort: 'name',
            $autoCancel: false,
            requestKey: null
          });
          this.upsellResults = res.items || [];
        } catch (e) {
          console.error('Upsell search error:', e);
        } finally {
          this.upsellLoading = false;
        }
      },

      addUpsell(item) {
        if (!this.selectedUpsells.some(u => u.id === item.id)) {
          this.selectedUpsells.push({
            id: item.id,
            name: item.name,
            slug: item.slug,
            images: Array.isArray(item.images) ? item.images : (item.images ? [item.images] : [])
          });
          this.emitToast(`Товар "${item.name}" добавлен в Upsell`, 'success');
        }
        this.upsellQuery = '';
        this.upsellDropdownOpen = false;
      },

      removeUpsell(index) {
        this.selectedUpsells.splice(index, 1);
      },

      async searchCrossell() {
        const q = (this.crossellQuery || '').trim();
        if (q.length < 2) {
          this.crossellResults = [];
          this.crossellDropdownOpen = false;
          return;
        }

        this.crossellLoading = true;
        this.crossellDropdownOpen = true;
        try {
          if (!this.pb) this.initPb(this.pbUrl);
          const filter = `name ~ "${q}"${this.productId ? ` && id != "${this.productId}"` : ''}`;
          const res = await this.pb.collection('products').getList(1, 10, {
            filter: filter,
            sort: 'name',
            $autoCancel: false,
            requestKey: null
          });
          this.crossellResults = res.items || [];
        } catch (e) {
          console.error('Crossell search error:', e);
        } finally {
          this.crossellLoading = false;
        }
      },

      addCrossell(item) {
        if (!this.selectedCrossells.some(c => c.id === item.id)) {
          this.selectedCrossells.push({
            id: item.id,
            name: item.name,
            slug: item.slug,
            images: Array.isArray(item.images) ? item.images : (item.images ? [item.images] : [])
          });
          this.emitToast(`Товар "${item.name}" добавлен в Cross-sell`, 'success');
        }
        this.crossellQuery = '';
        this.crossellDropdownOpen = false;
      },

      removeCrossell(index) {
        this.selectedCrossells.splice(index, 1);
      },

      // --- FAQ Management ---
      addFaq(q = '', a = '') {
        this.faqList.push({
          id: `faq_${Date.now()}_${Math.random().toString(36).substr(2, 5)}`,
          question: q,
          answer: a
        });
      },

      removeFaq(index) {
        this.faqList.splice(index, 1);
      },

      onFaqDragStart(index) {
        this.draggedFaqIndex = index;
      },

      onFaqDragOver(index) {
        // Needed for drop
      },

      onFaqDrop(targetIndex) {
        if (this.draggedFaqIndex === null || this.draggedFaqIndex === targetIndex) return;
        const [item] = this.faqList.splice(this.draggedFaqIndex, 1);
        this.faqList.splice(targetIndex, 0, item);
        this.draggedFaqIndex = null;
      },

      onFaqDragEnd() {
        this.draggedFaqIndex = null;
      },

      // --- Diameter Table Management ---
      loadDiameterTableData(dataRows) {
        const colKeyMap = {};
        const colLabelsDict = {
          diameter_mm: 'Диаметр, мм',
          inner_diameter_mm: 'Внутренний Ø, мм',
          outer_diameter_mm: 'Наружный диаметр, мм',
          working_pressure_bar: 'Рабочее давление, бар',
          burst_pressure_bar: 'Разрывное давление, бар',
          bend_radius_mm: 'Радиус изгиба, мм',
          coil_length_m: 'Длина бухты, м',
          weight_g_m: 'Вес, г/м',
          vacuum_bar: 'Вакуум, бар',
          wall_thickness_mm: 'Толщина стенки, мм'
        };

        dataRows.forEach(r => {
          Object.keys(r || {}).forEach(k => {
            colKeyMap[k] = true;
          });
        });

        this.tableColumns = Object.keys(colKeyMap).map((key, idx) => ({
          id: `col_${idx}_${key}`,
          label: colLabelsDict[key] || key.replace(/_/g, ' '),
          key: key
        }));

        this.tableRows = dataRows.map((r, idx) => {
          const rowObj = { id: `row_${idx}_${Date.now()}` };
          this.tableColumns.forEach(c => {
            rowObj[c.key] = r[c.key] !== undefined ? String(r[c.key]) : '';
          });
          return rowObj;
        });
      },

      resetToDefaultColumns() {
        this.tableColumns = this.defaultColumnsList.map((c, idx) => ({
          id: `col_${idx}_${c.key}`,
          label: c.label,
          key: c.key
        }));

        if (this.tableRows.length === 0) {
          this.addTableRow();
        } else {
          this.tableRows.forEach(r => {
            this.tableColumns.forEach(c => {
              if (r[c.key] === undefined) r[c.key] = '';
            });
          });
        }
        this.emitToast('Структура колонок сброшена к стандартной', 'info');
      },

      addTableRow(insertAfterIndex = null) {
        const newRow = { id: `row_${Date.now()}_${Math.random().toString(36).substr(2, 5)}` };
        this.tableColumns.forEach(c => {
          newRow[c.key] = '';
        });

        if (insertAfterIndex !== null && insertAfterIndex >= 0) {
          this.tableRows.splice(insertAfterIndex + 1, 0, newRow);
        } else {
          this.tableRows.push(newRow);
        }
      },

      duplicateRow(index) {
        const source = this.tableRows[index];
        if (!source) return;
        const cloned = { ...source, id: `row_${Date.now()}_${Math.random().toString(36).substr(2, 5)}` };
        this.tableRows.splice(index + 1, 0, cloned);
        this.emitToast('Строка продублирована', 'info');
      },

      deleteRow(index) {
        this.tableRows.splice(index, 1);
      },

      openAddColumnModal() {
        this.newColLabel = '';
        this.addColModalOpen = true;
      },

      confirmAddColumn() {
        const label = this.newColLabel.trim();
        if (!label) return;

        const key = this.labelToColumnKey(label);
        const colId = `col_${Date.now()}_${key}`;

        this.tableColumns.push({
          id: colId,
          label: label,
          key: key
        });

        this.tableRows.forEach(r => {
          r[key] = '';
        });

        this.addColModalOpen = false;
        this.newColLabel = '';
        this.emitToast(`Колонка "${label}" добавлена`, 'success');
      },

      deleteColumn(index) {
        const col = this.tableColumns[index];
        if (!col) return;
        if (confirm(`Удалить колонку "${col.label}"?`)) {
          const key = col.key;
          this.tableColumns.splice(index, 1);
          this.tableRows.forEach(r => {
            delete r[key];
          });
        }
      },

      moveColumn(index, delta) {
        const target = index + delta;
        if (target < 0 || target >= this.tableColumns.length) return;
        const [col] = this.tableColumns.splice(index, 1);
        this.tableColumns.splice(target, 0, col);
      },

      updateColumnKey(col) {
        const newKey = this.labelToColumnKey(col.label);
        if (newKey !== col.key) {
          const oldKey = col.key;
          col.key = newKey;
          this.tableRows.forEach(r => {
            r[newKey] = r[oldKey] || '';
            delete r[oldKey];
          });
        }
      },

      labelToColumnKey(label) {
        const standardMap = {
          'диаметр, мм': 'diameter_mm',
          'диаметр': 'diameter_mm',
          'внутренний диаметр, мм': 'inner_diameter_mm',
          'внутренний диаметр': 'inner_diameter_mm',
          'наружный диаметр, мм': 'outer_diameter_mm',
          'наружный диаметр': 'outer_diameter_mm',
          'нар. ø, мм': 'outer_diameter_mm',
          'рабочее давление, бар': 'working_pressure_bar',
          'рабочее давление': 'working_pressure_bar',
          'разрывное давление, бар': 'burst_pressure_bar',
          'разрывное давление': 'burst_pressure_bar',
          'радиус изгиба, мм': 'bend_radius_mm',
          'радиус изгиба': 'bend_radius_mm',
          'длина бухты, м': 'coil_length_m',
          'длина бухты': 'coil_length_m',
          'вес, г/м': 'weight_g_m',
          'вес': 'weight_g_m',
          'вакуум, бар': 'vacuum_bar',
          'вакуум': 'vacuum_bar',
          'толщина стенки, мм': 'wall_thickness_mm'
        };

        const normalized = label.trim().toLowerCase();
        if (standardMap[normalized]) return standardMap[normalized];

        const ruMap = {
          'а': 'a', 'б': 'b', 'в': 'v', 'г': 'g', 'д': 'd', 'е': 'e', 'ё': 'yo',
          'ж': 'zh', 'з': 'z', 'и': 'i', 'й': 'y', 'к': 'k', 'л': 'l', 'м': 'm',
          'н': 'n', 'о': 'o', 'п': 'p', 'р': 'r', 'с': 's', 'т': 't', 'у': 'u',
          'ф': 'f', 'х': 'kh', 'ц': 'ts', 'ч': 'ch', 'ш': 'sh', 'щ': 'shch',
          'ъ': '', 'ы': 'y', 'ь': '', 'э': 'e', 'ю': 'yu', 'я': 'ya'
        };

        let key = normalized.split('').map(c => ruMap[c] !== undefined ? ruMap[c] : c).join('');
        key = key.replace(/[^a-z0-9]/g, '_').replace(/_+/g, '_').replace(/^_+|_+$/g, '');
        return key || `col_${Date.now()}`;
      },

      // --- Excel Import / Export ---
      get excelParsedSummary() {
        if (!this.excelRawText || !this.excelRawText.trim()) return '';
        const lines = this.excelRawText.trim().split(/\r?\n/).filter(l => l.trim().length > 0);
        if (lines.length === 0) return '';
        const headers = lines[0].split(/\t/).map(h => h.trim()).filter(Boolean);
        const dataRowsCount = Math.max(0, lines.length - 1);
        return `Обнаружено: ${dataRowsCount} строк данных и ${headers.length} колонок ("${headers.slice(0, 3).join('", "')}${headers.length > 3 ? '...' : ''}")`;
      },

      applyExcelImport() {
        const text = this.excelRawText.trim();
        if (!text) return;

        const lines = text.split(/\r?\n/).filter(l => l.trim().length > 0);
        if (lines.length < 2) {
          this.emitToast('Нужно минимум 2 строки (заголовки и данные)', 'error');
          return;
        }

        const headerLine = lines[0];
        const delimiter = headerLine.includes('\t') ? '\t' : (headerLine.includes(';') ? ';' : ',');
        const headers = headerLine.split(delimiter).map(h => h.trim().replace(/^["']|["']$/g, ''));

        if (headers.length === 0) {
          this.emitToast('Не удалось определить колонки', 'error');
          return;
        }

        const newCols = headers.map((h, idx) => ({
          id: `col_${idx}_${Date.now()}`,
          label: h,
          key: this.labelToColumnKey(h)
        }));

        const newRows = [];
        for (let i = 1; i < lines.length; i++) {
          const cells = lines[i].split(delimiter).map(c => c.trim().replace(/^["']|["']$/g, ''));
          const rowObj = { id: `row_${i}_${Date.now()}` };
          newCols.forEach((col, cIdx) => {
            rowObj[col.key] = cells[cIdx] !== undefined ? cells[cIdx] : '';
          });
          newRows.push(rowObj);
        }

        this.tableColumns = newCols;
        this.tableRows = newRows;
        this.excelModalOpen = false;
        this.excelRawText = '';
        this.emitToast(`Импортировано ${newRows.length} строк и ${newCols.length} колонок`, 'success');
      },

      exportToExcel() {
        if (this.tableColumns.length === 0 || this.tableRows.length === 0) {
          this.emitToast('Таблица пуста', 'error');
          return;
        }

        const headerLine = this.tableColumns.map(c => c.label).join('\t');
        const dataLines = this.tableRows.map(r => {
          return this.tableColumns.map(c => (r[c.key] !== undefined ? r[c.key] : '')).join('\t');
        });

        const tsv = [headerLine, ...dataLines].join('\n');

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(tsv).then(() => {
            this.emitToast('Таблица скопирована в буфер (вставьте в Excel)', 'success');
          }).catch(err => {
            console.error('Clipboard copy error:', err);
            this.emitToast('Не удалось скопировать в буфер', 'error');
          });
        }
      },

      // --- Specifications Constructor Handlers ---
      addSpec(label = '', value = '') {
        this.specifications.push({
          id: `spec_${Date.now()}_${Math.random().toString(36).substr(2, 5)}`,
          label: label,
          value: value
        });
      },

      addQuickSpec(label) {
        this.addSpec(label, '');
        this.emitToast(`Характеристика "${label}" добавлена`, 'info');
      },

      removeSpec(index) {
        this.specifications.splice(index, 1);
      },

      onSpecDragStart(index) {
        this.draggedSpecIndex = index;
      },

      onSpecDragOver(index) {
        // Required for drop
      },

      onSpecDrop(targetIndex) {
        if (this.draggedSpecIndex === null || this.draggedSpecIndex === targetIndex) return;
        const [item] = this.specifications.splice(this.draggedSpecIndex, 1);
        this.specifications.splice(targetIndex, 0, item);
        this.draggedSpecIndex = null;
      },

      onSpecDragEnd() {
        this.draggedSpecIndex = null;
      },

      autoResize(el) {
        if (el) {
          el.style.height = 'auto';
          el.style.height = Math.max(58, el.scrollHeight) + 'px';
        }
      },

      // --- Image Upload & Validation Handlers ---
      handleFileInput(event) {
        const files = Array.from(event.target.files || []);
        this.processFiles(files);
        event.target.value = ''; // reset
      },

      handleDrop(event) {
        this.isDraggingOver = false;
        const files = Array.from(event.dataTransfer.files || []);
        this.processFiles(files);
      },

      processFiles(files) {
        const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];
        const maxSize = 5 * 1024 * 1024; // 5 MB

        for (const file of files) {
          if (this.images.length >= 10) {
            this.emitToast('Максимальное количество изображений — 10', 'error');
            break;
          }

          if (!allowedTypes.includes(file.type)) {
            this.emitToast(`Недопустимый формат "${file.name}". Разрешены только JPG, PNG, WebP`, 'error');
            continue;
          }

          if (file.size > maxSize) {
            this.emitToast(`Файл "${file.name}" превышает 5 МБ`, 'error');
            continue;
          }

          const blobUrl = URL.createObjectURL(file);
          this.images.push({
            id: `new_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,
            name: file.name,
            file: file,
            previewUrl: blobUrl,
            fullUrl: blobUrl,
            isExisting: false,
          });
        }
      },

      removeImage(index) {
        const item = this.images[index];
        if (item && !item.isExisting && item.previewUrl && item.previewUrl.startsWith('blob:')) {
          URL.revokeObjectURL(item.previewUrl);
        }
        this.images.splice(index, 1);
      },

      setMainImage(index) {
        if (index === 0) return;
        const [item] = this.images.splice(index, 1);
        this.images.unshift(item);
        this.emitToast('Главное изображение обновлено', 'info');
      },

      onCardDragStart(index) {
        this.draggedCardIndex = index;
      },

      onCardDragOver(index) {
        // Required to allow drop
      },

      onCardDrop(targetIndex) {
        if (this.draggedCardIndex === null || this.draggedCardIndex === targetIndex) return;
        const [draggedItem] = this.images.splice(this.draggedCardIndex, 1);
        this.images.splice(targetIndex, 0, draggedItem);
        this.draggedCardIndex = null;
      },

      onCardDragEnd() {
        this.draggedCardIndex = null;
      },

      // --- Product Name & Slug Handlers ---
      onNameInput() {
        delete this.errors.name;
        if (!this.isEdit && !this.slugTouched) {
          this.generateSlug();
        }
      },

      generateSlug() {
        const text = this.form.name || '';
        const ruMap = {
          'а': 'a', 'б': 'b', 'в': 'v', 'г': 'g', 'д': 'd', 'е': 'e', 'ё': 'yo',
          'ж': 'zh', 'з': 'z', 'и': 'i', 'й': 'y', 'к': 'k', 'л': 'l', 'м': 'm',
          'н': 'n', 'о': 'o', 'п': 'p', 'р': 'r', 'с': 's', 'т': 't', 'у': 'u',
          'ф': 'f', 'х': 'kh', 'ц': 'ts', 'ч': 'ch', 'ш': 'sh', 'щ': 'shch',
          'ъ': '', 'ы': 'y', 'ь': '', 'э': 'e', 'ю': 'yu', 'я': 'ya'
        };

        let result = text.toLowerCase().split('').map(char => {
          return ruMap[char] !== undefined ? ruMap[char] : char;
        }).join('');

        result = result
          .replace(/[^a-z0-9-_]/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-|-$/g, '');

        this.form.slug = result;
      },

      addTag() {
        const val = this.tagInput.trim().replace(/^,+|,+$/g, '');
        if (!val) return;
        if (!this.form.tags.includes(val)) {
          this.form.tags.push(val);
        }
        this.tagInput = '';
      },

      removeTag(index) {
        this.form.tags.splice(index, 1);
      },

      execFormat(cmd, val = null) {
        document.execCommand(cmd, false, val);
        if (this.$refs.editor) {
          this.form.description = this.$refs.editor.innerHTML;
        }
      },

      insertLink() {
        const url = prompt('Введите URL ссылки (например: https://example.com):');
        if (url) {
          this.execFormat('createLink', url);
        }
      },

      async validate() {
        this.errors = {};

        // 1. Name is required
        if (!this.form.name.trim()) {
          this.errors.name = 'Название товара обязательно для заполнения';
        }

        // 2. Slug is required and format
        if (!this.form.slug.trim()) {
          this.errors.slug = 'Slug обязателен';
        } else if (!/^[a-z0-9-_]+$/i.test(this.form.slug.trim())) {
          this.errors.slug = 'Slug может содержать только латинские буквы, цифры, дефис и подчеркивание';
        }

        // 3. Short description length
        if (this.form.short_description && this.form.short_description.length > 160) {
          this.errors.short_description = 'Длина краткого описания не может превышать 160 символов';
        }

        // 4. Validate specifications (label required if value provided)
        for (const spec of this.specifications) {
          if (spec.value && spec.value.trim() && !spec.label.trim()) {
            this.emitToast('Для всех характеристик со значением должно быть указано название', 'error');
            return false;
          }
        }

        if (Object.keys(this.errors).length > 0) {
          return false;
        }

        // 5. Check slug uniqueness in PocketBase
        try {
          if (!this.pb) this.initPb(pbUrl);

          let filterQuery = `slug = "${this.form.slug.trim()}"`;
          if (this.productId) {
            filterQuery += ` && id != "${this.productId}"`;
          }

          const existing = await this.pb.collection('products').getList(1, 1, {
            filter: filterQuery,
            $autoCancel: false,
            requestKey: null
          });

          if (existing.totalItems > 0) {
            this.errors.slug = 'Товар с таким URL Slug уже существует. Измените slug.';
            return false;
          }
        } catch (e) {
          console.error('Error verifying slug uniqueness:', e);
        }

        return true;
      },

      async save(redirectAfter = true) {
        const isValid = await this.validate();
        if (!isValid) {
          this.emitToast('Пожалуйста, исправьте ошибки в форме', 'error');
          return;
        }

        this.saving = true;
        try {
          if (!this.pb) this.initPb(pbUrl);

          // Read latest editor HTML
          if (this.$refs.editor) {
            this.form.description = this.$refs.editor.innerHTML;
          }

          // Clean specifications: remove completely empty rows
          const cleanedSpecs = this.specifications
            .filter(s => (s.label && s.label.trim()) || (s.value && s.value.trim()))
            .map(s => ({
              label: s.label.trim(),
              value: s.value.trim()
            }));

          // Clean diameter table: filter out rows where all cells are empty
          const cleanedTable = this.tableRows
            .filter(row => {
              return this.tableColumns.some(c => row[c.key] && String(row[c.key]).trim().length > 0);
            })
            .map(row => {
              const rowData = {};
              this.tableColumns.forEach(c => {
                rowData[c.key] = row[c.key] !== undefined ? String(row[c.key]).trim() : '';
              });
              return rowData;
            });

          // Clean FAQ list
          const cleanedFaq = this.faqList
            .filter(f => (f.question && f.question.trim()) || (f.answer && f.answer.trim()))
            .map(f => ({
              question: f.question.trim(),
              answer: f.answer.trim()
            }));

          // Build FormData for multipart payload
          const formData = new FormData();
          formData.append('name', this.form.name.trim());
          formData.append('slug', this.form.slug.trim());
          formData.append('category', this.form.category || '');
          formData.append('short_description', this.form.short_description.trim());
          formData.append('description', this.form.description || '');
          formData.append('tags', JSON.stringify(this.form.tags || []));
          formData.append('specifications', JSON.stringify(cleanedSpecs));
          formData.append('diameter_table', JSON.stringify(cleanedTable));
          formData.append('faq', JSON.stringify(cleanedFaq));
          formData.append('meta_title', this.form.meta_title ? this.form.meta_title.trim() : '');
          formData.append('meta_description', this.form.meta_description ? this.form.meta_description.trim() : '');
          formData.append('is_active', String(Boolean(this.form.is_active)));
          formData.append('is_featured', String(Boolean(this.form.is_featured)));
          formData.append('sort_order', String(Number(this.form.sort_order) || 0));

          // Append upsell and crossell relation IDs
          if (this.selectedUpsells.length > 0) {
            this.selectedUpsells.forEach(u => {
              formData.append('upsell', u.id);
            });
          } else {
            formData.append('upsell', '');
          }

          if (this.selectedCrossells.length > 0) {
            this.selectedCrossells.forEach(c => {
              formData.append('crossell', c.id);
            });
          } else {
            formData.append('crossell', '');
          }

          // Append images in their exact reordered sequence
          for (const img of this.images) {
            if (img.file) {
              formData.append('images', img.file, img.name);
            } else if (img.isExisting && img.fullUrl) {
              try {
                const resp = await fetch(img.fullUrl);
                const blob = await resp.blob();
                formData.append('images', blob, img.name);
              } catch (err) {
                console.warn('Could not fetch existing image blob:', img.name, err);
              }
            }
          }

          let record;
          if (this.productId) {
            record = await this.pb.collection('products').update(this.productId, formData);
            this.emitToast('Товар успешно сохранен', 'success');
          } else {
            record = await this.pb.collection('products').create(formData);
            this.productId = record.id;
            this.isEdit = true;
            this.emitToast('Товар успешно создан', 'success');
            window.history.replaceState(null, '', `/manage/products/${record.id}`);
          }

          if (redirectAfter) {
            setTimeout(() => {
              window.location.href = '/manage/products';
            }, 600);
          }
        } catch (e) {
          console.error('Error saving product:', e);
          const msg = e?.response?.message || e?.message || 'Не удалось сохранить товар';
          this.emitToast(msg, 'error');
        } finally {
          this.saving = false;
        }
      },

      async deleteProduct() {
        if (!this.productId) return;
        if (!confirm(`Вы действительно хотите удалить товар "${this.form.name}"?`)) {
          return;
        }

        this.saving = true;
        try {
          if (!this.pb) this.initPb(pbUrl);
          await this.pb.collection('products').delete(this.productId);
          this.emitToast('Товар удален', 'success');
          setTimeout(() => {
            window.location.href = '/manage/products';
          }, 500);
        } catch (e) {
          console.error('Error deleting product:', e);
          this.emitToast('Ошибка при удалении товара', 'error');
          this.saving = false;
        }
      },

      emitToast(message, type = 'success') {
        window.dispatchEvent(new CustomEvent('admin-toast', {
          detail: { message, type }
        }));
      }
    };
  };
</script>
