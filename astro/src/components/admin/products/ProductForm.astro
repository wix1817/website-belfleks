            >
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2 flex-grow">
                  <!-- Drag handle -->
                  <div class="cursor-grab text-gray-400 hover:text-gray-600 flex-shrink-0" title="Перетащите для изменения порядка">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M7 4a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0zM7 16a2 2 0 11-4 0 2 2 0 014 0zM17 4a2 2 0 11-4 0 2 2 0 014 0zM17 10a2 2 0 11-4 0 2 2 0 014 0zM17 16a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                  </div>
                  <span class="text-xs font-bold text-primary">Вопрос #<span x-text="fIdx + 1"></span>:</span>
                  <input
                    type="text"
                    x-model="item.question"
                    placeholder="например: Какая гарантия предоставляется на данный рукав?"
                    class="w-full bg-white border border-[#EDF2F7] focus:border-primary focus:ring-1 focus:ring-primary rounded-[6px] py-1.5 px-3 text-xs sm:text-sm font-semibold text-gray-900 placeholder-gray-400"
                  />
                </div>
                <!-- Delete Button -->
                <button
                  type="button"
                  @click="removeFaq(fIdx)"
                  class="p-1.5 text-gray-400 hover:text-[#EF1C24] hover:bg-red-50 rounded-[6px] transition-colors cursor-pointer flex-shrink-0"
                  title="Удалить вопрос"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>

              <!-- Answer textarea -->
              <div class="pl-6">
                <textarea
                  rows="2"
                  x-model="item.answer"
                  @input="autoResize($el)"
                  placeholder="Ответ: Гарантийный срок составляет 12 месяцев со дня ввода в эксплуатацию при соблюдении правил монтажа..."
                  class="w-full bg-white border border-[#EDF2F7] focus:border-primary focus:ring-1 focus:ring-primary rounded-[6px] p-2.5 text-xs sm:text-sm text-gray-800 min-h-[58px] resize-y placeholder-gray-400 leading-relaxed"
                ></textarea>
              </div>
            </div>
          </template>
        </div>

        <div x-show="faqList.length === 0" class="p-8 text-center text-gray-400 text-xs">
          Вопросы еще не добавлены.
        </div>
      </div>

      <div class="mt-3.5">
        <button
          type="button"
          @click="addFaq()"
          class="inline-flex items-center gap-1.5 py-2 px-4 rounded-[6px] border border-dashed border-gray-300 hover:border-primary bg-white hover:bg-red-50/20 text-gray-700 hover:text-primary text-xs font-semibold font-sans transition-all cursor-pointer shadow-2xs"
        >
          <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Добавить вопрос
        </button>
      </div>
    </div>

    <!-- SECTION 7: ОПИСАНИЕ -->
    <div class="bg-white rounded-[8px] p-6 border border-border shadow-xs">
      <h2 class="text-base font-bold text-gray-900 font-sans mb-4 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
        Описание товара
      </h2>

      <div class="space-y-5">
        <!-- Краткое описание -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="short-desc" class="block text-sm font-medium text-[#3B3B3B]">
              Краткое описание (для карточек и сниппетов)
            </label>
            <span
              class="text-xs font-mono"
              :class="form.short_description.length > 160 ? 'text-[#EF1C24] font-bold' : 'text-gray-400'"
