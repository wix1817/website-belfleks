            ></span>
          </div>
          <textarea
            id="short-desc"
            rows="2"
            maxlength="160"
            x-model="form.short_description"
            placeholder="Краткое описание назначения и ключевых свойств рукава..."
            class="w-full bg-[#F7FAFC] border border-[#EDF2F7] focus:border-primary focus:bg-white focus:ring-2 focus:ring-[#EF1C24]/20 rounded-[8px] py-2 px-3 text-sm text-gray-900 transition-all resize-y"
            :class="{ 'border-[#EF1C24] bg-red-50/20': errors.short_description }"
          ></textarea>
          <template x-if="errors.short_description">
            <p class="text-[#EF1C24] text-[12px] mt-1 font-medium" x-text="errors.short_description"></p>
          </template>
        </div>

        <!-- Полное описание с легким Rich Text редактором -->
        <div>
          <label class="block text-sm font-medium text-[#3B3B3B] mb-1.5">
            Полное описание и спецификация
          </label>

          <div class="border border-[#EDF2F7] rounded-[8px] overflow-hidden focus-within:border-primary focus-within:ring-2 focus-within:ring-[#EF1C24]/20 transition-all">
            <!-- Toolbar -->
            <div class="bg-gray-50 border-b border-[#EDF2F7] p-2 flex flex-wrap items-center gap-1">
              <button
                type="button"
                @click="execFormat('bold')"
                class="p-1.5 rounded hover:bg-white hover:shadow-2xs text-gray-700 font-bold text-xs min-w-[28px] h-7 flex items-center justify-center cursor-pointer transition-colors"
                title="Жирный (Ctrl+B)"
              >
                B
              </button>
              <button
                type="button"
                @click="execFormat('italic')"
                class="p-1.5 rounded hover:bg-white hover:shadow-2xs text-gray-700 italic text-xs min-w-[28px] h-7 flex items-center justify-center cursor-pointer transition-colors"
                title="Курсив (Ctrl+I)"
              >
                I
              </button>
              <span class="w-px h-4 bg-gray-300 mx-1"></span>
              <button
                type="button"
                @click="execFormat('formatBlock', '<h2>')"
                class="p-1.5 rounded hover:bg-white hover:shadow-2xs text-gray-700 font-bold text-xs px-2 h-7 flex items-center justify-center cursor-pointer transition-colors"
                title="Заголовок H2"
              >
                H2
              </button>
              <button
                type="button"
                @click="execFormat('formatBlock', '<h3>')"
                class="p-1.5 rounded hover:bg-white hover:shadow-2xs text-gray-700 font-bold text-xs px-2 h-7 flex items-center justify-center cursor-pointer transition-colors"
                title="Подзаголовок H3"
              >
                H3
              </button>
              <span class="w-px h-4 bg-gray-300 mx-1"></span>
              <button
                type="button"
                @click="execFormat('insertUnorderedList')"
                class="p-1.5 rounded hover:bg-white hover:shadow-2xs text-gray-700 text-xs px-2 h-7 flex items-center justify-center cursor-pointer transition-colors"
                title="Маркированный список"
              >
                • Список
              </button>
              <button
                type="button"
                @click="insertLink()"
                class="p-1.5 rounded hover:bg-white hover:shadow-2xs text-gray-700 text-xs px-2 h-7 flex items-center justify-center cursor-pointer transition-colors"
                title="Вставить ссылку"
              >
                🔗 Ссылка
              </button>
              <button
                type="button"
                @click="execFormat('removeFormat')"
                class="p-1.5 rounded hover:bg-white hover:shadow-2xs text-gray-500 text-xs px-2 h-7 flex items-center justify-center cursor-pointer transition-colors ml-auto"
                title="Очистить форматирование"
              >
                Очистить
              </button>
            </div>

            <!-- Contenteditable Editor Zone -->
            <div
              x-ref="editor"
              contenteditable="true"
              @input="form.description = $el.innerHTML"
              @blur="form.description = $el.innerHTML"
              class="p-4 bg-white min-h-[220px] text-sm text-gray-900 focus:outline-none prose prose-sm max-w-none"
              placeholder="Введите подробное описание товара..."
            ></div>
          </div>
        </div>
      </div>
    </div>

    <!-- SECTION 8: ПОИСКОВАЯ ОПТИМИЗАЦИЯ (SEO & LIVE SERP PREVIEW) -->
    <div class="bg-white rounded-[8px] p-6 border border-border shadow-xs">
      <h2 class="text-base font-bold text-gray-900 font-sans mb-1 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-orange-500"></span>
        Поисковая оптимизация (SEO)
      </h2>
      <p class="text-xs text-text-secondary mb-5">
        Настройка мета-тегов для поисковых систем (Яндекс, Google).
      </p>

      <div class="space-y-5">
        <!-- Meta Title -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="meta-title" class="block text-sm font-medium text-[#3B3B3B]">
              Meta Title (Заголовок страницы)
            </label>
            <span
              class="text-xs font-mono"
              :class="form.meta_title.length > 60 ? 'text-orange-600 font-semibold' : 'text-gray-400'"
              x-text="form.meta_title.length + '/60'"
            ></span>
          </div>
          <input
            id="meta-title"
            type="text"
            x-model="form.meta_title"
            placeholder="например: Рукав пищевой Dionysus EF 10 BAR — купить в Беларуси | БелФлекс"
            class="w-full bg-[#F7FAFC] border border-[#EDF2F7] focus:border-primary focus:bg-white focus:ring-2 focus:ring-[#EF1C24]/20 rounded-[8px] py-2.5 px-3.5 text-sm text-gray-900 transition-all"
          />
          <p class="text-[11px] text-text-secondary mt-1">
            Если поле не заполнено, будет автоматически сгенерирован заголовок из названия товара.
          </p>
        </div>

        <!-- Meta Description -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="meta-desc" class="block text-sm font-medium text-[#3B3B3B]">
              Meta Description (Краткое описание для поисковиков)
            </label>
            <span
              class="text-xs font-mono"
              :class="form.meta_description.length > 160 ? 'text-orange-600 font-semibold' : 'text-gray-400'"
              x-text="form.meta_description.length + '/160'"
            ></span>
          </div>
          <textarea
            id="meta-desc"
            rows="3"
            x-model="form.meta_description"
            placeholder="например: Промышленный напорно-всасывающий рукав для пищевых продуктов. Рабочее давление 10 бар. Доставка по Беларуси со склада в Гродно..."
            class="w-full bg-[#F7FAFC] border border-[#EDF2F7] focus:border-primary focus:bg-white focus:ring-2 focus:ring-[#EF1C24]/20 rounded-[8px] py-2 px-3 text-sm text-gray-900 transition-all resize-y"
          ></textarea>
        </div>

        <!-- Live Google SERP Snippet Preview -->
        <div class="p-4 bg-[#F8F9FA] rounded-[8px] border border-[#DADCE0] mt-4">
          <div class="text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2.5 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-blue-600" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
            </svg>
            Предпросмотр в поисковой выдаче Google (SERP)
          </div>

          <div class="bg-white p-4 rounded-[6px] border border-gray-200 shadow-2xs font-sans max-w-2xl">
            <!-- Google Breadcrumb / URL line -->
            <div class="flex items-center gap-2 text-xs mb-1">
              <div class="w-4 h-4 rounded-full bg-[#EF1C24] text-white text-[9px] font-bold flex items-center justify-center flex-shrink-0">
                Б
              </div>
              <div class="truncate text-[#202124] text-xs">
                <span class="font-medium">ООО «БелФлекс»</span>
                <span class="text-[#5f6368] text-[11px]"> › katalog › <span x-text="form.slug || 'slug-tovara'"></span></span>
              </div>
            </div>

            <!-- Google Title Line -->
            <h4 class="text-base sm:text-lg text-[#1a0dab] hover:underline cursor-pointer font-medium leading-snug truncate">
              <span x-text="form.meta_title ? form.meta_title : (form.name ? form.name + ' — ООО «БелФлекс»' : 'Название товара — ООО «БелФлекс»')"></span>
            </h4>

            <!-- Google Snippet Description Line -->
            <p class="text-xs sm:text-sm text-[#4d5156] leading-relaxed mt-1 line-clamp-2">
              <span x-text="form.meta_description ? form.meta_description : (form.short_description ? form.short_description : 'Официальные поставки промышленных рукавов и соединений со склада в Гродно. Сертификаты соответствия, доставка по всей Беларуси...')"></span>
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- SECTION 9: НАСТРОЙКИ ПУБЛИКАЦИИ -->
    <div class="bg-white rounded-[8px] p-6 border border-border shadow-xs">
      <h2 class="text-base font-bold text-gray-900 font-sans mb-4 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-green-500"></span>
        Настройки публикации
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Toggle: Активен -->
        <div class="flex items-center justify-between p-3.5 bg-[#F7FAFC] rounded-[8px] border border-border">
          <div>
            <label class="block text-sm font-semibold text-gray-900 cursor-pointer" @click="form.is_active = !form.is_active">
              Активен
            </label>
            <span class="text-xs text-text-secondary">Отображать в каталоге</span>
          </div>
          <button
            type="button"
            @click="form.is_active = !form.is_active"
            :class="form.is_active ? 'bg-green-500' : 'bg-gray-300'"
            class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none"
            role="switch"
            :aria-checked="form.is_active"
          >
            <span
              :class="form.is_active ? 'translate-x-5' : 'translate-x-0'"
              class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"
            ></span>
          </button>
        </div>

