---
// Reusable Toast Component for Admin Panel
---

<div
  x-data="{
    toasts: [],
    add(message, type = 'success', duration = 3000) {
      const id = Date.now() + Math.random();
      this.toasts.push({ id, message, type });
      if (duration > 0) {
        setTimeout(() => {
          this.remove(id);
        }, duration);
      }
    },
    remove(id) {
      this.toasts = this.toasts.filter(t => t.id !== id);
    }
  }"
  @admin-toast.window="add($event.detail.message, $event.detail.type || 'success', $event.detail.duration || 3000)"
  class="fixed top-6 right-6 z-50 flex flex-col gap-2.5 max-w-sm w-full pointer-events-none"
  aria-live="polite"
>
  <template x-for="t in toasts" :key="t.id">
    <div
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0 translate-y-[-10px] scale-95"
      x-transition:enter-end="opacity-100 translate-y-0 scale-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100 translate-y-0 scale-100"
      x-transition:leave-end="opacity-0 translate-y-[-10px] scale-95"
      class="pointer-events-auto rounded-[8px] p-4 shadow-lg border text-sm font-medium flex items-start gap-3 transition-all"
      :class="{
        'bg-white text-gray-900 border-green-200 border-l-4 border-l-green-500 shadow-green-500/5': t.type === 'success',
        'bg-white text-gray-900 border-red-200 border-l-4 border-l-[#EF1C24] shadow-red-500/5': t.type === 'error',
        'bg-white text-gray-900 border-blue-200 border-l-4 border-l-blue-500 shadow-blue-500/5': t.type === 'info'
      }"
    >
      <!-- Success Icon -->
      <template x-if="t.type === 'success'">
        <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </template>

      <!-- Error Icon -->
      <template x-if="t.type === 'error'">
        <svg class="w-5 h-5 text-[#EF1C24] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </template>

      <!-- Info Icon -->
      <template x-if="t.type === 'info'">
        <svg class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </template>

      <!-- Message Content -->
      <div class="flex-1 text-xs sm:text-sm leading-snug">
        <span x-text="t.message"></span>
      </div>

      <!-- Close Button -->
      <button
        type="button"
        @click="remove(t.id)"
        class="text-gray-400 hover:text-gray-600 p-0.5 rounded transition-colors cursor-pointer"
        aria-label="Закрыть уведомление"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </template>
</div>
